use std.cinterop.*
use std.ptr.*

extern "c" {
    printf: (RawPtr<CChar>, ...) -> I32
}

printf (c_string "hello, world!\n")
printf (CString.from_string_unchecked "owned Staple String\n")
let round_trip = CString.to_string_unchecked (c_string "CString round trip\n")
printf (CString.from_string_unchecked round_trip)
