// Generic aliases/functions, traits, implementations, bounds, and static dispatch.
use std.io.println

type alias Pair (A, B) = (A, B)

trait Label T {
    label: T -> String
}

impl Label I32 {
    def label = _ => "integer"
}

impl Label Bool {
    def label = value => match value {
        True => "true",
        False => "false",
    }
}

def identity: <T> move T -> T = move value => value
def first: <A, B> move Pair (A, B) -> A = move (left, _) => left
def labeled: <T where Label T> T -> String = value => Label.label value

// Generic functions become first-class values when context fixes their type.
let int_identity: I32 -> I32 = identity
let pair: Pair (I32, String) = (42, "answer")
let flag: Bool = True

println (labeled (int_identity (first pair)))
println (labeled flag)
