// Generic aliases/functions, traits, implementations, bounds, and static dispatch.
use std.io.println

type Pair (A, B) = alias (A, B)

trait Label T {label: T -> String}

impl Label I32 {label = _ => "integer"}

impl Label Bool {label = value => match value {True => "true", False => "false",}}

def identity = <T> move value: T => T :: value
def first = <A, B> move (left: A, _: B) => A :: left
def labeled = <T where Label T> value: T => String :: Label.label value

// Generic functions become first-class values when context fixes their type.
let int_identity: I32 -> I32 = identity
let pair: Pair (I32, String) = (42, "answer")
let flag: Bool = True

println (labeled (int_identity (first pair)))
println (labeled flag)
