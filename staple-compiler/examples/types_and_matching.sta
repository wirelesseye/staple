// Aliases, distinct and generic types, singletons, sums, and exhaustive match.
use std.io.println

pub type alias Number = I32
pub(repr) type UserId = Number
pub(repr) type Box T = (value: T)

typegroup Switch {
    Enabled,
    Disabled
}
use Switch.*

def unbox: <T> Box T -> T = Box value => value

def switch_number = switch: Switch => match switch {
    Switch.Enabled => 1,
    Switch.Disabled => 0,
}

// A wildcard arm can make a product match exhaustive.
def same_switch = (left: Switch, right: Switch) => match (left, right) {
    (Enabled(), Enabled()) => True,
    (Disabled(), Disabled()) => True,
    _ => False,
}

let UserId raw_id = UserId 42
let boxed: Box I32 = Box (value: raw_id)

let generic_value = unbox boxed
let singleton_value = switch_number Enabled

println "Nominal patterns, generic constructors, and singleton matches evaluated successfully."
when {
    (same_switch (Enabled, Disabled)) => {
        println "same"
    },
    else => {
        println "different"
    },
}
