// Open sums, nominal payloads, propagating bindings, returns, and catch-all arms.
use std.io.println

pub type Found T = pub ctor T
pub type Missing = pub ctor String
pub type Invalid = pub ctor String

def lookup: Bool -> Found I32 | Missing | Invalid = available => match available {
    True => Found(42),
    False => Missing("not found"),
}

// `?` unwraps Found and immediately returns either residual alternative.
def doubled = available: Bool => {
    let Found(value)? = lookup available
    Found(value + value)
}

def describe = result: Found I32 | Missing | Invalid => match result {
    Found _ => println "found",
    Missing message => println message,
    _ => println "invalid",
}

def explicit_return = value: I32 => {
    return value + 1
    0
}

let returned = explicit_return 41

describe (doubled True)
describe (doubled False)
println "Explicit return evaluated successfully."
