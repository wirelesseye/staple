use std.io.println
use std.list.List

def show_list = (label: String; move items: List I32) => {
    let mut text = ""
    for item in items {
        text = "${text} ${item}"
    }
    println "${label}:${text}"
}

def show_option = (label: String; value: Option I32) => match value {
    Some found => println "${label}: ${found}",
    None => println "${label}: none",
}

def show_flag = (label: String; value: Bool) => if value {
    println "${label}: yes"
} else {
    println "${label}: no"
}

def run = () => {
    // Adapters
    show_list "map" ((1 .. 4) |> map (x => x * 10) |> collect)
    show_list "filter" ((1 .. 7) |> filter (x => x > 3) |> collect)
    show_list "filter_map" ((1 .. 7) |> filter_map (x => if (x / 2 * 2 == x) { Some (x * x) } else { None }) |> collect)
    show_list "take" ((0 .. 100) |> take 3 |> collect)
    show_list "take past end" ((0 .. 2) |> take 5 |> collect)
    show_list "skip" ((0 .. 6) |> skip 4 |> collect)
    show_list "skip past end" ((0 .. 2) |> skip 5 |> collect)
    show_list "take_while" ((1 .. 10) |> take_while (x => x < 4) |> collect)
    show_list "enumerate" ((5 .. 8) |> enumerate |> map ((index, x) => if (index == 1) { x * 100 } else { x }) |> collect)
    show_list "zip" ((1 .. 4) |> zip (10 .. 100) |> map ((a, b) => a + b) |> collect)
    show_list "chain" ((1 .. 3) |> chain (7 .. 9) |> collect)
    show_list "chain mapped" ((1 .. 3) |> map (x => x * 2) |> chain ((5 .. 6) |> map (x => x - 1)) |> collect)

    // Consumers
    println "fold: ${(1 .. 5) |> fold 0 ((total, x) => total + x)}"
    show_option "reduce" ((1 .. 5) |> reduce ((a, b) => a * b))
    show_option "reduce empty" ((3 .. 3) |> reduce ((a, b) => a + b))
    println "count: ${(0 .. 10) |> filter (x => x > 6) |> count}"
    show_flag "any" ((1 .. 5) |> any (x => x == 3))
    show_flag "all" ((1 .. 5) |> all (x => x < 3))
    show_option "find" ((1 .. 10) |> find (x => x * x > 20))
    show_option "find none" ((1 .. 3) |> find (x => x > 5))
    show_option "last" ((1 .. 4) |> last)
    println "sum: ${(1 .. 5) |> sum}"
    show_option "min" ((4 .. 9) |> map (x => 10 - x) |> min)
    show_option "max" ((4 .. 9) |> map (x => 10 - x) |> max)
    show_option "min empty" ((3 .. 3) |> min)

    // Consumers accept effects; `for_each` runs them in order.
    (1 .. 4) |> for_each (x => println "for_each: ${x}")

    // Adapters work in `for`, and over lists through `into_iterator`.
    for (index, x) in ((10 .. 13) |> enumerate) {
        println "for: ${index} ${x}"
    }
    let mut numbers: List I32 = List.new ()
    List.push numbers 3
    List.push numbers 1
    List.push numbers 2
    println "list sum: ${numbers |> into_iterator |> map (x => x * 2) |> sum}"

    // Non-`Copy` items: `filter` borrows them, `map` and `collect` own them.
    let lists = (0 .. 4)
        |> map (n => (1 .. n + 1) |> collect)
        |> filter (items => List.length items > 1)
        |> map (move items => items |> into_iterator |> sum)
        |> collect
    show_list "nested" lists
}

run ()
