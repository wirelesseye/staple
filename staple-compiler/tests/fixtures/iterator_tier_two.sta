use std.cmp.Ordering
use std.io.println
use std.list.List

type Failure wrap String

def show_list = (label: String; move items: List<I32>) => {
    let mut text = ""
    for item in items {
        text = "${text} ${item}"
    }
    println "${label}:${text}"
}

def show_option = (label: String; value: Option<I32>) => match value {
    Some found => println "${label}: ${found}",
    None => println "${label}: none",
}

def show_index = (label: String; value: Option<USize>) => match value {
    Some found => println "${label}: ${found}",
    None => println "${label}: none",
}

def show_result = (label: String; value: Result<I32, Failure>) => match value {
    Ok found => println "${label}: ok ${found}",
    Failure message => println "${label}: err ${message}",
}

def compare_i32 = (left: I32, right: I32) => Ordering :: if (left < right) {
    Ordering :: Ordering.Less
} else if (left > right) {
    Ordering :: Ordering.Greater
} else {
    Ordering :: Ordering.Equal
}

def scan_add = (move sum: I32, move x: I32) => (I32, Option<I32>) ::
    (sum + x, Some (sum + x))

def scan_stop = (move sum: I32, move x: I32) => (I32, Option<I32>) ::
    (sum + x, if (x < 4) { Some (sum + x) } else { None })

def try_add = (move total: I32, move x: I32) => Result<I32, Failure> :: Ok (total + x)

def try_stop = (move total: I32, move x: I32) => Result<I32, Failure> ::
    if (x == 5) { Failure "reached five" } else { Ok (total + x) }

def run = () => {
    // Adapters
    show_list "flat_map" ((1 .. 4) |> flat_map (x => (0 .. x)) |> to_list)
    show_list "scan" ((1 .. 5) |> scan 0 scan_add |> to_list)
    show_list "scan stop" ((1 .. 8) |> scan 0 scan_stop |> to_list)
    show_list "skip_while" ((1 .. 7) |> skip_while (x => x < 4) |> to_list)
    show_list "step_by" ((0 .. 10) |> step_by 3 |> to_list)
    let peekable = (1 .. 4) |> peekable
    let (head, peekable) = peekable |> peek
    show_option "peek" head
    show_list "peek rest" (peekable |> to_list)

    // Consumers
    show_index "position" ((10 .. 20) |> position (x => x == 13))
    show_index "position none" ((10 .. 20) |> position (x => x == 99))
    show_option "nth" ((1 .. 10) |> nth 2)
    show_option "nth past end" ((1 .. 3) |> nth 5)
    show_option "min_by" ((4 .. 9) |> map (x => 10 - x) |> min_by compare_i32)
    show_option "max_by" ((4 .. 9) |> map (x => 10 - x) |> max_by compare_i32)
    let try_sum: Result<I32, Failure> =
        (1 .. 5) |> try_fold 0 try_add
    show_result "try_fold ok" try_sum
    let try_stop: Result<I32, Failure> =
        (1 .. 7) |> try_fold 0 try_stop
    show_result "try_fold err" try_stop

    // Sources
    show_list "empty" (empty.<I32> () |> to_list)
    show_list "once" (once 7 |> to_list)
    show_list "repeat_n" (repeat_n 5 3 |> to_list)
    show_list "repeat_n zero" (repeat_n 5 0 |> to_list)
    show_list "successors" (
        successors.<I32> (Some 1)
            ((x: I32) => if (x < 4) { Some (x + 1) } else { None })
            |> to_list
    )
    let no_first: Option<I32> = None
    show_list "successors empty" (
        successors.<I32> no_first ((x: I32) => None) |> to_list
    )
}

run ()
