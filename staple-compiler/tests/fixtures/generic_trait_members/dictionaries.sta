use std.io.(IO, println)
use std.fmt.Display
trait Visit T { visit: <A> (T, move A) -> A }
impl Visit I32 { visit = <A> (_, move value) => value }
type Box T = wrap T
impl<T> Visit (Box T) { visit = <A> (_, move value) => value }
def relay = <T, A where Visit T> (item: T, move value: A) => A :: Visit.visit (item, value)
let stored = relay
println "${stored (1, 42)}"
println "${stored (Box 2, "builder")}"
trait Fallback T { fallback: <A> (T, move A) -> A = <A> (_, move value) => value }
impl Fallback I32 {}
impl<T> Fallback (Box T) {}
def fallback = <T, A where Fallback T> (item: T, move value: A) => A :: Fallback.fallback (item, value)
let stored_fallback = fallback
println "${stored_fallback (1, "default")}"
println "${stored_fallback (Box 2, 9)}"
trait Show T { show: <A where Display A> (T, A) -> String }
impl Show I32 { show = <A where Display A> (_, value) => ToString.to_string value }
impl<X> Show (Box X) { show = <A where Display A> (_, value) => ToString.to_string value }
def show = <T, A where Show T, Display A> pair: (T, A) => String :: Show.show pair
let stored_show = show
println (stored_show (1, 7))
println (stored_show (Box 1, "bound"))
def capture = <T where Visit T, Copy T> item: T => (() -> I32) :: () => Visit.visit (item, 12)
let stored_capture = capture
let escaped = stored_capture (Box 1)
println "${escaped ()}"
trait Action T { act: <effect E> (T, () ->{E} I32) ->{E} I32 }
impl Action I32 { act = <effect E> (_, f) => f () }
def act = <T, effect E where Action T> pair: (T, () ->{E} I32) =>{E} I32 :: Action.act pair
let stored_act = act
def quiet: () -> I32 = () => 3
def noisy: () ->{IO} I32 = () => { println "effect"; 4 }
println "${stored_act (1, quiet)}"
println "${stored_act (1, noisy)}"
trait Convert X Y { convert: (X, Y) -> Bool }
impl Convert I32 String { convert = _ => True }
impl<X> Convert (Box X) String { convert = _ => False }
trait Compare T { compare: <A where Convert T A> (T, A) -> Bool }
impl Compare I32 { compare = <A where Convert I32 A> pair => Convert.convert pair }
impl<X> Compare (Box X) { compare = <A where Convert (Box X) A> pair => Convert.convert pair }
def compare = <T, A where Compare T, Convert T A> pair: (T, A) => Bool :: Compare.compare pair
let stored_compare = compare
println "${stored_compare (1, "yes")}"
println "${stored_compare (Box 1, "no")}"
def identity = <A> move value: A => A :: value
trait Apply T { apply: T -> (<A> move A -> A) -> I32 }
impl Apply I32 { apply = _ => f => f 5 }
def apply = <T where Apply T> item: T => I32 :: Apply.apply item identity
let stored_apply = apply
println "${stored_apply 1}"
trait Make T { make: <A> move A -> T }
impl Make I32 { make = <A> move value => 6 }
def make = <T, A where Make T> move value: A => T :: Make.make value
let stored_make = make
println "${stored_make.<I32, (I32, I32)> (1, 2)}"

// Implementation bounds precede caller-supplied member bounds in slot entries.
trait Inspect T { inspect: <A where ToString A> (T, A) -> String }
impl<X where ToString X> Inspect (Box X) { inspect = <A where ToString A> (_, value) => ToString.to_string value }
def inspect = <X, A where ToString X, ToString A> pair: (Box X, A) => String :: Inspect.inspect pair
let stored_inspect = inspect
println (stored_inspect (Box 1, 21))

// A member bound on its trait parameter still comes from the member's caller.
trait Label T { label: T -> String }
impl Label I32 { label = value => ToString.to_string value }
impl<X where Label X> Label (Box X) { label = Box value => Label.label value }
trait Echo T { echo: <A where Label T> (T, move A) -> String = <A where Label T> (item, move unused) => Label.label item }
impl Echo I32 {}
impl<X> Echo (Box X) {}
def echo = <T, A where Echo T, Label T> (item: T, move value: A) => String :: Echo.echo (item, value)
let stored_echo = echo
println (stored_echo (22, True))
println (stored_echo (Box 23, False))
let echo_member = Echo.echo
println (echo_member.<I32, String> (24, "member"))

// Effect-only member schemes pass dictionaries without an own type descriptor.
trait EffectEcho T {
    effect_echo: <effect E where Label T> (T, () ->{E} I32) ->{E} String = <effect E where Label T> (item, f) => {
        let ignored = f ()
        Label.label item
    }
}
impl EffectEcho I32 {}
impl<X where Label X> EffectEcho (Box X) {}
def effect_echo = <T, effect E where EffectEcho T, Label T> pair: (T, () ->{E} I32) =>{E} String :: EffectEcho.effect_echo pair
let stored_effect_echo = effect_echo
println (stored_effect_echo (25, quiet))
println (stored_effect_echo (Box 26, noisy))

// Every member shape remains callable inside an escaping dictionary closure.
impl<X> Apply (Box X) { apply = _ => f => f 5 }
impl<X> Action (Box X) { act = <effect E> (_, f) => f () }
def consume_text: (<U where ToString U> U -> String) -> String = f => f 31
def nested = <T where Visit T, Fallback T, Show T, Compare T, Convert T String, Apply T, Action T, Echo T, EffectEcho T, Label T, Copy T> item: T => (() ->{IO} ()) :: () => {
    println "${Visit.visit.<_, _> (item, 27)}"
    println "${Fallback.fallback (item, 28)}"
    println (Show.show (item, 29))
    println "${Compare.compare (item, "nested")}"
    println "${Apply.apply item identity}"
    println "${Action.act (item, noisy)}"
    let member = Visit.visit
    println "${member (item, 30)}"
    println (Echo.echo (item, False))
    println (EffectEcho.effect_echo (item, noisy))
    let text = ToString.to_string
    println (consume_text text)
    let equals: <U where Ord U> (U, U) -> Bool = Eq.eq
    println "${equals (1, 1)}"
}
let stored_nested = nested
let int_closure = stored_nested 1
int_closure ()
let box_closure = stored_nested (Box 1)
box_closure ()

trait Pair (Left, Right) {
    carry: <A> (Left, Right, move A) -> A = <A> (_, _, move value) => value
}
impl Pair (I32, String) {}
def pair_relay = <L, R, A where Pair (L, R)> (left: L, right: R, move value: A) => A :: Pair.carry.<(L, R), A> (left, right, value)
let pair_relay_value = pair_relay
println "${pair_relay_value (1, "pair", 40)}"
let pair_member = Pair.carry
println "${pair_member.<(I32, String), Bool> (1, "pair", Bool :: True)}"

trait AssociatedPair (Left, Right) {
    type Output
    carry: <A> (Left, Right, move A) -> (Output, A)
}
impl AssociatedPair (I32, String) {
    type Output = Bool
    carry = <A> (_, _, move value) => (Bool :: True, value)
}
def associated_relay = <A> move value: A => (Bool, A) ::
    AssociatedPair.carry.<(I32, String), A> (1, "pair", value)
let associated_relay_value = associated_relay
let (associated_flag, associated_value) = associated_relay_value 41
println "${associated_flag}"
println "${associated_value}"

trait Curried T { pass: <A> T -> ((move A) -> A) }
impl Curried I32 { pass = <A> _ => move value => value }
def curried_relay = <T, A where Curried T> (item: T, move value: A) => A :: Curried.pass.<T, A> item value
let curried_relay_value = curried_relay
println "${curried_relay_value (1, 42)}"
