use std.io.println
trait Visit T {
    visit: <A> (T, move A) -> A
}
impl Visit I32 { visit = <A> (_, move value) => value }
type Box<T> wrap T
impl<T> Visit Box<T> { visit = <A> (_, move value) => value }
trait DefaultVisit T {
    visit_default: <A> (T, move A) -> A = <A> (_, move value) => value
}
impl DefaultVisit I32 {}
impl DefaultVisit Bool { visit_default = <A> (_, move value) => value }
def relay = <T, A where Visit T> (item: T, move value: A) => A :: Visit.visit (item, value)
println "${Visit.visit (1, 42)}"
println "${Visit.visit.<_, String> (Box (Bool :: True), "generic")}"
println "${relay (1, Bool :: True)}"
println "${DefaultVisit.visit_default (1, "default")}"
println "${DefaultVisit.visit_default (Bool :: True, 7)}"
