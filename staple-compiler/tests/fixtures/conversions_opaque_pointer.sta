use std.cinterop.(CChar, c_string)
use std.ptr.(RawPtr, RawOpaquePtr)

def require: Bool -> () = condition => if condition { () } else { panic "opaque pointer assertion failed" }
def identity: RawOpaquePtr -> RawOpaquePtr = value => value
extern "c" {
    strchr: (RawPtr<CChar>, I32) -> RawOpaquePtr
    strlen: RawOpaquePtr -> USize
}

let pointer = (USize :: 4096) as RawPtr<I32>
let opaque = pointer as RawOpaquePtr
let restored: RawPtr<I32> = opaque as _
require ((restored as USize) == 4096)
require ((opaque as USize) == 4096)
require (((opaque as RawPtr<U8>) as USize) == 4096)
require (((identity opaque) as USize) == 4096)
let checked: Ok<RawOpaquePtr> | Never = TryConvert.try_convert pointer
match checked { Ok value => require ((value as USize) == 4096), }
let checked_pointer: Ok<RawPtr<CChar>> | Never = TryConvert.try_convert opaque
match checked_pointer { Ok value => require ((value as USize) == 4096), }
let checked_address: Ok<USize> | Never = TryConvert.try_convert opaque
match checked_address { Ok value => require (value == 4096), }
let checked_opaque: Ok<RawOpaquePtr> | Never = TryConvert.try_convert (USize :: 4096)
match checked_opaque { Ok value => require ((value as USize) == 4096), }
let null = (USize :: 0) as RawOpaquePtr
require ((((null as RawPtr<I32>) as RawOpaquePtr) as USize) == 0)
let text = c_string "abc"
let found = strchr (text, 98)
require ((found as USize) != 0)
require (strlen found == 2)
let missing = strchr (text, 120)
require ((missing as USize) == 0)
