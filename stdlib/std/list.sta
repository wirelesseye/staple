pub mod

use package.iterator.(IntoIterator, Iterator, FromIterator)
use package.iterator.IterStep.(Done, Yield)
use package.alloc.Gc
use package.buffer.(Buffer, BufferHeader, unsafe_buffer_into_raw)
use package.ptr.(RawMutPtr, RawOpaqueMutPtr)
use package.clone.Clone
use package.default.Default
use package.index.(Index, MutateIndex)
use package.syntax.*

/// A growable sequence backed by a mutable buffer.
pub type List<T> wrap Buffer<T>

impl<T> Default (List<T>) {
    default = () => List.new ()
}

impl<T> FromIterator List<T> T {
    insert = (move list: List<T>; move item: T) => List<T> :: List.push_and_return list item
}

impl<T where Clone T> Clone (List<T>) {
    clone = List buffer => List (Clone.clone buffer)
}

// Doubles capacity (minimum 4 on first growth) and moves every element
// across in one Buffer.transfer call.
def grow = <T> mut list: List<T> => () :: {
    let old_capacity = Buffer.capacity list.*
    let new_capacity: USize = if (old_capacity == 0) { 4 } else { old_capacity * 2 }
    let mut destination: Buffer<T> = Buffer.with_capacity new_capacity
    Buffer.transfer list.* destination
    list = List destination
}

companion<T> List<T> {
    /// Returns the number of elements in the list.
    pub def length = list: List<T> => USize :: list.* |> length

    /// Returns the number of elements the list can hold without growing.
    pub def capacity = list: List<T> => USize :: list.* |> capacity

    /// Appends a value, growing the list when necessary.
    pub def push = (mut list: List<T>; move value: T) => () :: {
        if ((list.* |> length) < (list.* |> capacity)) {
            list.* |> push value
        } else {
            grow list
            list.* |> push value
        }
    }

    /// Removes and returns the final value, or `None` when empty.
    pub def pop = mut list: List<T> => Option<T> :: list.* |> pop

    /// Replaces the value at an index and returns the old value, or `None` when out of bounds.
    pub def set = (mut list: List<T>; index: USize; move value: T) => Option<T> ::
        Buffer.set list.* index value

    /// Replaces the value at an index and returns the old value, trapping when out of bounds.
    pub def set_unchecked = (mut list: List<T>; index: USize; move value: T) => T ::
        Buffer.set_unchecked list.* index value
}

companion<T> List<T> {
    /// Consumes the list and returns its backing buffer.
    pub def into_buffer = move list: List<T> => Buffer<T> :: {
        let List buffer = list
        buffer
    }
}

companion<T> List<T> {
    /// Creates an empty list.
    pub def new = () => List<T> :: {
        let buffer: Buffer<T> = Buffer.with_capacity 0
        List buffer
    }
}

companion<T> List<T> {
    /// Creates an empty list with the requested capacity.
    pub def with_capacity = capacity: USize => List<T> :: {
        let buffer: Buffer<T> = Buffer.with_capacity capacity
        List buffer
    }
}

companion<T> List<T> {
    /// Creates a list containing one value.
    pub def singleton = move value: T => List<T> :: {
        let mut list: List<T> = List.with_capacity 1
        list |> push value
        list
    }

    // `List.of` uses this helper to build a list without ever naming
    // an intermediate. A synthesized name shared between a macro-generated
    // binder and macro-generated uses of it, built up across more than one
    // `parse_quote` call, isn't expressible yet — each `parse_quote` call
    // freshens the identifiers it introduces independently, and
    // `Pattern`/`Expr` values have no identity-preserving way to convert
    // between each other to route around that. Splicing an already-built
    // `Expr` *value* (never rewriting a name) has no such problem, so
    // `List.of` threads the list handle through nested calls to this
    // instead.
    /// Appends a value and returns the list handle.
    pub def push_and_return = (move list: List<T>; move value: T) => List<T> :: {
        let mut extended: List<T> = list
        extended |> push value
        extended
    }
}

// Builds `List.push_and_return (... (List.push_and_return base first) ...) last`,
// left-to-right, so elements are pushed in the order they were written.
// `accumulator` is a previously-built `Expr` value, spliced in — not a name
// — so this never runs into the binder/use hygiene mismatch described above.
def list_of_pushes = (accumulator: Expr, elements: Sequence<Expr>) => Expr :: match elements {
    Sequence () => accumulator,
    Sequence (first, rest) => {
        let pushed: Expr = parse_quote { List.push_and_return $accumulator $first }
        list_of_pushes (pushed, rest)
    },
}

// An explicit `-> Expr` result lets the trailing `parse_quote` infer its
// contextual type, the same way `when`'s `when_clauses` helper (in `flow.sta`)
// does — a `parse_quote` called directly from a macro's own match arm,
// with no result type in scope, cannot infer what to parse into.
//
// The base case seeds the chain with `List.singleton $first` rather than
// `List.new ()`, and only when there's a first element to do that with:
// nested generic calls only infer their type parameter from their own
// arguments or an annotation in the immediate context, not from an
// annotation several calls further out (`List.new ()` nested inside
// `List.push_and_return (List.push_and_return (List.new ()) 1) 2`
// cannot infer its element type this way, even though the whole
// expression's expected type is known). `List.singleton first`'s type
// parameter, by contrast, is pinned down immediately by `first`'s own
// type, so every `push_and_return` layered on top of it infers cleanly
// from the (now concrete) accumulator beneath it.
def list_of_expression = elements: Sequence<Expr> => Expr :: match elements {
    Sequence () => parse_quote { List.new () },
    Sequence (first, rest) => {
        let base: Expr = parse_quote { List.singleton $first }
        list_of_pushes (base, rest)
    },
}

companion<T> List<T> {
    /// Constructs a list from a comma-separated sequence of expressions.
    ///
    /// # Example
    ///
    /// ```staple
    /// let values: List<I32> = List.of (1, 2, 3)
    /// ```
    pub macro of =
        body: Parenthesized<Separated<Expr, Comma>> => match body {
            Parenthesized (Separated (_, elements, _)) => list_of_expression elements,
        }
}

// Copy-T-gated companion: `get`/`get_unchecked` read a value out by copy.
companion<T where Copy T> List<T> {
    /// Returns a copied value at an index, or `None` when out of bounds.
    pub def get = ((List buffer): List<T>; index: USize) => Option<T> ::
        Buffer.get buffer index

    /// Returns a copied value at an index, trapping when out of bounds.
    pub def get_unchecked = ((List buffer): List<T>; index: USize) => T ::
        Buffer.get_unchecked buffer index
}

impl<T where Copy T> Index List<T> USize {
    type Output = T
    index = (list, position) => List.get_unchecked list position
}

impl<T> MutateIndex List<T> USize {
    type Value = T
    mutate_index = (mut list, position, move value) => {
        let _ = List.set_unchecked list position value
        ()
    }
}

pub type ListIter<T> wrap pub (list: List<T>, index: USize)

// Copy-T-gated, like `get`/`Index` — yields owned copies.
impl<T where Copy T> Iterator ListIter<T> {
    type Item = T
    next = move ListIter (list, index) => if (index < List.length list) {
        // The bounds check just above already guarantees `index` is valid,
        // so `get_unchecked` avoids a second, redundant one.
        Yield (
            List.get_unchecked list index,
            ListIter (list: list, index: index + 1),
        )
    } else {
        Done (ListIter (list: list, index: index))
    }
}

/// A consuming iterator that moves elements out of a list's allocation. It
/// takes over the buffer's raw parts, so `Buffer`'s own drop never runs; the
/// iterator drops only the elements it has not yielded.
pub type ListIntoIter<T> wrap (header: RawMutPtr<BufferHeader<T>>, front: USize)
impl<T> !Copy ListIntoIter<T> {}

impl<T> Drop ListIntoIter<T> {
    cleanup = ListIntoIter (header, front) => {
        BufferHeader.unsafe_drop_elements header front
        Gc.unsafe_release (header as RawOpaqueMutPtr)
    }
}

impl<T> Iterator ListIntoIter<T> {
    type Item = T
    // The `move` destructure skips `Drop`, so each step hands the allocation
    // to its successor without freeing it.
    next = move ListIntoIter (header, front) => if (front < BufferHeader.length header) {
        let value = RawMutPtr.unsafe_read (BufferHeader.element header front)
        Yield (value, ListIntoIter (header: header, front: front + 1))
    } else {
        Done (ListIntoIter (header: header, front: front))
    }
}

impl<T> IntoIterator List<T> {
    type Iter = ListIntoIter<T>
    into_iterator = move list => {
        let List buffer = list
        ListIntoIter (header: unsafe_buffer_into_raw buffer, front: 0)
    }
}
