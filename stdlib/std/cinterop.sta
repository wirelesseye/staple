pub mod

/// A C string cannot contain an embedded NUL byte.
pub type InteriorNul

use std.string.InvalidUtf8
use std.slice.Slice

use std.core.sized.sized_opaque

use std.syntax.(Expr)

/// A C-compatible character.
@sized_opaque
pub type CChar = opaque
/// An opaque pointer to a C value of type `Pointee`.
@sized_opaque
pub type CPointer Pointee = opaque
/// An untyped, non-owning C pointer, compatible with C `void *`.
/// Conversions preserve the pointer without validating its target.
@sized_opaque
pub type COpaquePointer = opaque
/// A null-terminated C string.
@sized_opaque
pub type CString = opaque
impl !Copy CString {}

/// Converts a string literal to a null-terminated C string.
///
/// # Example
///
/// ```staple
/// c_string "hello\\n"
/// ```
pub macro c_string: Expr -> Expr

extern "staple-intrinsic" {
    __string_from_c_string_unchecked: move CString -> String
    __string_to_c_string_unchecked: String -> CString
}

companion CString {
    /// Validates UTF-8 and copies the bytes into a String.
    /// Consumes and frees the C string on both success and failure.
    pub def to_string: move CString -> Ok String | InvalidUtf8 =
        move value => TryConvert.try_convert value

    /// Copies a String into a C string, rejecting embedded NUL bytes.
    pub def from_string: String -> Ok CString | InteriorNul =
        value => TryConvert.try_convert value

    /// Copies bytes known to be valid UTF-8, consuming and freeing the C string.
    /// The caller must ensure the bytes are valid UTF-8.
    pub def to_string_unchecked: move CString -> String =
        move value => __string_from_c_string_unchecked value

    /// Copies and terminates a String without checking for embedded NUL bytes.
    /// The caller must ensure the String contains no embedded NUL bytes.
    pub def from_string_unchecked: String -> CString =
        value => __string_to_c_string_unchecked value
}

extern "staple-intrinsic" {
    __pointer_address: <T> CPointer T -> USize
    __address_pointer: <T> USize -> CPointer T
    __c_string_bytes: CString -> Slice U8
    __has_interior_nul: String -> U8
}

impl TryConvert String CString {
    type Error = InteriorNul
    try_convert = move value => {
        if (__has_interior_nul value == 1) {
            InteriorNul
        } else {
            Ok (CString.from_string_unchecked value)
        }
    }
}

impl TryConvert CString String {
    type Error = InvalidUtf8
    try_convert = move value => match (String.from_utf8 (__c_string_bytes value)) {
        Ok _ => Ok (CString.to_string_unchecked value),
        InvalidUtf8 => InvalidUtf8,
    }
}

impl<T> Convert (CPointer T) USize {
    convert = move value => __pointer_address value
}

impl<T> Convert USize (CPointer T) {
    convert = move value => __address_pointer value
}

extern "staple-intrinsic" {
    __pointer_opaque: <T> CPointer T -> COpaquePointer
    __opaque_pointer: <T> COpaquePointer -> CPointer T
    __opaque_address: COpaquePointer -> USize
    __address_opaque: USize -> COpaquePointer
}

impl<T> Convert (CPointer T) COpaquePointer {
    convert = move value => __pointer_opaque value
}

impl<T> Convert COpaquePointer (CPointer T) {
    convert = move value => __opaque_pointer value
}

impl Convert COpaquePointer USize {
    convert = move value => __opaque_address value
}

impl Convert USize COpaquePointer {
    convert = move value => __address_opaque value
}
