pub mod

use package.ops.(Add)
use package.cmp.(Eq)
use package.convert.(ConversionError, TryConvert)
use package.result.(Ok, Result)

/// The bytes are not valid UTF-8.
pub type InvalidUtf8

use package.convert.checked_conversion
use package.default.Default

use package.shared_buffer.(SharedBuffer)
use package.buffer.(Buffer)
use package.list.List
use package.iterator.(Iterator, IntoIterator, FromIterator)
use package.iterator.IterStep.(Done, Yield)

/// A UTF-8 byte sequence used as Staple's string type.
pub type String = wrap SharedBuffer U8

extern "staple-intrinsic" {
    __string_add: (String, String) -> String
}

/// Converts a value to its string representation.
pub trait ToString T {
    /// Converts this value to a string.
    to_string: T -> String
}

def string_to_bytes = value: String => List U8 :: {
    let String bytes = value
    let length = SharedBuffer.length bytes
    let mut result: List U8 = List.with_capacity length
    let mut index: USize = 0
    loop {
        if (index == length) { break }
        result |> push (SharedBuffer.get_unchecked bytes index)
        index = index + 1
    }
    result
}

def string_from_utf8_unchecked = move bytes: List U8 => String :: String (List.into_buffer bytes |> Buffer.into_shared_buffer)

/// A non-copying iterator over the UTF-8 bytes of a string.
pub type StringBytes = wrap (string: String, index: USize)

impl Iterator StringBytes {
    type Item = U8
    next = move StringBytes (string, index) => {
        let String bytes = string
        if (index < SharedBuffer.length bytes) {
            let byte = SharedBuffer.get_unchecked bytes index
            Yield (byte, StringBytes (string: string, index: index + 1))
        } else {
            Done (StringBytes (string: string, index: index))
        }
    }
}

impl IntoIterator StringBytes {
    type Iter = StringBytes
    into_iterator = move iterator => iterator
}

companion String {

    /// Copies the UTF-8 bytes of a string into a new list.
    pub def to_bytes = value: String => List U8 :: string_to_bytes value

    /// Returns an iterator over the UTF-8 bytes of a string without copying them.
    pub def bytes = value: String => StringBytes :: StringBytes (string: value, index: 0)

    /// Constructs a String from bytes, returning InvalidUtf8 on validation failure.
    pub def from_utf8 = move bytes: List U8 => Result String InvalidUtf8 :: {
        let shared = List.into_buffer bytes |> Buffer.into_shared_buffer
        if (__valid_utf8 shared == 1) {
            Ok (String shared)
        } else {
            InvalidUtf8
        }
    }

    /// Constructs a string from bytes known to contain valid UTF-8.
    pub def from_utf8_unchecked = move bytes: List U8 => String :: string_from_utf8_unchecked bytes
}

impl Add String {
    add = (left; right) => __string_add (left, right)
}

impl Eq String {
    eq = (String left; String right) => Eq.eq (left; right)
}

impl Default String { default = () => "" }

impl FromIterator String String {
    insert = (move left; move right) => left + right
    // Concatenating piece by piece would copy the text built so far each time.
    // Gather the bytes into one list instead, and build the string once.
    insert_all = <Iter where Iterator Iter, Iterator.Item Iter == String> (move start; move pieces) => {
        let mut bytes = string_to_bytes start
        let mut remaining = pieces
        loop {
            match Iterator.next remaining {
                Done _ => { break },
                Yield (piece, rest) => {
                    remaining = rest
                    for byte in (String.bytes piece) { List.push bytes byte }
                },
            }
        }
        string_from_utf8_unchecked bytes
    }
}

extern "staple-intrinsic" {
    __parse_i8: String -> (U8, I8)
    __parse_i16: String -> (U8, I16)
    __parse_i32: String -> (U8, I32)
    __parse_i64: String -> (U8, I64)
    __parse_u8: String -> (U8, U8)
    __parse_u16: String -> (U8, U16)
    __parse_u32: String -> (U8, U32)
    __parse_u64: String -> (U8, U64)
    __parse_isize: String -> (U8, ISize)
    __parse_usize: String -> (U8, USize)
    __parse_f32: String -> (U8, F32)
    __parse_f64: String -> (U8, F64)
    __valid_utf8: SharedBuffer U8 -> U8
}

impl TryConvert String I8 {
    type Error = ConversionError
    try_convert = move value => {
        let result = __parse_i8 value
        checked_conversion result
    }
}

impl TryConvert String I16 {
    type Error = ConversionError
    try_convert = move value => {
        let result = __parse_i16 value
        checked_conversion result
    }
}

impl TryConvert String I32 {
    type Error = ConversionError
    try_convert = move value => {
        let result = __parse_i32 value
        checked_conversion result
    }
}

impl TryConvert String I64 {
    type Error = ConversionError
    try_convert = move value => {
        let result = __parse_i64 value
        checked_conversion result
    }
}

impl TryConvert String U8 {
    type Error = ConversionError
    try_convert = move value => {
        let result = __parse_u8 value
        checked_conversion result
    }
}

impl TryConvert String U16 {
    type Error = ConversionError
    try_convert = move value => {
        let result = __parse_u16 value
        checked_conversion result
    }
}

