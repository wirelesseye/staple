impl TryConvert String F32 {
    type Error = ConversionError
    try_convert = move value => {
        let result = __parse_f32 value
        checked_conversion result
    }
}

impl TryConvert String F64 {
    type Error = ConversionError
    try_convert = move value => {
        let result = __parse_f64 value
        checked_conversion result
    }
}

impl TryConvert String Bool {
    type Error = InvalidBool
    try_convert = move value => when {
        value == "True" => Ok (Bool :: True),
        value == "true" => Ok (Bool :: True),
        value == "False" => Ok (Bool :: False),
        value == "false" => Ok (Bool :: False),
        else => InvalidBool,
    }
}

impl Convert String (Slice U8) {
    convert = move value => String.bytes value
}
