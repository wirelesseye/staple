/// The bytes are not valid UTF-8.
pub type InvalidUtf8

use package.convert.checked_conversion
use package.default.Default

use package.shared_buffer.(SharedBuffer)
use package.buffer.(Buffer)
use package.list.List
use package.iterator.(Iterator, IntoIterator, FromIterator)
use package.iterator.IterStep.(Done, Yield)

/// A UTF-8 byte sequence used as Staple's string type.
///
/// Strings are shared and immutable. Copying a `String` shares the same
/// underlying bytes instead of duplicating them, and no operation writes to
/// those bytes once the string exists. This makes strings cheap to pass around
/// and safe to alias, while still requiring a new allocation to build modified
/// text.
///
/// String literals are read-only constants outside the GC heap. Their bytes
/// must never be written, and their buffer must never be released or pinned.
pub type String wrap SharedBuffer<U8>

pub(package) def string_shared_bytes = value: String => SharedBuffer<U8> :: {
    let String bytes = value
    bytes
}

// The caller must ensure the shared bytes contain valid UTF-8.
pub(package) def string_from_shared_bytes_unchecked = bytes: SharedBuffer<U8> => String :: String bytes

// Copies immutable string bytes only into fresh mutable list storage.
pub(package) def append_string_bytes = (mut list: List<U8>; value: String) => () :: {
    let String bytes = value
    List.append_shared_bytes list bytes
}

extern "staple-intrinsic" {
    __string_add: (String, String) -> String
}

/// Converts a value to its string representation.
pub trait ToString T {
    /// Converts this value to a string.
    to_string: T -> String
}

/// A non-copying iterator over the UTF-8 bytes of a string.
pub type StringBytes wrap (string: String, index: USize)

impl Iterator StringBytes {
    type Item = U8
    next = move StringBytes (string, index) => {
        let String bytes = string
        if (index < SharedBuffer.length bytes) {
            let byte = SharedBuffer.get_unchecked bytes index
            Yield (byte, StringBytes (string: string, index: index + 1))
        } else {
            Done (StringBytes (string: string, index: index))
        }
    }
}

impl IntoIterator StringBytes {
    type Iter = StringBytes
    into_iterator = move iterator => iterator
}

/// A non-copying iterator over the Unicode scalar values of a string.
pub type StringChars wrap (string: String, index: USize)

// Both scalar iterators decode through the same UTF-8 path.
def decode_at = (bytes: SharedBuffer<U8>; index: USize) => (Char, USize) :: {
    let first = (SharedBuffer.get_unchecked bytes index) as U32
    let length: USize = when {
        first < 128 => 1,
        first < 224 => 2,
        first < 240 => 3,
        else => 4,
    }
    let mut scalar: U32 = when {
        length == 1 => first,
        length == 2 => BitAnd.bit_and (first; 31),
        length == 3 => BitAnd.bit_and (first; 15),
        else => BitAnd.bit_and (first; 7),
    }
    let mut offset: USize = 1
    loop {
        if (offset == length) { break }
        let byte = (SharedBuffer.get_unchecked bytes (index + offset)) as U32
        scalar = (ShiftLeft.shift_left (scalar; 6)) + (BitAnd.bit_and (byte; 63))
        offset = offset + 1
    }
    (Char.from_u32_unchecked scalar, length)
}

impl Iterator StringChars {
    type Item = Char
    next = move StringChars (string, index) => {
        let String bytes = string
        if (index < SharedBuffer.length bytes) {
            let (c, length) = decode_at bytes index
            Yield (c, StringChars (string: string, index: index + length))
        } else {
            Done (StringChars (string: string, index: index))
        }
    }
}

impl IntoIterator StringChars {
    type Iter = StringChars
    into_iterator = move iterator => iterator
}

companion String {
    /// Iterates Unicode scalar values without copying the string's bytes.
    pub def chars = value: String => StringChars :: StringChars (string: value, index: 0)

    /// Counts Unicode scalar values in O(n) time.
    pub def char_count = value: String => USize :: {
        let mut count: USize = 0
        for c in (String.chars value) { count = count + 1 }
        count
    }

    /// Copies the UTF-8 bytes of a string into a new list.
    pub def to_bytes = value: String => List<U8> :: {
        let mut result: List<U8> = List.with_capacity (String.length value)
        append_string_bytes result value
        result
    }

    /// Returns an iterator over the UTF-8 bytes of a string without copying them.
    pub def bytes = value: String => StringBytes :: StringBytes (string: value, index: 0)

    /// Constructs a String from bytes, returning InvalidUtf8 on validation failure.
    pub def from_utf8 = move bytes: List<U8> => Result<String, InvalidUtf8> :: {
        let shared = List.into_buffer bytes |> Buffer.into_shared_buffer
        if (__valid_utf8 shared == 1) {
            Ok (String shared)
        } else {
            InvalidUtf8
        }
    }

    /// Constructs a string from bytes known to contain valid UTF-8.
    pub def from_utf8_unchecked = move bytes: List<U8> => String ::
        String (List.into_buffer bytes |> Buffer.into_shared_buffer)
}

impl Add String {
    add = (left; right) => __string_add (left, right)
}

impl Eq String {
    eq = (String left; String right) => Eq.eq (left; right)
}

impl Default String { default = () => "" }

impl Display String {
    fmt = (value, mut formatter) => Formatter.write formatter value
}

impl Debug String {
    // Escapes are all ASCII, so unescaped scalars pass through unchanged.
    fmt = (value, mut formatter) => {
        Formatter.write formatter "\""
        for c in (String.chars value) {
            let scalar = Char.to_u32 c
            when {
                scalar == 0 => Formatter.write formatter "\\0",
                scalar == 9 => Formatter.write formatter "\\t",
                scalar == 10 => Formatter.write formatter "\\n",
                scalar == 13 => Formatter.write formatter "\\r",
                scalar == 34 => Formatter.write formatter "\\\"",
                scalar == 92 => Formatter.write formatter "\\\\",
                else => Formatter.push formatter c,
            }
        }
        Formatter.write formatter "\""
    }
}

impl FromIterator String Char {
    insert = (move start; move c) => {
        let mut builder = StringBuilder.from_string start
        StringBuilder.push builder c
        StringBuilder.finish builder
    }
    insert_all = <Iter where Iterator Iter, Iterator.Item Iter == Char> (move start; move chars) => {
        let mut builder = StringBuilder.from_string start
        let mut remaining = chars
        loop {
            match Iterator.next remaining {
                Done _ => { break },
                Yield (value, rest) => {
                    remaining = rest
                    StringBuilder.push builder value
                },
            }
        }
        StringBuilder.finish builder
    }
}

impl FromIterator String String {
    insert = (move left; move right) => {
        let mut builder = StringBuilder.with_capacity (String.length left + String.length right)
        StringBuilder.append builder left
        StringBuilder.append builder right
        StringBuilder.finish builder
    }
    insert_all = <Iter where Iterator Iter, Iterator.Item Iter == String> (move start; move pieces) => {
        let mut builder = StringBuilder.from_string start
        let mut remaining = pieces
        loop {
            match Iterator.next remaining {
                Done _ => { break },
                Yield (value, rest) => {
                    remaining = rest
                    StringBuilder.append builder value
                },
            }
        }
        StringBuilder.finish builder
    }
}

extern "staple-intrinsic" {
    __parse_i8: String -> (U8, I8)
    __parse_i16: String -> (U8, I16)
    __parse_i32: String -> (U8, I32)
    __parse_i64: String -> (U8, I64)
    __parse_u8: String -> (U8, U8)
    __parse_u16: String -> (U8, U16)
    __parse_u32: String -> (U8, U32)
    __parse_u64: String -> (U8, U64)
    __parse_isize: String -> (U8, ISize)
    __parse_usize: String -> (U8, USize)
    __parse_f32: String -> (U8, F32)
    __parse_f64: String -> (U8, F64)
    pub(package) __valid_utf8: SharedBuffer<U8> -> U8
}

impl TryConvert String I8 {
    type Error = ConversionError
    try_convert = move value => {
        let result = __parse_i8 value
        checked_conversion result
    }
}

impl TryConvert String I16 {
    type Error = ConversionError
    try_convert = move value => {
        let result = __parse_i16 value
        checked_conversion result
    }
}

