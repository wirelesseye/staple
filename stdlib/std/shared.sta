pub mod

use package.cmp.(Eq)

/// An owned, copyable handle to a value in a garbage-collected allocation.
/// Copying the handle shares the same storage without copying the payload or
/// requiring `Copy T`. A handle keeps its containing allocation alive, including
/// when it refers to an element of a `SharedBuffer`.
///
/// `Shared.new value` or `Shared value` moves or copies a value into a new
/// managed allocation. Dropping a handle does not immediately destroy its
/// payload; the collector reclaims unreachable allocations and cleans up their
/// owned contents, including cycles of managed references.
///
/// Fields, indices, and patterns can access the payload through the handle.
/// Non-`Copy` payloads may be borrowed but cannot be moved out. `Shared.get`
/// copies a payload when `Copy T`; `Shared.replace (reference, value)` installs
/// a replacement and returns ownership of the previous value. Mutation requires
/// a `mut` root, and every alias observes changes to the shared storage.
///
/// The handle has an opaque, sized representation even when `T` is unsized.
/// Construction requires a concrete payload layout. Where `Eq T`, equality
/// compares payload values rather than handle addresses.
@sized_opaque
@recursive_constructor
pub type Shared<T where ?Sized T> opaque

extern "staple-intrinsic" {
    __shared_replace: <T> (mut Shared<T>, move T) -> T
}

companion<T> Shared<T> {
    /// Allocates a new payload, transferring ownership into the handle.
    pub def new = move value: T => Shared<T> :: Shared value

    /// Replaces the referenced value and returns the old value.
    pub def replace: (mut Shared<T>, move T) -> T = (mut reference, move value) => __shared_replace (reference, value)
}

impl<T where Eq T> Eq Shared<T> {
    eq = (Shared left; Shared right) => Eq.eq (left; right)
}

companion<T where Copy T> Shared<T> {
    /// Copies the payload without consuming the handle.
    pub def get = reference: Shared<T> => T :: match reference { Shared value => value }
}
