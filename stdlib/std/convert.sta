pub mod

use package.result.(Ok, Result)

/// Converts a value into another type without failure.
pub trait Convert From To {
    /// Consumes the source value and returns the converted value.
    convert: move From -> To
}

/// Converts a value into another type, possibly returning an error.
pub trait TryConvert From To {
    /// The error returned when conversion fails.
    type Error

    /// Consumes the source value and returns a success or an error.
    try_convert: move From -> Result<To, Error>
}

impl<T> Convert T T {
    convert = move value => value
}

impl<From, To where Convert From To> TryConvert From To {
    type Error = Never
    try_convert = move value => Ok (To :: Convert.convert value)
}

// `ConversionError` is written out by hand, as `typegroup` would produce it,
// because `std.string` and `std.number` (in `if`'s closure) depend on it
// before `std.convert` is expanded.

companion ConversionError {
    /// The value is outside the target type's range.
    pub type OutOfRange
    /// The target cannot represent the value exactly.
    pub type PrecisionLoss
    /// NaN or infinity cannot be converted to an integer.
    pub type NonFinite
    /// The complete input is not a valid number.
    pub type InvalidNumber
}

/// The reason a checked conversion failed.
pub type ConversionError from pub ConversionError.OutOfRange | ConversionError.PrecisionLoss | ConversionError.NonFinite | ConversionError.InvalidNumber

pub(package) def checked_conversion = <T> move (status: U8, value: T) => Ok<T> | ConversionError :: match (status == 0) {
    True => Ok value,
    False => match (status == 1) {
        True => ConversionError.OutOfRange,
        False => match (status == 2) {
            True => ConversionError.PrecisionLoss,
            False => match (status == 3) {
                True => ConversionError.NonFinite,
                False => ConversionError.InvalidNumber,
            },
        },
    },
}
