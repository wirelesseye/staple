pub mod

use package.process.(panic)
use package.result.(Ok, Result)
use package.string.String

/// Splits a value into a success `Output` or a failure `Residual`.
pub trait Try T {
    /// The value a success carries.
    type Output
    /// What remains of a failure.
    type Residual

    /// Returns the success as `Ok`, or the failure's residual.
    branch: move T -> Ok Output | Residual

    /// Returns the success value, panicking at the caller on a failure.
    @track_caller
    unwrap: move T -> Output = move value => match (branch value) {
        Ok output => output,
        _ => panic "called `unwrap` on a failure",
    }

    /// Returns the success value, panicking at the caller with `message` on
    /// a failure.
    @track_caller
    expect: (move T; String) -> Output = (move value; message) => match (branch value) {
        Ok output => output,
        _ => panic message,
    }
}

impl<T, E> Try (Result T E) {
    type Output = T
    type Residual = E
    branch = move value => value
}

impl<T> Try (Option T) {
    type Output = T
    type Residual = None
    branch = move value => match value {
        Some output => Ok output,
        None => None,
    }
}
