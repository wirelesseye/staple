pub mod

use std.core.boolean.(True, False)
use std.iterator.(IntoIterator, Iterator)
use std.iterator.IterStep.(Done, Yield)
use std.syntax.*

def when_clauses:
    Sequence (Expr, FatArrow, Expr) ->
    Expr =
clauses => match clauses {
    Sequence () => parse_quote { () },
    Sequence (
        first: (Expr, FatArrow, Expr),
        rest: Sequence (Expr, FatArrow, Expr),
    ) => match first {
        (condition: Ident "else", _, fallback) => match rest {
            Sequence () => fallback,
        },
        (condition, _, branch) => {
            let otherwise = when_clauses rest
            parse_quote {
                match $condition satisfies Bool {
                    True() => $branch,
                    False() => $otherwise,
                }
            }
        },
    },
}

/// Evaluates the first matching condition from an ordered set of branches.
///
/// # Example
///
/// ```staple
/// when {
///     ready => start (),
///     else => wait ()
/// }
/// ```
pub macro when =
    body: Braced (Separated (Expr, FatArrow, Expr) Comma) => match body {
        Braced (Separated (_, clauses, _)) => when_clauses clauses,
    }

// `if` takes an infix `if <cond> <then>` form, optionally followed by
// any number of `else if <cond> <then>` arms and a trailing `else <otherwise>`.
// Each branch is a plain `Expr` (usually a `{ ... }` block), so braces are not
// required. The condition is a single atomic argument; a compound condition is
// parenthesised, matching `while` and `for`. The trailing arms arrive as a flat
// `Sequence Expr` of `else` / `if` / condition / branch atoms, which this helper
// walks recursively.
def if_branches: (Expr, Expr, Sequence Expr) -> Expr = (condition, consequent, rest) => {
    // `first` and `rest` are the required binding names for a `Sequence`
    // head/tail destructure, so each level rebinds `first` to a descriptive
    // local before recursing.
    let otherwise = match rest {
        Sequence () => parse_quote { () },
        Sequence (first: Expr, rest: Sequence Expr) => match first {
            else_keyword: Ident "else" => match rest {
                Sequence (first: Expr, rest: Sequence Expr) => match first {
                    if_keyword: Ident "if" => match rest {
                        Sequence (first: Expr, rest: Sequence Expr) => {
                            let elif_condition = first
                            match rest {
                                Sequence (first: Expr, rest: Sequence Expr) => {
                                    let elif_consequent = first
                                    if_branches (elif_condition, elif_consequent, rest)
                                },
                            }
                        },
                    },
                    otherwise_branch => match rest {
                        Sequence () => otherwise_branch,
                    },
                },
            },
        },
    }
    parse_quote {
        match $condition satisfies Bool {
            True() => $consequent,
            False() => $otherwise,
        }
    }
}

/// Evaluates a conditional expression with optional `else if` and `else` branches.
///
/// # Example
///
/// ```staple
/// if ready { start () } else { wait () }
/// ```
pub macro if =
    condition: Expr *
    consequent: Expr *
    rest: Sequence Expr =>
    if_branches (condition, consequent, rest)

/// Repeats a body while its condition evaluates to `True`.
///
/// # Example
///
/// ```staple
/// while (index < limit) { index = index + 1 }
/// ```
pub macro while =
    condition: Expr *
    body: Expr =>
    parse_quote {
        loop {
            match $condition satisfies Bool {
                True() => $body,
                False() => { break },
            }
        }
    }

/// Iterates over an `IntoIterator`, binding each item to a pattern.
///
/// # Example
///
/// ```staple
/// for item in items { process item }
/// ```
pub macro for =
    pattern: Pattern *
    _: Ident "in" *
    source: Expr *
    body: Expr =>
    parse_quote {
        {
            let mut iterator = IntoIterator.into_iterator $source
            loop {
                match Iterator.next iterator {
                    Done _ => { break },
                    Yield (item, next_iterator) => {
                        iterator = next_iterator
                        let $pattern = item
                        $body
                    },
                }
            }
        }
    }
