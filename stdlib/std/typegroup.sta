pub mod

use std.syntax.*

def typegroup_public_visibility: Visibility -> Visibility = visibility => match visibility {
    Private => Private,
    Package => Package,
    Public => Public,
    PublicReprPackage => Public,
    PublicRepr => Public,
}

def typegroup_variant_visibility: Visibility -> Visibility = visibility => match visibility {
    Private => PublicRepr,
    Package => PublicReprPackage,
    Public => Public,
    PublicReprPackage => PublicReprPackage,
    PublicRepr => PublicRepr,
}

def typegroup_visibility_syntax: Visibility -> Syntax = visibility => match visibility {
    Private => quote {},
    Package => quote { pub(package) },
    Public => quote { pub },
    PublicReprPackage => quote { pub(repr(package)) },
    PublicRepr => quote { pub(repr) },
}

def typegroup_apply_modifiers: (Sequence Modifier, Item) -> Item = (modifiers, item) => match modifiers {
    Sequence () => item,
    _ => ModifiedItem (modifiers: modifiers, item: item),
}

def typegroup_items:
    (
        Visibility,
        Sequence (Sequence Modifier, Ident String, Optional Type),
    ) -> Sequence Item =
(visibility, entries) => match entries {
    Sequence () => Sequence (),
    Sequence (
        first: (Sequence Modifier, Ident String, Optional Type),
        rest: Sequence (Sequence Modifier, Ident String, Optional Type),
    ) => match first {
        (modifiers: Sequence Modifier, variant: Ident String, None) => {
            let base: Item = parse_quote { $visibility type $variant }
            let item: Item = typegroup_apply_modifiers (modifiers, base)
            Sequence (first: item, rest: typegroup_items (visibility, rest))
        },
        (modifiers: Sequence Modifier, variant: Ident String, Some underlying) => {
            let base: Item = parse_quote { $visibility type $variant = $underlying }
            let item: Item = typegroup_apply_modifiers (modifiers, base)
            Sequence (first: item, rest: typegroup_items (visibility, rest))
        },
        _ => panic "typegroup entry is unsupported",
    },
}

def typegroup_generic_items:
    (
        Syntax,
        Syntax,
        Sequence (Sequence Modifier, Ident String, Optional Type),
    ) -> Sequence Item =
(visibility, parameters, entries) => match entries {
    Sequence () => Sequence (),
    Sequence (
        first: (Sequence Modifier, Ident String, Optional Type),
        rest: Sequence (Sequence Modifier, Ident String, Optional Type),
    ) => {
        let tail = typegroup_generic_items (visibility, parameters, rest)
        match first {
            (modifiers: Sequence Modifier, variant: Ident String, None) => {
                let base: Item = parse_quote { $visibility type $variant }
                let item: Item = typegroup_apply_modifiers (modifiers, base)
                Sequence (first: item, rest: tail)
            },
            (modifiers: Sequence Modifier, variant: Ident String, Some underlying) => {
                let base: Item = parse_quote { $visibility type $variant $parameters = $underlying }
                let item: Item = typegroup_apply_modifiers (modifiers, base)
                Sequence (first: item, rest: tail)
            },
            _ => panic "generic typegroup entry is unsupported",
        }
    },
}

def typegroup_sum:
    (
        Ident String,
        Sequence (Sequence Modifier, Ident String, Optional Type),
    ) -> Type =
(group, entries) => match entries {
    Sequence (
        first: (Sequence Modifier, Ident String, Optional Type),
        rest: Sequence (Sequence Modifier, Ident String, Optional Type),
    ) => match first {
        (_, variant: Ident String, _) => {
            let head: Type = parse_quote { $group.$variant }
            match rest {
                Sequence () => head,
                _ => {
                    let tail = typegroup_sum (group, rest)
                    parse_quote { $head | $tail } satisfies Type
                },
            }
        },
    },
    _ => panic "empty typegroup is unsupported",
}

def typegroup_parameter_syntax: Sequence Type -> Syntax = parameters => match parameters {
    Sequence () => quote {},
    Sequence (
        first: Type,
        rest: Sequence Type,
    ) => {
        let tail = typegroup_parameter_syntax rest
        quote { $first $tail }
    },
}

def typegroup_generic_sum_syntax:
    (
        Ident String,
        Syntax,
        Sequence (Sequence Modifier, Ident String, Optional Type),
    ) -> Syntax =
(group, parameters, entries) => match entries {
    Sequence (
        first: (Sequence Modifier, Ident String, Optional Type),
        rest: Sequence (Sequence Modifier, Ident String, Optional Type),
    ) => match first {
        (_, variant: Ident String, underlying) => {
            let head: Syntax = match underlying {
                None => quote { $group.$variant },
                Some _ => quote { $group.$variant $parameters },
            }
            match rest {
                Sequence () => head,
                _ => {
                    let tail = typegroup_generic_sum_syntax (group, parameters, rest)
                    quote { $head | $tail }
                },
            }
        },
    },
    _ => panic "empty generic typegroup is unsupported",
}

/// Declares a sum-type alias and companion variants from a compact definition.
///
/// # Example
///
/// ```staple
/// typegroup Switch { Enabled, Disabled }
/// ```
pub macro typegroup:
    MacroCallMetadata *
    Ident String *
    Sequence Type *
    Braced (Separated (Sequence Modifier, Ident String, Optional Type) Comma) ->
    Sequence Item =
(modifiers, visibility) *
group *
parameters *
body => {
    match body {
    Braced (Separated (
        separator,
        elements,
        trailing,
    )) => {
        let item_visibility = typegroup_variant_visibility visibility
        let public_visibility = typegroup_public_visibility visibility
        match parameters {
            Sequence () => {
                let items = typegroup_items (item_visibility, elements)
                let sum: Type = typegroup_sum (group, elements)
                let base: Item = parse_quote {
                    $public_visibility type alias $group = $sum
                }
                let alias_item: Item = typegroup_apply_modifiers (modifiers, base)
                let companion_item: Item = parse_quote {
                    companion $group {
                        $items...
                    }
                }
                Sequence (
                    first: companion_item,
                    rest: Sequence (first: alias_item, rest: Sequence ()),
                )
            },
            _ => {
                let parameter_syntax = typegroup_parameter_syntax parameters
                let generic_item_visibility = typegroup_visibility_syntax item_visibility
                let generic_public_visibility = typegroup_visibility_syntax public_visibility
                let items = typegroup_generic_items (generic_item_visibility, parameter_syntax, elements)
                let sum = typegroup_generic_sum_syntax (group, parameter_syntax, elements)
                let base: Item = parse_quote {
                    $generic_public_visibility type alias $group $parameter_syntax = $sum
                }
                let alias_item: Item = typegroup_apply_modifiers (modifiers, base)
                let companion_item: Item = parse_quote {
                    companion $group {
                        $items...
                    }
                }
                Sequence (
                    first: companion_item,
                    rest: Sequence (first: alias_item, rest: Sequence ()),
                )
            },
        }
    },
    }
}
