pub mod

use package.syntax.*
use package.process.(panic)

def typegroup_apply_modifiers = (
    modifiers: Sequence<Modifier>,
    item: Item,
) => Item :: match modifiers {
    Sequence () => item,
    _ => ModifiedItem (modifiers: modifiers, item: item),
}

// Macro helpers reuse syntax values, as with TypeParameters below. Explicitly
// duplicate distributed modifiers so every application gets fresh syntax IDs.
def typegroup_prepend = (prefix: Sequence<Modifier>, suffix: Sequence<Modifier>) => Sequence<Modifier> :: match prefix {
    Sequence () => suffix,
    Sequence (first, rest) => {
        let (copy, _) = duplicate_modifier first
        Sequence (first: copy, rest: typegroup_prepend (rest, suffix))
    },
}

def typegroup_modifier_contents = syntax: Syntax => Sequence<Modifier> :: {
    let wrapped = quote { ($syntax) }
    match Parse.parse_all.<Parenthesized<Separated<Modifier, Comma>>> wrapped {
        Ok (Parenthesized (Separated (_, elements, _))) => elements,
        _ => panic "invalid typegroup modifier argument",
    }
}

def typegroup_split_modifiers = modifiers: Sequence<Modifier> => (Sequence<Modifier>, Sequence<Modifier>, Sequence<Modifier>) :: match modifiers {
    Sequence () => (Sequence (), Sequence (), Sequence ()),
    Sequence (first, rest) => {
        let (variants, group, remaining) = typegroup_split_modifiers rest
        match first {
            ModifierCall (Sequence (), Ident "all", Some argument) => {
                let contents = typegroup_modifier_contents argument
                (typegroup_prepend (contents, variants), typegroup_prepend (contents, group), remaining)
            },
            ModifierCall (Sequence (), Ident "variants", Some argument) => {
                let contents = typegroup_modifier_contents argument
                (typegroup_prepend (contents, variants), group, remaining)
            },
            _ => (variants, group, Sequence (first: first, rest: remaining)),
        }
    },
}

def typegroup_body_item = (variant: Ident<String>, body: TypeBody) => Item :: match body {
    AliasBody underlying => parse_quote { pub type $variant = $underlying },
    WrapperBody (visibility, underlying) => match visibility {
        Private => parse_quote { pub type $variant wrap $underlying },
        Package => parse_quote { pub type $variant wrap pub(package) $underlying },
        Public => parse_quote { pub type $variant wrap pub $underlying },
    },
    FromBody (visibility, underlying) => match visibility {
        Private => parse_quote { pub type $variant from $underlying },
        Package => parse_quote { pub type $variant from pub(package) $underlying },
        Public => parse_quote { pub type $variant from pub $underlying },
    },
    OpaqueBody => panic "opaque typegroup variants are unsupported",
}

def typegroup_generic_body_item = (
    variant: Ident<String>,
    parameters: TypeParameters,
    body: TypeBody,
) => Item :: {
    let declaration = parameters.declaration
    match body {
        AliasBody underlying => parse_quote { pub type $variant$declaration = $underlying },
        WrapperBody (visibility, underlying) => match visibility {
            Private => parse_quote { pub type $variant$declaration wrap $underlying },
            Package => parse_quote { pub type $variant$declaration wrap pub(package) $underlying },
            Public => parse_quote { pub type $variant$declaration wrap pub $underlying },
        },
        FromBody (visibility, underlying) => match visibility {
            Private => parse_quote { pub type $variant$declaration from $underlying },
            Package => parse_quote { pub type $variant$declaration from pub(package) $underlying },
            Public => parse_quote { pub type $variant$declaration from pub $underlying },
        },
        OpaqueBody => panic "opaque typegroup variants are unsupported",
    }
}

def typegroup_items = (shared: Sequence<Modifier>, entries: Sequence<(Sequence<Modifier>; Ident<String>; Option<TypeBody>)>) => Sequence<Item> :: match entries {
    Sequence () => Sequence (),
    Sequence (first, rest) => match first {
        (modifiers; variant; None) => {
            let base: Item = parse_quote { pub type $variant }
            let item = typegroup_apply_modifiers (typegroup_prepend (shared, modifiers), base)
            Sequence (first: item, rest: typegroup_items (shared, rest))
        },
        (modifiers; variant; Some body) => {
            let base: Item = typegroup_body_item (variant, body)
            let item = typegroup_apply_modifiers (typegroup_prepend (shared, modifiers), base)
            Sequence (first: item, rest: typegroup_items (shared, rest))
        },
    },
}

def typegroup_generic_items = (
    shared: Sequence<Modifier>,
    parameters: TypeParameters,
    entries: Sequence<(Sequence<Modifier>; Ident<String>; Option<TypeBody>)>,
) => Sequence<Item> :: match entries {
    Sequence () => Sequence (),
    Sequence (first, rest) => {
        let tail = typegroup_generic_items (shared, parameters, rest)
        match first {
            (modifiers; variant; None) => {
                let base: Item = parse_quote { pub type $variant }
                let item = typegroup_apply_modifiers (typegroup_prepend (shared, modifiers), base)
                Sequence (first: item, rest: tail)
            },
            (modifiers; variant; Some body) => {
                let base: Item = typegroup_generic_body_item (variant, parameters, body)
                let item = typegroup_apply_modifiers (typegroup_prepend (shared, modifiers), base)
                Sequence (first: item, rest: tail)
            },
        }
    },
}

def typegroup_sum = (
    group: Ident<String>,
    entries: Sequence<(Sequence<Modifier>; Ident<String>; Option<TypeBody>)>,
) => Type :: match entries {
    Sequence (first, rest) => match first {
        (_; variant; _) => {
            let head: Type = parse_quote { $group.$variant }
            match rest {
                Sequence () => head,
                _ => {
                    let tail = typegroup_sum (group, rest)
                    parse_quote { $head | $tail }
                },
            }
        },
    },
    _ => panic "empty typegroup is unsupported",
}

def typegroup_generic_sum_syntax = (
    group: Ident<String>,
    parameters: TypeParameters,
    entries: Sequence<(Sequence<Modifier>; Ident<String>; Option<TypeBody>)>,
) => Syntax :: match entries {
    Sequence (first, rest) => match first {
        (_; variant; underlying) => {
            let head: Syntax = match underlying {
                None => quote { $group.$variant },
                Some _ => {
                    let arguments = parameters.arguments
                    quote { $group.$variant$arguments }
                },
            }
            match rest {
                Sequence () => head,
                _ => {
                    let tail = typegroup_generic_sum_syntax (group, parameters, rest)
                    quote { $head | $tail }
                },
            }
        },
    },
    _ => panic "empty generic typegroup is unsupported",
}

/// Declares a nominal type over a sum of variants, with the variants in its
/// companion, from a compact definition.
///
/// Every entry becomes a public declaration in the group's companion module.
/// A bare name is a singleton variant; `wrap`, `from`, `=`, and `opaque`
/// bodies follow the ordinary type declaration body grammar. The group is a
/// `from` type over the sum of every variant except an `opaque` one, with its
/// representation as visible as the group, so a variant converts to the group
/// implicitly and patterns on the group see through to its variants.
///
/// Generic groups use the ordinary `<T = Default where ...>` declaration
/// header. Represented variants retain that header, and applications use only
/// its argument names. Bare singleton variants remain unparameterized.
///
/// # Example
///
/// ```staple
/// typegroup Switch {
///     Enabled,
///     Disabled,
/// }
///
/// typegroup Example {
///     Wrapped wrap pub I32,
///     Number = I32,
///     Empty,
/// }
/// ```
/// `@all(@derive_debug)` applies to the group and every variant.
/// `@variants(@derive_debug)` applies only to variants. Distributed modifiers
/// precede each variant's own modifiers, in the order of the prefixes.
pub macro typegroup
    modifiers (
        @all(Separated<Modifier, Comma>),
        @variants(Separated<Modifier, Comma>),
    )
    :
    (MacroCallMetadata; Ident<String>; Option<TypeParameters>; Braced<Separated<(Sequence<Modifier>; Ident<String>; Option<TypeBody>), Comma>>) ->
    Sequence<Item> =
    ((modifiers, visibility); group; parameters; body) => {
    let (shared, group_modifiers, remaining) = typegroup_split_modifiers modifiers
    let modifiers = typegroup_prepend (group_modifiers, remaining)
    match body {
    Braced (Separated (
        separator,
        elements,
        trailing,
    )) => {
        match parameters {
            None => {
                let items = typegroup_items (shared, elements)
                let sum = typegroup_sum (group, elements)
                // The group is a `from` type over its variants' sum, exposing
                // its representation as widely as the group itself.
                let base: Item = match visibility {
                    Private => Item :: parse_quote { $visibility type $group from $sum },
                    Package => Item :: parse_quote { $visibility type $group from pub(package) $sum },
                    Public => Item :: parse_quote { $visibility type $group from pub $sum },
                }
                let group_item = typegroup_apply_modifiers (modifiers, base)
                let companion_item: Item = parse_quote {
                    companion $group {
                        $items...
                    }
                }
                Sequence (
                    first: companion_item,
                    rest: Sequence (first: group_item, rest: Sequence ()),
                )
            },
            Some parameters => {
                let declaration = parameters.declaration
                let items = typegroup_generic_items (shared, parameters, elements)
                let sum = typegroup_generic_sum_syntax (group, parameters, elements)
                let base: Item = match visibility {
                    Private => Item :: parse_quote {
                        $visibility type $group$declaration from $sum
                    },
                    Package => Item :: parse_quote {
                        $visibility type $group$declaration from pub(package) $sum
                    },
                    Public => Item :: parse_quote {
                        $visibility type $group$declaration from pub $sum
                    },
                }
                let group_item = typegroup_apply_modifiers (modifiers, base)
                let companion_item: Item = parse_quote {
                    companion $group {
                        $items...
                    }
                }
                Sequence (
                    first: companion_item,
                    rest: Sequence (first: group_item, rest: Sequence ()),
                )
            },
        }
    },
    }
}
