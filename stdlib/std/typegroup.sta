pub mod

use std.syntax.*

def typegroup_apply_modifiers: (Sequence Modifier, Item) -> Item = (modifiers, item) => match modifiers {
    Sequence () => item,
    _ => ModifiedItem (modifiers: modifiers, item: item),
}

def typegroup_body_item: (Ident String, TypeBody) -> Item = (variant, body) => match body {
    AliasBody underlying => parse_quote { pub type $variant = alias $underlying },
    WrapperBody (visibility, underlying) => match visibility {
        Private => parse_quote { pub type $variant = wrap $underlying },
        Package => parse_quote { pub type $variant = pub(package) wrap $underlying },
        Public => parse_quote { pub type $variant = pub wrap $underlying },
    },
    FromBody (visibility, underlying) => match visibility {
        Private => parse_quote { pub type $variant = from $underlying },
        Package => parse_quote { pub type $variant = pub(package) from $underlying },
        Public => parse_quote { pub type $variant = pub from $underlying },
    },
    OpaqueBody => panic "opaque typegroup variants are unsupported",
}

def typegroup_generic_body_item: (Ident String, Syntax, TypeBody) -> Item =
(variant, parameters, body) => match body {
    AliasBody underlying => parse_quote { pub type $variant $parameters = alias $underlying },
    WrapperBody (visibility, underlying) => match visibility {
        Private => parse_quote { pub type $variant $parameters = wrap $underlying },
        Package => parse_quote { pub type $variant $parameters = pub(package) wrap $underlying },
        Public => parse_quote { pub type $variant $parameters = pub wrap $underlying },
    },
    FromBody (visibility, underlying) => match visibility {
        Private => parse_quote { pub type $variant $parameters = from $underlying },
        Package => parse_quote { pub type $variant $parameters = pub(package) from $underlying },
        Public => parse_quote { pub type $variant $parameters = pub from $underlying },
    },
    OpaqueBody => panic "opaque typegroup variants are unsupported",
}

def typegroup_items:
    Sequence (Sequence Modifier, Ident String, Optional (Equals, TypeBody)) ->
    Sequence Item =
entries => match entries {
    Sequence () => Sequence (),
    Sequence (first, rest) => match first {
        (modifiers, variant, None) => {
            let base: Item = parse_quote { pub type $variant }
            let item = typegroup_apply_modifiers (modifiers, base)
            Sequence (first: item, rest: typegroup_items rest)
        },
        (modifiers, variant, Some (_, body)) => {
            let base: Item = typegroup_body_item (variant, body)
            let item = typegroup_apply_modifiers (modifiers, base)
            Sequence (first: item, rest: typegroup_items rest)
        },
    },
}

def typegroup_generic_items:
    (
        Syntax,
        Sequence (Sequence Modifier, Ident String, Optional (Equals, TypeBody)),
    ) -> Sequence Item =
(parameters, entries) => match entries {
    Sequence () => Sequence (),
    Sequence (first, rest) => {
        let tail = typegroup_generic_items (parameters, rest)
        match first {
            (modifiers, variant, None) => {
                let base: Item = parse_quote { pub type $variant }
                let item = typegroup_apply_modifiers (modifiers, base)
                Sequence (first: item, rest: tail)
            },
            (modifiers, variant, Some (_, body)) => {
                let base: Item = typegroup_generic_body_item (variant, parameters, body)
                let item = typegroup_apply_modifiers (modifiers, base)
                Sequence (first: item, rest: tail)
            },
        }
    },
}

def typegroup_sum:
    (
        Ident String,
        Sequence (Sequence Modifier, Ident String, Optional (Equals, TypeBody)),
    ) -> Type =
(group, entries) => match entries {
    Sequence (first, rest) => match first {
        (_, variant, _) => {
            let head: Type = parse_quote { $group.$variant }
            match rest {
                Sequence () => head,
                _ => {
                    let tail = typegroup_sum (group, rest)
                    parse_quote { $head | $tail }
                },
            }
        },
    },
    _ => panic "empty typegroup is unsupported",
}

def typegroup_parameter_syntax: Sequence Type -> Syntax = parameters => match parameters {
    Sequence () => quote {},
    Sequence (first, rest) => {
        let tail = typegroup_parameter_syntax rest
        quote { $first $tail }
    },
}

def typegroup_generic_sum_syntax:
    (
        Ident String,
        Syntax,
        Sequence (Sequence Modifier, Ident String, Optional (Equals, TypeBody)),
    ) -> Syntax =
(group, parameters, entries) => match entries {
    Sequence (first, rest) => match first {
        (_, variant, underlying) => {
            let head: Syntax = match underlying {
                None => quote { $group.$variant },
                Some _ => quote { $group.$variant $parameters },
            }
            match rest {
                Sequence () => head,
                _ => {
                    let tail = typegroup_generic_sum_syntax (group, parameters, rest)
                    quote { $head | $tail }
                },
            }
        },
    },
    _ => panic "empty generic typegroup is unsupported",
}

/// Declares a nominal type over a sum of variants, with the variants in its
/// companion, from a compact definition.
///
/// Every entry becomes a public declaration in the group's companion module.
/// A bare name is a singleton variant; `wrap`, `from`, `alias`, and `opaque`
/// bodies follow the ordinary type declaration body grammar. The group is a
/// `from` type over the sum of every variant except an `opaque` one, with its
/// representation as visible as the group, so a variant converts to the group
/// implicitly and patterns on the group see through to its variants.
///
/// # Example
///
/// ```staple
/// typegroup Switch {
///     Enabled,
///     Disabled,
/// }
///
/// typegroup Example {
///     Wrapped = pub wrap I32,
///     Number = alias I32,
///     Empty,
/// }
/// ```
pub macro typegroup:
    [MacroCallMetadata, Ident String, Sequence Type, Braced (Separated (Sequence Modifier, Ident String, Optional (Equals, TypeBody)) Comma)] ->
    Sequence Item =
    [(modifiers, visibility), group, parameters, body] => {
    match body {
    Braced (Separated (
        separator,
        elements,
        trailing,
    )) => {
        match parameters {
            Sequence () => {
                let items = typegroup_items elements
                let sum = typegroup_sum (group, elements)
                // The group is a `from` type over its variants' sum, exposing
                // its representation as widely as the group itself.
                let base: Item = match visibility {
                    Private => Item :: parse_quote { $visibility type $group = from $sum },
                    Package => Item :: parse_quote { $visibility type $group = pub(package) from $sum },
                    Public => Item :: parse_quote { $visibility type $group = pub from $sum },
                }
                let group_item = typegroup_apply_modifiers (modifiers, base)
                let companion_item: Item = parse_quote {
                    companion $group {
                        $items...
                    }
                }
                Sequence (
                    first: companion_item,
                    rest: Sequence (first: group_item, rest: Sequence ()),
                )
            },
            _ => {
                let parameter_syntax = typegroup_parameter_syntax parameters
                let items = typegroup_generic_items (parameter_syntax, elements)
                let sum = typegroup_generic_sum_syntax (group, parameter_syntax, elements)
                let base: Item = match visibility {
                    Private => Item :: parse_quote {
                        $visibility type $group $parameter_syntax = from $sum
                    },
                    Package => Item :: parse_quote {
                        $visibility type $group $parameter_syntax = pub(package) from $sum
                    },
                    Public => Item :: parse_quote {
                        $visibility type $group $parameter_syntax = pub from $sum
                    },
                }
                let group_item = typegroup_apply_modifiers (modifiers, base)
                let companion_item: Item = parse_quote {
                    companion $group {
                        $items...
                    }
                }
                Sequence (
                    first: companion_item,
                    rest: Sequence (first: group_item, rest: Sequence ()),
                )
            },
        }
    },
    }
}
