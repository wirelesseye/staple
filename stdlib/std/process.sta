pub mod

use package.io.(__staple_io_stream, __staple_io_write, __staple_io_flush)
use package.ptr.RawOpaquePtr
use package.shared_buffer.SharedBuffer
use package.source.(Location, track_caller)
use package.string.(String, string_shared_bytes)

extern "staple-intrinsic" {
    __trap: () -> Never
}

// Nested so the raw C `exit` symbol (extern bindings are always named
// exactly after their C symbol) doesn't collide with the `exit` wrapper
// below.
mod raw {
    pub(package) extern "c" {
        exit: I32 -> ()
    }
}

use raw.exit as terminate

/// Terminates the current process with the given exit code.
pub def exit = code: I32 => Never :: {
    let _ = terminate code
    loop { continue }
}

/// Aborts the program by executing a trap instruction.
///
/// This is an unrecoverable failure for internal invariants: it does not
/// unwind, drop values, or report a location. Use `panic` for failures that
/// should carry a message and the caller's location.
pub def trap = () => Never :: __trap ()

/// Terminates the program after printing `message` and the location of the
/// call to `panic`. Inside a `@track_caller` function, the location is that
/// function's caller.
@track_caller
pub def panic = message: String => Never :: {
    let location = Location.caller ()
    let bytes = string_shared_bytes "panic: ${message} at ${location}\n"
    let pointer = SharedBuffer.unsafe_data bytes
    let stream = __staple_io_stream 2
    let _ = __staple_io_write (stream, pointer as RawOpaquePtr, SharedBuffer.length bytes)
    let _ = __staple_io_flush stream
    exit 1
}
