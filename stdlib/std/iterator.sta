pub mod

companion IterStep {
    pub type Done Iter = pub ctor Iter
    pub type Yield (Item, Iter) = pub ctor (Item, Iter)
}

/// One step of an iterator: either completion or an item and next iterator.
pub type IterStep (Iter, Item) = alias
    IterStep.Done Iter |
    IterStep.Yield (Item, Iter)

/// A type that yields values one step at a time.
pub trait Iterator Iter Item where Iter ~> Item {
    /// Advances the iterator by one step.
    next: move Iter -> IterStep (Iter, Item)
}

/// A source that can be converted into an iterator.
pub trait IntoIterator Source Iter where Source ~> Iter, Iterator Iter {
    /// Converts this source into its iterator.
    into_iterator: move Source -> Iter
}
