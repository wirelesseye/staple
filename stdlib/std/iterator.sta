pub mod

use package.cmp.(Ord, Ordering)
use package.clone.Clone
use package.default.(Default)
use package.list.(List)
use package.ops.(Add)
use package.process.(panic)
use package.result.(Ok, Result)
use package.try.Try

companion IterStep {
    pub type Done<Iter> wrap pub Iter
    pub type Yield<Item, Iter> wrap pub (Item, Iter)
}

use IterStep.(Done, Yield)

/// One step of an iterator: either completion or an item and next iterator.
pub type IterStep<Iter, Item> from pub
    IterStep.Done<Iter> |
    IterStep.Yield<Item, Iter>

/// A type that yields values one step at a time.
pub trait Iterator Iter {
    /// The type of value yielded by each step.
    type Item

    /// Advances the iterator by one step.
    next: move Iter -> IterStep<Iter, Item>
}

/// A source that can be converted into an iterator.
pub trait IntoIterator Source {
    /// The iterator this source converts into.
    type Iter where Iterator Iter

    /// Converts this source into its iterator.
    into_iterator: move Source -> Iter
}

/// A type that can be built up one item at a time, starting from its default.
pub trait FromIterator Target Item {
    /// Adds one item to a partly built value.
    insert: (move Target; move Item) -> Target

    /// Adds every item of `iter` to `target`. `collect` and `extend` build
    /// through this member. The default inserts the items one by one; a
    /// target whose `insert` copies the value built so far, such as `String`,
    /// overrides it to build in a single pass.
    insert_all: <Iter where Iterator Iter, Iterator.Item Iter == Item>
        (move Target; move Iter) -> Target =
        <Iter where Iterator Iter, Iterator.Item Iter == Item> (move target; move iter) => {
            let mut built = target
            let mut remaining = iter
            loop {
                match Iterator.next remaining {
                    Done _ => { break },
                    Yield (item, rest) => {
                        remaining = rest
                        built = insert built item
                    },
                }
            }
            built
        }
}

// Adapters
//
// Every adapter owns its inner iterator and rebuilds itself around the
// successor on each step. A type representation cannot name
// `Iterator.Item Iter`, so each adapter stores a pure `step` closure that the
// operation creating it builds, where the projection is available; the
// adapter's own `Iterator` implementation then needs no bound on `S`.

/// The iterator returned by `map`.
pub type Map<S, Out> wrap (iter: S, step: move S -> IterStep<S, Out>)

impl<S, Out> Iterator Map<S, Out> {
    type Item = Out
    next = move Map (iter, step) => match step iter {
        Done rest => Done (Map.<S, Out> (iter: rest, step: step)),
        Yield (item, rest) => Yield (item, Map.<S, Out> (iter: rest, step: step)),
    }
}

impl<S, Out> IntoIterator Map<S, Out> {
    type Iter = Map<S, Out>
    into_iterator = move iterator => iterator
}

/// The iterator returned by `filter`.
pub type Filter<S, Out> wrap (iter: S, step: move S -> IterStep<S, Out>)

impl<S, Out> Iterator Filter<S, Out> {
    type Item = Out
    next = move Filter (iter, step) => match step iter {
        Done rest => Done (Filter.<S, Out> (iter: rest, step: step)),
        Yield (item, rest) => Yield (item, Filter.<S, Out> (iter: rest, step: step)),
    }
}

impl<S, Out> IntoIterator Filter<S, Out> {
    type Iter = Filter<S, Out>
    into_iterator = move iterator => iterator
}

/// The iterator returned by `filter_map`.
pub type FilterMap<S, Out> wrap (iter: S, step: move S -> IterStep<S, Out>)

impl<S, Out> Iterator FilterMap<S, Out> {
    type Item = Out
    next = move FilterMap (iter, step) => match step iter {
        Done rest => Done (FilterMap.<S, Out> (iter: rest, step: step)),
        Yield (item, rest) => Yield (item, FilterMap.<S, Out> (iter: rest, step: step)),
    }
}

impl<S, Out> IntoIterator FilterMap<S, Out> {
    type Iter = FilterMap<S, Out>
    into_iterator = move iterator => iterator
}

/// The iterator returned by `take`.
pub type Take<S, Out> wrap (iter: S, left: USize, step: move S -> IterStep<S, Out>)

impl<S, Out> Iterator Take<S, Out> {
    type Item = Out
    next = move Take (iter, left, step) => if (left == 0) {
        Done (Take.<S, Out> (iter: iter, left: 0, step: step))
    } else {
        match step iter {
            Done rest => Done (Take.<S, Out> (iter: rest, left: 0, step: step)),
            Yield (item, rest) => Yield (
                item,
                Take.<S, Out> (iter: rest, left: left - 1, step: step),
            ),
        }
    }
}

impl<S, Out> IntoIterator Take<S, Out> {
    type Iter = Take<S, Out>
    into_iterator = move iterator => iterator
}

/// The iterator returned by `skip`.
pub type Skip<S, Out> wrap (iter: S, pending: USize, step: move S -> IterStep<S, Out>)

impl<S, Out> Iterator Skip<S, Out> {
    type Item = Out
    next = move Skip (iter, pending, step) => {
        let mut remaining = iter
        let mut skipping = pending
        loop {
            match step remaining {
                Done rest => { return Done (Skip.<S, Out> (iter: rest, pending: 0, step: step)) },
                Yield (item, rest) => {
                    if (skipping == 0) {
                        return Yield (item, Skip.<S, Out> (iter: rest, pending: 0, step: step))
                    }
                    skipping = skipping - 1
                    remaining = rest
                },
            }
        }
    }
}

impl<S, Out> IntoIterator Skip<S, Out> {
    type Iter = Skip<S, Out>
    into_iterator = move iterator => iterator
}

/// The iterator returned by `take_while`.
pub type TakeWhile<S, Out> wrap (iter: S, finished: Bool, step: move S -> IterStep<S, Out>)

impl<S, Out> Iterator TakeWhile<S, Out> {
    type Item = Out
    next = move TakeWhile (iter, finished, step) => if finished {
        Done (TakeWhile.<S, Out> (iter: iter, finished: True, step: step))
    } else {
        match step iter {
            Done rest => Done (TakeWhile.<S, Out> (iter: rest, finished: True, step: step)),
            Yield (item, rest) => Yield (
                item,
                TakeWhile.<S, Out> (iter: rest, finished: False, step: step),
            ),
        }
    }
}

impl<S, Out> IntoIterator TakeWhile<S, Out> {
    type Iter = TakeWhile<S, Out>
    into_iterator = move iterator => iterator
}

/// The iterator returned by `enumerate`.
pub type Enumerate<S, Out> wrap (iter: S, index: USize, step: move S -> IterStep<S, Out>)

impl<S, Out> Iterator Enumerate<S, Out> {
    type Item = (USize, Out)
    next = move Enumerate (iter, index, step) => match step iter {
        Done rest => Done (Enumerate.<S, Out> (iter: rest, index: index, step: step)),
        Yield (item, rest) => Yield (
            (index, item),
            Enumerate.<S, Out> (iter: rest, index: index + 1, step: step),
        ),
    }
}

impl<S, Out> IntoIterator Enumerate<S, Out> {
    type Iter = Enumerate<S, Out>
    into_iterator = move iterator => iterator
}

/// The iterator returned by `zip`.
pub type Zip<L, R, A, B> wrap (
    left: L,
    right: R,
    left_step: move L -> IterStep<L, A>,
    right_step: move R -> IterStep<R, B>,
)

impl<L, R, A, B> Iterator Zip<L, R, A, B> {
    type Item = (A, B)
    next = move Zip (left, right, left_step, right_step) => match left_step left {
        Done left_rest => Done (Zip.<L, R, A, B> (
            left: left_rest,
            right: right,
            left_step: left_step,
            right_step: right_step,
        )),
        Yield (a, left_rest) => match right_step right {
            Done right_rest => Done (Zip.<L, R, A, B> (
                left: left_rest,
                right: right_rest,
                left_step: left_step,
                right_step: right_step,
            )),
            Yield (b, right_rest) => Yield (
                (a, b),
                Zip.<L, R, A, B> (
                    left: left_rest,
                    right: right_rest,
                    left_step: left_step,
                    right_step: right_step,
                ),
            ),
        },
    }
}

impl<L, R, A, B> IntoIterator Zip<L, R, A, B> {
    type Iter = Zip<L, R, A, B>
    into_iterator = move iterator => iterator
}

/// The iterator returned by `chain`.
pub type Chain<L, R, Out> wrap (
    first: L,
    second: R,
    on_second: Bool,
    first_step: move L -> IterStep<L, Out>,
    second_step: move R -> IterStep<R, Out>,
)

impl<L, R, Out> Iterator Chain<L, R, Out> {
    type Item = Out
    next = move Chain (first, second, on_second, first_step, second_step) => if on_second {
        match second_step second {
            Done rest => Done (Chain.<L, R, Out> (first: first, second: rest, on_second: True, first_step: first_step, second_step: second_step)),
            Yield (item, rest) => Yield (
                item,
                Chain.<L, R, Out> (first: first, second: rest, on_second: True, first_step: first_step, second_step: second_step),
            ),
        }
    } else {
        match first_step first {
            Done rest => Iterator.next (Chain.<L, R, Out> (
                first: rest,
                second: second,
                on_second: True,
                first_step: first_step,
                second_step: second_step,
            )),
            Yield (item, rest) => Yield (
                item,
                Chain.<L, R, Out> (first: rest, second: second, on_second: False, first_step: first_step, second_step: second_step),
            ),
        }
    }
}

impl<L, R, Out> IntoIterator Chain<L, R, Out> {
    type Iter = Chain<L, R, Out>
    into_iterator = move iterator => iterator
}

/// The iterator returned by `flat_map`.
pub type FlatMap<S, Inner, Out> wrap (
    iter: S,
    inner: Option<Inner>,
    step: move S -> IterStep<S, Inner>,
    inner_step: move Inner -> IterStep<Inner, Out>,
)

impl<S, Inner, Out> Iterator FlatMap<S, Inner, Out> {
    type Item = Out
    next = move FlatMap (iter, inner, step, inner_step) => {
        let mut outer = iter
        let mut current = inner
        loop {
            match current {
                Some active => match inner_step active {
                    Done _ => { current = None },
                    Yield (item, rest) => {
                        return Yield (item, FlatMap.<S, Inner, Out> (
                            iter: outer,
                            inner: Option<Inner> :: Some rest,
                            step: step,
                            inner_step: inner_step,
                        ))
                    },
                },
                None => match step outer {
                    Done rest => {
                        return Done (FlatMap.<S, Inner, Out> (
                            iter: rest,
                            inner: Option<Inner> :: None,
                            step: step,
                            inner_step: inner_step,
                        ))
                    },
                    Yield (next_inner, rest) => {
                        outer = rest
                        current = Option<Inner> :: Some next_inner
                    },
                },
            }
        }
    }
}

impl<S, Inner, Out> IntoIterator FlatMap<S, Inner, Out> {
    type Iter = FlatMap<S, Inner, Out>
    into_iterator = move iterator => iterator
}

/// The state carried between steps of a `scan` iterator.
pub type ScanState<S, Iter> wrap (
    state: Option<S>,
    iter: Iter,
)

/// The iterator returned by `scan`.
pub type Scan<S, Iter, Out> wrap (
    state: ScanState<S, Iter>,
    step: move ScanState<S, Iter> -> IterStep<ScanState<S, Iter>, Out>,
)

impl<S, Iter, Out> Iterator Scan<S, Iter, Out> {
    type Item = Out
    next = move Scan (state, step) => match step state {
        Done next_state => Done (Scan.<S, Iter, Out> (state: next_state, step: step)),
        Yield (item, next_state) => Yield (item, Scan.<S, Iter, Out> (
            state: next_state,
            step: step,
        )),
    }
}

impl<S, Iter, Out> IntoIterator Scan<S, Iter, Out> {
    type Iter = Scan<S, Iter, Out>
    into_iterator = move iterator => iterator
}

/// The iterator returned by `skip_while`.
pub type SkipWhile<S, Out> wrap (
    iter: S,
    skipping: Bool,
    step: move S -> IterStep<S, Out>,
    keep: Out -> Bool,
)

impl<S, Out> Iterator SkipWhile<S, Out> {
    type Item = Out
    next = move SkipWhile (iter, skipping, step, keep) => {
        let mut remaining = iter
        let mut active = skipping
        loop {
            match step remaining {
                Done rest => {
                    return Done (SkipWhile.<S, Out> (
                        iter: rest,
                        skipping: False,
                        step: step,
                        keep: keep,
                    ))
                },
                Yield (item, rest) => {
                    if (active && keep item) {
                        remaining = rest
                    } else {
                        return Yield (item, SkipWhile.<S, Out> (
                            iter: rest,
                            skipping: False,
                            step: step,
                            keep: keep,
                        ))
                    }
                },
            }
        }
    }
}

impl<S, Out> IntoIterator SkipWhile<S, Out> {
    type Iter = SkipWhile<S, Out>
    into_iterator = move iterator => iterator
}

/// The iterator returned by `step_by`.
pub type StepBy<S, Out> wrap (
    iter: S,
    remaining: USize,
    stride: USize,
    step: move S -> IterStep<S, Out>,
)

impl<S, Out> Iterator StepBy<S, Out> {
    type Item = Out
    next = move StepBy (iter, remaining, stride, step) => {
        let mut current = iter
        let mut pending = remaining
        loop {
            match step current {
                Done rest => {
                    return Done (StepBy.<S, Out> (
                        iter: rest,
                        remaining: 0,
                        stride: stride,
                        step: step,
                    ))
                },
                Yield (item, rest) => {
                    if (pending == 0) {
                        return Yield (item, StepBy.<S, Out> (
                            iter: rest,
                            remaining: stride - 1,
                            stride: stride,
                            step: step,
                        ))
                    }
                    pending = pending - 1
                    current = rest
                },
            }
        }
    }
}

impl<S, Out> IntoIterator StepBy<S, Out> {
    type Iter = StepBy<S, Out>
    into_iterator = move iterator => iterator
}

/// The iterator returned by `peekable`.
pub type Peekable<S, Out> wrap (
    iter: S,
    peeked: Option<Out>,
    step: move S -> IterStep<S, Out>,
)

impl<S, Out> Iterator Peekable<S, Out> {
    type Item = Out
    next = move Peekable (iter, peeked, step) => match peeked {
        Some item => Yield (item, Peekable.<S, Out> (
            iter: iter,
            peeked: Option<Out> :: None,
            step: step,
        )),
        None => match step iter {
            Done rest => Done (Peekable.<S, Out> (
                iter: rest,
                peeked: Option<Out> :: None,
                step: step,
            )),
            Yield (item, rest) => Yield (item, Peekable.<S, Out> (
                iter: rest,
                peeked: Option<Out> :: None,
                step: step,
            )),
        },
    }
}

impl<S, Out> IntoIterator Peekable<S, Out> {
    type Iter = Peekable<S, Out>
    into_iterator = move iterator => iterator
}

companion<S, Out where Copy Out> Peekable<S, Out> {
    /// Returns the next item without consuming it, together with the iterator
    /// that still holds it.
    pub def peek = move iterator: Peekable<S, Out> => (Option<Out>, Peekable<S, Out>) ::
        match iterator {
            Peekable (iter, Some item, step) => (
                Some item,
                Peekable.<S, Out> (iter: iter, peeked: Option<Out> :: Some item, step: step),
            ),
            Peekable (iter, None, step) => match step iter {
                Done rest => (
                    None,
                    Peekable.<S, Out> (iter: rest, peeked: Option<Out> :: None, step: step),
                ),
                Yield (item, rest) => (
                    Some item,
                    Peekable.<S, Out> (iter: rest, peeked: Option<Out> :: Some item, step: step),
                ),
            },
        }
}

/// A source iterator that yields no items.
pub type Empty<T> wrap ()

impl<T> Iterator Empty<T> {
    type Item = T
    next = move iterator => match iterator {
        Empty () => Done (Empty.<T> ()),
    }
}

impl<T> IntoIterator Empty<T> {
    type Iter = Empty<T>
    into_iterator = move iterator => iterator
}

/// A source iterator that yields one value.
pub type Once<T> wrap (value: Option<T>)

impl<T> Iterator Once<T> {
    type Item = T
    next = move Once value => match value {
        Some item => Yield (item, Once (value: Option<T> :: None)),
        None => Done (Once (value: Option<T> :: None)),
    }
}

impl<T> IntoIterator Once<T> {
    type Iter = Once<T>
    into_iterator = move iterator => iterator
}

/// A source iterator that yields one value a fixed number of times.
pub type RepeatN<T> wrap (
    value: T,
    left: USize,
)

impl<T where Clone T> Iterator RepeatN<T> {
    type Item = T
    next = move RepeatN (value, left) => if (left == 0) {
        Done (RepeatN (value: value, left: 0))
    } else {
        Yield (
            Clone.clone value,
            RepeatN (value: value, left: left - 1),
        )
    }
}

impl<T where Clone T> IntoIterator RepeatN<T> {
    type Iter = RepeatN<T>
    into_iterator = move iterator => iterator
}

/// A source iterator that starts from an optional value and applies a function
/// to produce each successor.
pub type Successors<T> wrap (
    state: Option<T>,
    step: move Option<T> -> IterStep<Option<T>, T>,
)

impl<T> Iterator Successors<T> {
    type Item = T
    next = move Successors (state, step) => match step state {
        Done rest => Done (Successors (state: rest, step: step)),
        Yield (item, rest) => Yield (item, Successors (state: rest, step: step)),
    }
}

impl<T> IntoIterator Successors<T> {
    type Iter = Successors<T>
    into_iterator = move iterator => iterator
}

// Operations
//
// Every iterator gets these operations as blanket companion members, so
// `iter |> map f` works for any `Iterator` without importing anything.
// Adapters are lazy and take pure functions, because `Iterator.next` is
// pure: effects belong in the consumers, which run immediately and are
// effect-polymorphic. Short-circuiting consumers drop the rest of the
// iterator.
companion<Iter where Iterator Iter> Iter {
    /// Lazily applies `f` to each item.
    ///
    /// ```staple
    /// (1 .. 4) |> map (x => x * 10)   // 10, 20, 30
    /// ```
    pub def map = <B>
        (move iter: Iter; f: move Iterator.Item Iter -> B) => Map<Iter, B> :: {
        let step = move current: Iter => IterStep<Iter, B> :: match Iterator.next current {
            Done rest => Done rest,
            Yield (item, rest) => Yield (f item, rest),
        }
        Map.<Iter, B> (iter: iter, step: step)
    }

    /// Lazily keeps the items for which `keep` returns `True`.
    ///
    /// ```staple
    /// (1 .. 7) |> filter (x => x > 3)   // 4, 5, 6
    /// ```
    pub def filter =
        (move iter: Iter; keep: Iterator.Item Iter -> Bool) => Filter<Iter, Iterator.Item Iter> :: {
        let step = move current: Iter => IterStep<Iter, Iterator.Item Iter> :: {
            let mut remaining = current
            loop {
                match Iterator.next remaining {
                    Done rest => { return Done rest },
                    Yield (item, rest) => {
                        if (keep item) { return Yield (item, rest) }
                        remaining = rest
                    },
                }
            }
        }
        Filter.<Iter, Iterator.Item Iter> (iter: iter, step: step)
    }

    /// Lazily applies `f` to each item and keeps the values it returns as `Some`.
    pub def filter_map = <B>
        (move iter: Iter; f: move Iterator.Item Iter -> Option<B>) => FilterMap<Iter, B> :: {
        let step = move current: Iter => IterStep<Iter, B> :: {
            let mut remaining = current
            loop {
                match Iterator.next remaining {
                    Done rest => { return Done rest },
                    Yield (item, rest) => {
                        match f item {
                            Some value => { return Yield (value, rest) },
                            None => { remaining = rest },
                        }
                    },
                }
            }
        }
        FilterMap.<Iter, B> (iter: iter, step: step)
    }

    /// Lazily yields at most the first `count` items.
    pub def take =
        (move iter: Iter; count: USize) => Take<Iter, Iterator.Item Iter> :: {
        let step = move current: Iter => IterStep<Iter, Iterator.Item Iter> ::
            Iterator.next current
        Take.<Iter, Iterator.Item Iter> (iter: iter, left: count, step: step)
    }

    /// Lazily drops the first `count` items and yields the rest.
    pub def skip =
        (move iter: Iter; count: USize) => Skip<Iter, Iterator.Item Iter> :: {
        let step = move current: Iter => IterStep<Iter, Iterator.Item Iter> ::
            Iterator.next current
        Skip.<Iter, Iterator.Item Iter> (iter: iter, pending: count, step: step)
    }

    /// Lazily yields items while `keep` returns `True`, and stops at the first
    /// item for which it returns `False`. That item is dropped.
    pub def take_while =
        (move iter: Iter; keep: Iterator.Item Iter -> Bool) => TakeWhile<Iter, Iterator.Item Iter> :: {
        // `Done` from the step means "stop here", whether the inner iterator ran
        // out or `keep` rejected an item.
        let step = move current: Iter => IterStep<Iter, Iterator.Item Iter> :: match Iterator.next current {
            Done rest => Done rest,
            Yield (item, rest) => if (keep item) { Yield (item, rest) } else { Done rest },
        }
        TakeWhile.<Iter, Iterator.Item Iter> (iter: iter, finished: False, step: step)
    }

    /// Lazily pairs each item with its position, starting at `0`.
    pub def enumerate = move iter: Iter => Enumerate<Iter, Iterator.Item Iter> :: {
        let step = move current: Iter => IterStep<Iter, Iterator.Item Iter> ::
            Iterator.next current
        Enumerate.<Iter, Iterator.Item Iter> (iter: iter, index: 0, step: step)
    }

    /// Lazily pairs the items of two iterators, stopping when either runs out.
    /// When `right` runs out first, the item already taken from `iter` is dropped.
    pub def zip = <R where Iterator R>
        (move iter: Iter; move right: R) => Zip<Iter, R, Iterator.Item Iter, Iterator.Item R> :: {
        let left_step = move current: Iter => IterStep<Iter, Iterator.Item Iter> ::
            Iterator.next current
        let right_step = move current: R => IterStep<R, Iterator.Item R> :: Iterator.next current
        Zip.<Iter, R, Iterator.Item Iter, Iterator.Item R> (
            left: iter,
            right: right,
            left_step: left_step,
            right_step: right_step,
        )
    }

    /// Lazily yields every item of `iter`, then every item of `second`.
    /// Both iterators must yield the same item type; their iterator types may differ.
    pub def chain = <R where Iterator R, Iterator.Item Iter == Iterator.Item R>
        (move iter: Iter; move second: R) => Chain<Iter, R, Iterator.Item Iter> :: {
        let first_step = move current: Iter => IterStep<Iter, Iterator.Item Iter> ::
            Iterator.next current
        let second_step = move current: R => IterStep<R, Iterator.Item Iter> ::
            Iterator.next current
        Chain.<Iter, R, Iterator.Item Iter> (
            first: iter,
            second: second,
            on_second: False,
            first_step: first_step,
            second_step: second_step,
        )
    }

    /// Lazily maps each item to an iterator and yields that iterator's items.
    pub def flat_map = <Inner, B where Iterator Inner, Iterator.Item Inner == B>
        (move iter: Iter; f: move Iterator.Item Iter -> Inner) => FlatMap<Iter, Inner, B> :: {
        let step = move current: Iter => IterStep<Iter, Inner> :: match Iterator.next current {
            Done rest => Done rest,
            Yield (item, rest) => Yield (f item, rest),
        }
        let inner_step = move current: Inner => IterStep<Inner, B> :: Iterator.next current
        FlatMap.<Iter, Inner, B> (
            iter: iter,
            inner: Option<Inner> :: None,
            step: step,
            inner_step: inner_step,
        )
    }

    /// Lazily threads state through `f`, yielding each `Some` value and
    /// stopping at the first `None`.
    pub def scan = <S, I, B where Iterator.Item Iter == I>
        (move iter: Iter; move init: S;
         f: (move S, move I) -> (S, Option<B>)) => Scan<S, Iter, B> :: {
        let step = move current: ScanState<S, Iter> => IterStep<ScanState<S, Iter>, B> ::
            match current {
                ScanState (state, iter) => match state {
                    None => Done (ScanState (state: Option<S> :: None, iter: iter)),
                    Some value => match Iterator.next iter {
                        Done rest => Done (ScanState (state: Option<S> :: None, iter: rest)),
                        Yield (item, rest) => match f (value, item) {
                            (next, Some output) => Yield (
                                output,
                                ScanState (state: Option<S> :: Some next, iter: rest),
                            ),
                            (_next, None) => Done (ScanState (state: Option<S> :: None, iter: rest)),
                        },
                    },
                },
            }
        Scan.<S, Iter, B> (
            state: ScanState (state: Option<S> :: Some init, iter: iter),
            step: step,
        )
    }

    /// Lazily drops items while `keep` returns `True`, then yields the rest.
    /// The first item `keep` rejects is yielded.
    pub def skip_while =
        (move iter: Iter; keep: Iterator.Item Iter -> Bool)
        => SkipWhile<Iter, Iterator.Item Iter> :: {
        let step = move current: Iter => IterStep<Iter, Iterator.Item Iter> ::
            Iterator.next current
        SkipWhile.<Iter, Iterator.Item Iter> (
            iter: iter,
            skipping: True,
            step: step,
            keep: keep,
        )
    }

    /// Lazily yields the first item, then every `count`th item after it.
    pub def step_by =
        (move iter: Iter; count: USize) => StepBy<Iter, Iterator.Item Iter> :: {
        if (count == 0) { panic "step_by requires a positive step" }
        let step = move current: Iter => IterStep<Iter, Iterator.Item Iter> ::
            Iterator.next current
        StepBy.<Iter, Iterator.Item Iter> (
            iter: iter,
            remaining: 0,
            stride: count,
            step: step,
        )
    }

    /// Lazily wraps an iterator so its next item can be inspected without
    /// consuming it.
    pub def peekable = move iter: Iter => Peekable<Iter, Iterator.Item Iter> :: {
        let step = move current: Iter => IterStep<Iter, Iterator.Item Iter> ::
            Iterator.next current
        Peekable.<Iter, Iterator.Item Iter> (iter: iter, peeked: Option<Iterator.Item Iter> :: None, step: step)
    }

    /// Combines every item into an accumulator, from first to last.
    ///
    /// ```staple
    /// (1 .. 5) |> fold 0 ((total, x) => total + x)   // 10
    /// ```
    pub def fold = <A, effect E>
        (move iter: Iter; move init: A; f: (move A, move Iterator.Item Iter) ->{E} A) =>{E} A :: {
        let mut remaining = iter
        let mut accumulator = init
        loop {
            match Iterator.next remaining {
                Done _ => { break },
                Yield (item, rest) => {
                    remaining = rest
                    accumulator = f (accumulator, item)
                },
            }
        }
        accumulator
    }

    /// Calls `f` with every item, in order.
    pub def for_each = <effect E>
        (move iter: Iter; f: move Iterator.Item Iter ->{E} ()) =>{E} () :: {
        let mut remaining = iter
        loop {
            match Iterator.next remaining {
                Done _ => { break },
                Yield (item, rest) => {
                    remaining = rest
                    f item
                },
            }
        }
    }

    /// Combines the items pairwise with `f`, using the first item as the
    /// starting value. Returns `None` for an empty iterator.
    pub def reduce = <effect E>
        (move iter: Iter; f: (move Iterator.Item Iter, move Iterator.Item Iter) ->{E} Iterator.Item Iter)
        =>{E} Option<Iterator.Item Iter> :: match Iterator.next iter {
        Done _ => None,
        Yield (first, rest) => {
            let mut remaining = rest
            let mut accumulator = first
            loop {
                match Iterator.next remaining {
                    Done _ => { break },
                    Yield (item, after) => {
                        remaining = after
                        accumulator = f (accumulator, item)
                    },
                }
            }
            Some accumulator
        },
    }

    /// Counts the items.
    pub def count = move iter: Iter => USize :: {
        let mut remaining = iter
        let mut total: USize = 0
        loop {
            match Iterator.next remaining {
                Done _ => { break },
                Yield (_, rest) => {
                    remaining = rest
                    total = total + 1
                },
            }
        }
        total
    }

    /// Returns whether `test` returns `True` for some item, stopping at the first.
    pub def any = <effect E>
        (move iter: Iter; test: Iterator.Item Iter ->{E} Bool) =>{E} Bool :: {
        let mut remaining = iter
        loop {
            match Iterator.next remaining {
                Done _ => { return False },
                Yield (item, rest) => {
                    if (test item) { return True }
                    remaining = rest
                },
            }
        }
    }

    /// Returns whether `test` returns `True` for every item, stopping at the
    /// first that fails. An empty iterator satisfies it.
    pub def all = <effect E>
        (move iter: Iter; test: Iterator.Item Iter ->{E} Bool) =>{E} Bool :: {
        let mut remaining = iter
        loop {
            match Iterator.next remaining {
                Done _ => { return True },
                Yield (item, rest) => {
                    if (test item) { remaining = rest } else { return False }
                },
            }
        }
    }

    /// Returns the first item for which `test` returns `True`.
    pub def find = <effect E>
        (move iter: Iter; test: Iterator.Item Iter ->{E} Bool) =>{E} Option<Iterator.Item Iter> :: {
        let mut remaining = iter
        loop {
            match Iterator.next remaining {
                Done _ => { return None },
                Yield (item, rest) => {
                    if (test item) { return Some item }
                    remaining = rest
                },
            }
        }
    }

    /// Returns the position of the first item for which `test` returns
    /// `True`, counting from `0`.
    pub def position = <effect E>
        (move iter: Iter; test: Iterator.Item Iter ->{E} Bool) =>{E} Option<USize> :: {
        let mut remaining = iter
        let mut index: USize = 0
        loop {
            match Iterator.next remaining {
                Done _ => { return None },
                Yield (item, rest) => {
                    if (test item) { return Some index }
                    remaining = rest
                    index = index + 1
                },
            }
        }
    }

    /// Returns the item at position `index`, or `None` when the iterator ends
    /// first. The items before it are dropped.
    pub def nth = (move iter: Iter; index: USize) => Option<Iterator.Item Iter> :: {
        let mut remaining = iter
        let mut skipped: USize = 0
        loop {
            if (skipped == index) {
                return match Iterator.next remaining {
                    Done _ => None,
                    Yield (item, _) => Some item,
                }
            }
            match Iterator.next remaining {
                Done _ => { return None },
                Yield (_, rest) => {
                    remaining = rest
                    skipped = skipped + 1
                },
            }
        }
    }

    /// Combines items until `f` reports failure, returning the first failure.
    /// A successful fold is returned as `Ok` of the accumulated value.
    pub def try_fold = <A, R, effect E where Try R, Try.Output R == A>
        (move iter: Iter; move init: A; f: (move A, move Iterator.Item Iter) ->{E} R)
        =>{E} Result<A, Try.Residual R> :: {
        let mut accumulator = init
        let mut remaining = iter
        loop {
            match Iterator.next remaining {
                Done _ => { break },
                Yield (item, rest) => {
                    remaining = rest
                    match Try.branch (f (accumulator, item)) {
                        Ok next => { accumulator = next },
                        residual => { return residual },
                    }
                },
            }
        }
        accumulator
    }

    /// Returns the last item, or `None` for an empty iterator.
    pub def last = move iter: Iter => Option<Iterator.Item Iter> :: {
        let mut remaining = iter
        let mut latest: Option<Iterator.Item Iter> = None
        loop {
            match Iterator.next remaining {
                Done _ => { break },
                Yield (item, rest) => {
                    remaining = rest
                    latest = Some item
                },
            }
        }
        latest
    }

    /// Collects the items into a target chosen by the expected type, starting
    /// from that target's default value.
    ///
    /// ```staple
    /// let numbers: List I32 = (1 .. 4) |> map (x => x * 10) |> collect
    /// let words: String = (1 .. 4) |> map (x => "w${x}") |> collect
    /// ```
    pub def collect = <C, A where Iterator.Item Iter == A, Default C, FromIterator C A>
        move iter: Iter => C :: FromIterator.insert_all (C :: Default.default ()) iter

    /// Collects the items into a new `List`, in order.
    pub def to_list = move iter: Iter => List<Iterator.Item Iter> :: iter |> collect

    /// Adds every item to an existing value, returning the extended value.
    pub def extend = <C, A where Iterator.Item Iter == A, FromIterator C A>
        (move iter: Iter; move target: C) => C :: FromIterator.insert_all target iter
}

companion<Iter where Iterator Iter, Add (Iterator.Item Iter), Default (Iterator.Item Iter)> Iter {
    /// Adds the items together, starting from the item type's default value.
    pub def sum = move iter: Iter => Iterator.Item Iter :: {
        let mut remaining = iter
        let mut total: Iterator.Item Iter = Default.default ()
        loop {
            match Iterator.next remaining {
                Done _ => { break },
                Yield (item, rest) => {
                    remaining = rest
                    total = total + item
                },
            }
        }
        total
    }
}

companion<Iter where Iterator Iter, Ord (Iterator.Item Iter)> Iter {
    /// Returns the smallest item, or `None` for an empty iterator. Of several
    /// equal smallest items, the first is returned.
    pub def min = move iter: Iter => Option<Iterator.Item Iter> :: match Iterator.next iter {
        Done _ => None,
        Yield (first, rest) => Some (
            rest |> fold first ((move best, move item) => if (item < best) { item } else { best }),
        ),
    }

    /// Returns the largest item, or `None` for an empty iterator. Of several
    /// equal largest items, the last is returned.
    pub def max = move iter: Iter => Option<Iterator.Item Iter> :: match Iterator.next iter {
        Done _ => None,
        Yield (first, rest) => Some (
            rest |> fold first ((move best, move item) => if (item < best) { best } else { item }),
        ),
    }
}

companion<Iter where Iterator Iter> Iter {
    /// Returns the smallest item according to `compare`, or `None` for an empty
    /// iterator. Of several equal smallest items, the first is returned.
    pub def min_by = <effect E>
        (move iter: Iter;
         compare: (Iterator.Item Iter, Iterator.Item Iter) ->{E} Ordering)
        =>{E} Option<Iterator.Item Iter> :: match Iterator.next iter {
        Done _ => None,
        Yield (first, rest) => {
            let mut remaining = rest
            let mut best = first
            loop {
                match Iterator.next remaining {
                    Done _ => { break },
                    Yield (item, after) => {
                        remaining = after
                        match compare (item, best) {
                            Ordering.Less() => { best = item },
                            _ => {},
                        }
                    },
                }
            }
            Some best
        },
    }

    /// Returns the largest item according to `compare`, or `None` for an empty
    /// iterator. Of several equal largest items, the last is returned.
    pub def max_by = <effect E>
        (move iter: Iter;
         compare: (Iterator.Item Iter, Iterator.Item Iter) ->{E} Ordering)
        =>{E} Option<Iterator.Item Iter> :: match Iterator.next iter {
        Done _ => None,
        Yield (first, rest) => {
            let mut remaining = rest
            let mut best = first
            loop {
                match Iterator.next remaining {
                    Done _ => { break },
                    Yield (item, after) => {
                        remaining = after
                        match compare (item, best) {
                            Ordering.Less() => {},
                            _ => { best = item },
                        }
                    },
                }
            }
            Some best
        },
    }
}

/// Creates an iterator that yields no items.
pub def empty = <T> () => Empty<T> :: Empty ()

/// Creates an iterator that yields `value` once.
pub def once = <T> move value: T => Once<T> :: Once (value: Option<T> :: Some value)

/// Creates an iterator that yields `value` `count` times.
pub def repeat_n = <T where Clone T> (move value: T; count: USize) => RepeatN<T> ::
    RepeatN (value: value, left: count)

/// Creates an iterator from `first` and successive applications of `next`.
pub def successors = <T>
    (move first: Option<T>; next: T -> Option<T>) => Successors<T> :: {
    let step = move current: Option<T> => IterStep<Option<T>, T> :: match current {
        None => Done.<Option<T>> (Option<T> :: None),
        Some value => match next value {
            Some next_value => Yield.<T, Option<T>> (value, Option<T> :: Some next_value),
            None => Yield.<T, Option<T>> (value, Option<T> :: None),
        },
    }
    Successors (state: first, step: step)
}
