pub mod

use std.fmt.(Display, Debug, Formatter)

/// A logical value that is either true or false.
pub typegroup Bool {
    /// The logical true value.
    True,
    /// The logical false value.
    False,
}
pub use Bool.*

impl Display Bool {
    def fmt = (value, mut formatter) => formatter^write (if value { "True" } else { "False" })
}

impl Debug Bool {
    def fmt = (value, mut formatter) => Display.fmt (value, formatter)
}

impl Eq Bool {
    def eq = (left, right) => match (left, right) {
        (True(), True()) => True,
        (False(), False()) => True,
        _ => False,
    }
}

impl Not Bool {
    def not = value => if value { False } else { True }
}
