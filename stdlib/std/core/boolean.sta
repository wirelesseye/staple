pub type True
pub type False
pub type alias Bool = True | False

pub macro if =
    condition: Expr =>
    then_branch: Expr =>
    quote {
        match $condition {
            True() => $then_branch,
            False() => (),
        }
    }

pub macro if =
    condition: Expr =>
    then_branch: Expr =>
    Ident "else" =>
    else_branch: Expr =>
    quote {
        match $condition {
            True() => $then_branch,
            False() => $else_branch,
        }
    }

impl Eq Bool {
    def equal = left => right => match (left, right) {
        (True(), True()) => True,
        (False(), False()) => True,
        _ => False,
    }
    def not_equal = left => right => match (left, right) {
        (True(), False()) => True,
        (False(), True()) => True,
        _ => False,
    }
}
