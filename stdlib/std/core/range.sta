pub mod

use std.iterator.(IntoIterator, Iterator)
use std.iterator.IterStep.(Done, Yield)

/// A half-open range from `current` up to, but excluding, `end`.
pub type Range T = pub wrap (
    current: T,
    end: T,
)

/// A range that includes its final `end` value.
pub type RangeInclusive T = pub wrap (
    current: T,
    end: T,
    finished: Bool,
)

/// Creates a half-open range from `start` to `end`.
pub def range : <T where Copy T> T -> T -> Range T = start => end => Range (
    current: start,
    end: end,
)

/// Creates an inclusive range from `start` to `end`.
pub def range_inclusive : <T where Copy T> T -> T -> RangeInclusive T = start => end => RangeInclusive (
    current: start,
    end: end,
    finished: False,
)

impl Iterator (Range I8) {
    type Item = I8
    next = move Range (current, end) => if (current < end) {
        Yield (
            current,
            Range (
                current: current + 1,
                end: end,
            ),
        )
    } else {
        Done (Range (
            current: current,
            end: end,
        ))
    }
}

impl IntoIterator (Range I8) {
    type Iter = Range I8
    into_iterator = move iterator => iterator
}

impl Iterator (RangeInclusive I8) {
    type Item = I8
    next = move RangeInclusive (current, end, finished) => when {
        finished => Done (RangeInclusive (
            current: current,
            end: end,
            finished: True,
        )),
        current < end => Yield (
            current,
            RangeInclusive (
                current: current + 1,
                end: end,
                finished: False,
            ),
        ),
        current == end => Yield (
            current,
            RangeInclusive (
                current: current,
                end: end,
                finished: True,
            ),
        ),
        else => Done (RangeInclusive (
            current: current,
            end: end,
            finished: True,
        )),
    }
}

impl IntoIterator (RangeInclusive I8) {
    type Iter = RangeInclusive I8
    into_iterator = move iterator => iterator
}

