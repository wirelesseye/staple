pub mod

use std.core.sized.sized_opaque

/// The lexical owner of reactions created within a reactive scope.
@sized_opaque
pub type Reactive = opaque
impl !Copy Reactive {}

/// Creates a resource that owns reactions until its `with` block exits.
pub def reactive_scope: () -> Reactive = () => __reactive_scope ()

extern "staple-intrinsic" {
    __reactive_scope: () -> Reactive

    /// Runs a callback immediately and again whenever one of its signal reads changes.
    pub reaction: <effect E> (() ->{E} ()) ->{Reactive, E} ()

    /// Runs a callback immediately while deferring reactions until the outermost batch exits.
    pub batch: <effect E> (() ->{E} ()) ->{E} ()

    /// Reads an expression eagerly without retaining or recording reactive dependencies.
    pub snapshot: <T> move T -> T
}
