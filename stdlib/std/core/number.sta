// Arithmetic negation. `-x` desugars to `Neg.negate x`; each signed
// implementation is defined in terms of the type's `Subtract` intrinsic, so no
// dedicated negation intrinsic is required. Unsigned integers have no `Neg`
// implementation, mirroring their lack of a signed range.
impl Neg I8 { negate = value => 0 - value }
impl Neg I16 { negate = value => 0 - value }
impl Neg I32 { negate = value => 0 - value }
impl Neg I64 { negate = value => 0 - value }
impl Neg ISize { negate = value => 0 - value }
impl Neg F32 { negate = value => 0.0 - value }
impl Neg F64 { negate = value => 0.0 - value }
