impl Eq I8 {
    eq = (left, right) => __i8_equal (left, right)
    ne = (left, right) => __i8_not_equal (left, right)
}

impl PartialOrd I8 {
    partial_cmp = (left, right) => when {
        __i8_lt (left, right) => Some (Ordering :: Ordering.Less),
        __i8_gt (left, right) => Some (Ordering :: Ordering.Greater),
        else => Some (Ordering :: Ordering.Equal),
    }
}

impl Ord I8 {
    cmp = (left, right) => when {
        __i8_lt (left, right) => Ordering.Less,
        __i8_gt (left, right) => Ordering.Greater,
        else => Ordering.Equal,
    }
}

