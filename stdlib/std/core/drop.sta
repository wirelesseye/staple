pub mod

/// Marks types with custom cleanup behavior.
pub trait Drop T {
    /// Cleans up a value before it is discarded.
    drop: T -> ()
}

extern "staple-intrinsic" {
    __drop: <T> move T -> ()
}

/// Consumes a value and runs its cleanup behavior when applicable.
pub def drop: <T> move T -> () = move value => __drop value
