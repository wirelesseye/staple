pub mod

use package.ops.(Not)
use package.cmp.(derive_eq)
use package.default.Default
use package.convert.(Convert)
use package.string.(String, ToString)

/// The input is not a supported boolean representation.
pub type InvalidBool

use package.fmt.(Display, Debug, Formatter)
use package.fmt.derive_debug

/// The logical true value.
@derive_debug
@derive_eq
pub type True

/// The logical false value.
@derive_debug
@derive_eq
pub type False

/// A logical value that is either true or false.
pub type Bool = True | False

impl Display Bool {
    fmt = (value, mut formatter) => formatter |> write (if value { "True" } else { "False" })
}

impl Not Bool {
    not = value => if value { False } else { True }
}

impl Convert Bool I8 {
    convert = move value => if value { 1 } else { 0 }
}

impl Convert Bool I16 {
    convert = move value => if value { 1 } else { 0 }
}

impl Convert Bool I32 {
    convert = move value => if value { 1 } else { 0 }
}

impl Convert Bool I64 {
    convert = move value => if value { 1 } else { 0 }
}

impl Convert Bool U8 {
    convert = move value => if value { 1 } else { 0 }
}

impl Convert Bool U16 {
    convert = move value => if value { 1 } else { 0 }
}

impl Convert Bool U32 {
    convert = move value => if value { 1 } else { 0 }
}

impl Convert Bool U64 {
    convert = move value => if value { 1 } else { 0 }
}

impl Convert Bool ISize {
    convert = move value => if value { 1 } else { 0 }
}

impl Convert Bool USize {
    convert = move value => if value { 1 } else { 0 }
}

impl Convert Bool String { convert = move value => ToString.to_string value }

impl Default Bool { default = () => False }
