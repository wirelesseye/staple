pub mod

use package.alloc.Gc
use package.buffer.(Buffer, BufferHeader)
use package.cmp.(Eq)
use package.index.(Index, MutateIndex)
use package.iterator.(IntoIterator, Iterator)
use package.iterator.IterStep.(Done, Yield)
use package.process.(panic)
use package.ptr.(RawMutPtr)
use package.shared.(Shared)

extern "staple-intrinsic" {
    __shared_buffer_get_shared: <T> (SharedBuffer<T>, USize) -> Shared<T>
}

/// A garbage-collected, fixed-length sequence whose handles share one mutable
/// allocation. The buffer owns its elements.
pub type SharedBuffer<T> wrap RawMutPtr<BufferHeader<T>>

companion<T> SharedBuffer<T> {
    /// Adopts a live buffer allocation. The caller must transfer ownership
    /// exactly once.
    pub(package) def unsafe_from_raw = pointer: RawMutPtr<BufferHeader<T>> => SharedBuffer<T> ::
        SharedBuffer pointer

    /// Moves the elements of a fixed array into a new shared buffer.
    pub def from_array = <N where Natural N> move value: (T ^ N) => SharedBuffer<T> ::
        Buffer.into_shared_buffer (Buffer.from_array value)

    /// Returns the number of elements in the buffer.
    pub def length = value: SharedBuffer<T> => USize :: {
        let header = value.*
        BufferHeader.length header
    }

    /// Returns an owned shared handle to an element, or `None` if out of bounds.
    /// The handle keeps the buffer allocation alive and observes replacements
    /// of the element; it does not take ownership of the element itself.
    pub def get_shared = (buffer: SharedBuffer<T>; position: USize) => Option<Shared<T>> :: {
        if (position < SharedBuffer.length buffer) {
            Some (SharedBuffer.get_shared_unchecked buffer position)
        } else {
            None
        }
    }

    /// Returns an owned shared handle to an element, trapping if out of bounds.
    /// The handle keeps the buffer allocation alive and observes replacements
    /// of the element; it does not take ownership of the element itself.
    pub def get_shared_unchecked = (buffer: SharedBuffer<T>; position: USize) =>
        Shared<T> :: __shared_buffer_get_shared (buffer, position)

    /// Replaces the element at a position and returns the old value; `None` if out of bounds.
    pub def set = (mut buffer: SharedBuffer<T>; position: USize; move value: T) => Option<T> :: {
        if (position < SharedBuffer.length buffer) {
            Some (SharedBuffer.set_unchecked buffer position value)
        } else {
            None
        }
    }

    /// Replaces the element at a position and returns the old value, trapping if out of bounds.
    pub def set_unchecked = (mut buffer: SharedBuffer<T>; position: USize; move value: T) => T :: {
        if (position >= SharedBuffer.length buffer) {
            panic "SharedBuffer.set_unchecked: index out of bounds"
        }
        let header = buffer.*
        let element = BufferHeader.element header position
        let previous = RawMutPtr.unsafe_read element
        RawMutPtr.store element value
        previous
    }
}

companion<T where Copy T> SharedBuffer<T> {
    /// Copies the element at a position, or `None` if out of bounds.
    pub def get = (buffer: SharedBuffer<T>; position: USize) => Option<T> :: {
        if (position < SharedBuffer.length buffer) {
            Some (SharedBuffer.get_unchecked buffer position)
        } else {
            None
        }
    }

    /// Copies the element at a position, trapping if out of bounds.
    pub def get_unchecked = (buffer: SharedBuffer<T>; position: USize) => T :: {
        if (position >= SharedBuffer.length buffer) {
            panic "SharedBuffer.get_unchecked: index out of bounds"
        }
        let header = buffer.*
        RawMutPtr.unsafe_read (BufferHeader.element header position)
    }
}

impl<T where Copy T> Index SharedBuffer<T> USize {
    type Output = T
    index = (values, position) => SharedBuffer.get_unchecked values position
}

impl<T> MutateIndex SharedBuffer<T> USize {
    type Value = T
    mutate_index = (mut values, position, move value) => {
        let _ = SharedBuffer.set_unchecked values position value
        ()
    }
}

pub type SharedBufferIter<T> wrap pub (buffer: SharedBuffer<T>, index: USize)

impl<T where Copy T> Iterator SharedBufferIter<T> {
    type Item = T
    next = move SharedBufferIter (buffer, index) => if (index < SharedBuffer.length buffer) {
        let value = SharedBuffer.get_unchecked buffer index
        Yield (value, SharedBufferIter (buffer: buffer, index: index + 1))
    } else {
        Done (SharedBufferIter (buffer: buffer, index: index))
    }
}

impl<T where Copy T> IntoIterator SharedBuffer<T> {
    type Iter = SharedBufferIter<T>
    into_iterator = move buffer => SharedBufferIter (buffer: buffer, index: 0)
}

impl<T where Eq T> Eq SharedBuffer<T> {
    eq = (left; right) => {
        let length = SharedBuffer.length left
        if (length == SharedBuffer.length right) {
            let mut index: USize = 0
            let mut equal: Bool = True
            while (index < length) {
                if (Eq.eq (SharedBuffer.get_shared_unchecked left index; SharedBuffer.get_shared_unchecked right index)) {
                    index = index + 1
                } else {
                    equal = False
                    break
                }
            }
            equal
        } else {
            False
        }
    }
}
