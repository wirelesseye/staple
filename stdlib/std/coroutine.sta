pub mod

use std.process.panic
use std.core.reactive.Reactive

/// A lazily-constructed, suspendable computation.
///
/// `coro { ... }` produces a `Coroutine`. Awaiting one runs it as a child
/// continuation of the current task, yields its result `T`, and contributes
/// its deferred effect row `E` to the awaiting coroutine body. A `Coroutine`
/// is affine: constructing one moves its owned captures, and dropping it
/// without awaiting destroys those captures without running the body.
pub type Coroutine{E} T = opaque

/// A scope-owned handle to a spawned coroutine's eventual result. Affine:
/// `await` consumes the handle. Dropping a handle does not cancel its task.
pub type Task T = opaque

/// The result of `await`-ing a `Task` that ran to completion; wraps the value
/// the task produced.
pub(repr) type Completed T = T

/// The result of `await`-ing a `Task` whose execution was cancelled before it
/// produced a value.
pub(repr) type Cancelled = ()

/// Runs a coroutine to completion on the current thread and yields its result,
/// incorporating its deferred effects.
///
/// This is a provisional driver for the coroutine language surface: it accepts
/// only coroutines that complete without a real suspension point (nested
/// `await` of other coroutines is fine). Task scheduling, `spawn`, and bounded
/// pumping arrive with the scheduler, which replaces this function.
///
/// The body is never evaluated — the compiler lowers a `block_on` call
/// directly — but a generic `def` still requires one.
pub def block_on: <T, effect E> Coroutine{E} T ->{E} T =
    _ => panic "block_on is a compiler intrinsic"

/// An explicitly driven owner of coroutine ready queues. No coroutine runs
/// until a `pump`. Multiple schedulers coexist on the one runtime thread.
pub type Scheduler = opaque

/// An affine scope, bound to a scheduler, under which coroutines are spawned.
/// Used as the provider of the implicit `Tasks` capability:
/// `with Tasks = task_scope (sched) { ... }`.
pub type Tasks = opaque

// Every function below is lowered directly by the compiler; the bodies exist
// only to satisfy "a declared binding needs an initializer".

/// Creates a scheduler. Destroying it closes its scopes and cancels their
/// tasks.
pub def scheduler: () -> Scheduler = () => panic "scheduler is a compiler intrinsic"

/// Creates a `Tasks` scope bound to `sched`.
pub def task_scope: Scheduler -> Tasks = _ => panic "task_scope is a compiler intrinsic"

/// Consumes a coroutine, schedules it under the current `Tasks` scope, and
/// returns a handle to its eventual result. Requires the coroutine's own
/// effects `E` at the spawn site so its resources are captured now.
pub def spawn: <T, effect E> Coroutine{E} T ->{Tasks, E} Task T =
    _ => panic "spawn is a compiler intrinsic"

/// Runs a bounded snapshot of the scheduler's ready coroutines. Tasks that
/// suspend, or are spawned during the pump, become eligible for a later pump.
/// Returns the number of resumes performed and the number still ready.
pub def pump: (Scheduler, USize) -> (executed: USize, ready: USize) =
    _ => panic "pump is a compiler intrinsic"

/// A coroutine that suspends the awaiting task once, deferring the rest of its
/// body to a later `pump`.
pub def yield_now: () -> Coroutine{Tasks} () =
    () => panic "yield_now is a compiler intrinsic"

companion Task {
    /// Reports whether the task has finished (completed or cancelled), without
    /// consuming its result.
    pub def is_finished: <T> Task T -> Bool =
        _ => panic "Task.is_finished is a compiler intrinsic"

    /// Requests cancellation of the task. Idempotent, and a no-op once the task
    /// has finished. A running task unwinds at its next `await` / `yield_now` /
    /// return boundary rather than delivering a value to its body; a not-yet
    /// started task never runs its body. Borrows the handle.
    pub def cancel: <T> Task T -> () =
        _ => panic "Task.cancel is a compiler intrinsic"
}

/// A one-shot wait that a task `await`s and anything can resolve. Affine:
/// `await` consumes it; dropping one unconsumed abandons the operation.
pub type Wait T = opaque

/// The write end of a `completion`. Affine and single-use: `complete` or
/// `cancel` consumes it, and dropping an unused resolver cancels the wait.
pub type Resolver T = opaque

/// Creates a one-shot completion bound to `scheduler`: a `Wait T` to `await`
/// and a `Resolver T` to fulfil it. The wait may only be `await`ed from a task
/// on the same scheduler. Completing before the `await` registers still
/// delivers the value.
pub def completion: <T> Scheduler -> (wait: Wait T, resolver: Resolver T) =
    _ => panic "completion is a compiler intrinsic"

/// Like `completion`, but with an owned cancellation callback. `on_cancel` runs
/// exactly once if the consumer abandons the wait before it resolves — the
/// `Wait` is dropped unconsumed, or a task parked on it is cancelled. A
/// successful `complete` or `cancel` releases the callback without running it.
/// Libraries use it to unregister a timer or external subscription. The
/// callback may not suspend.
pub def completion_with_cancel: <T> (Scheduler, () -> ()) -> (wait: Wait T, resolver: Resolver T) =
    _ => panic "completion_with_cancel is a compiler intrinsic"

/// An opaque, C-compatible one-shot wakeup handle for a unit-valued completion.
/// A host holds it across the FFI boundary and calls one of the C entry points
/// `__staple_completion_token_resolve` / `_cancel` / `_release` on it; dropping
/// the token from Staple releases it (cancelling an unresolved completion).
pub type CompletionToken = opaque

/// Creates a unit-valued completion bound to `scheduler` and returns the `Wait`
/// to `await` plus an opaque `CompletionToken` for a host to resolve.
pub def completion_token: Scheduler -> (wait: Wait (), token: CompletionToken) =
    _ => panic "completion_token is a compiler intrinsic"

companion CompletionToken {
    /// Resolves the completion with `()`, waking a parked waiter. Consumes the
    /// token. The C entry point is `__staple_completion_token_resolve`.
    pub def resolve: CompletionToken -> () =
        _ => panic "CompletionToken.resolve is a compiler intrinsic"

    /// Cancels the completion, waking a parked waiter with `Cancelled`.
    /// Consumes the token. The C entry point is `__staple_completion_token_cancel`.
    pub def cancel: CompletionToken -> () =
        _ => panic "CompletionToken.cancel is a compiler intrinsic"
}

/// Suspends the current task until `predicate` first observes `True`. The
/// predicate may only read signals (no writes, effects, or suspension); it is
/// evaluated synchronously once when the coroutine runs, then again on each
/// change to a signal it read, refreshing its dependencies. The first `True`
/// latches, unsubscribes, and resumes the task. Cancelling the task while it is
/// parked here tears the subscription down.
pub def until: (() ->{state.read} Bool) -> Coroutine{Reactive} () =
    _ => panic "until is a compiler intrinsic"

companion Resolver {
    /// Consumes the resolver and the value, records completion, and wakes a
    /// registered waiter. If the waiter has already gone the value is dropped.
    pub def complete: <T> Resolver T * T -> () =
        _ * _ => panic "Resolver.complete is a compiler intrinsic"

    /// Consumes the resolver and cancels the operation: a registered waiter is
    /// woken with `Cancelled`.
    pub def cancel: <T> Resolver T -> () =
        _ => panic "Resolver.cancel is a compiler intrinsic"
}
