@track_caller
def sample_i64 = (mut rng: Rng; start: I64; end: I64; inclusive: Bool) => I64 :: {
    let start_bits = I64.cast_unsigned start
    let end_bits = I64.cast_unsigned end
    let count = if (inclusive) {
        if (end < start) { panic "between: empty range" }
        (end_bits - start_bits) + 1
    } else {
        if (end <= start) { panic "between: empty range" }
