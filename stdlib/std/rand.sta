// ---------------------------------------------------------------------------
// Random implementations
// ---------------------------------------------------------------------------

impl Random U8 {
    random = mut rng => U8 :: narrow_u8 (Rng.next_u64 rng)
}

impl Random U16 {
    random = mut rng => U16 :: narrow_u16 (Rng.next_u64 rng)
}

impl Random U32 {
    random = mut rng => U32 :: narrow_u32 (Rng.next_u64 rng)
}

impl Random U64 {
    random = mut rng => U64 :: Rng.next_u64 rng
}

impl Random USize {
    random = mut rng => USize :: narrow_usize (Rng.next_u64 rng)
}

impl Random I8 {
    random = mut rng => I8 :: narrow_i8 (Rng.next_u64 rng)
}

impl Random I16 {
    random = mut rng => I16 :: narrow_i16 (Rng.next_u64 rng)
}

impl Random I32 {
    random = mut rng => I32 :: narrow_i32 (Rng.next_u64 rng)
}

impl Random I64 {
    random = mut rng => I64 :: narrow_i64 (Rng.next_u64 rng)
}

impl Random ISize {
    random = mut rng => ISize :: narrow_isize (Rng.next_u64 rng)
}

impl Random Bool {
    random = mut rng => Bool :: if (Rng.next_u64 rng % 2 == 1) { True } else { False }
}

impl Random F32 {
    random = mut rng => F32 :: unit_f32 rng
}

impl Random F64 {
    random = mut rng => F64 :: unit_f64 rng
}

impl Random () {
    random = mut rng => () :: ()
}

impl<A, B where Random A, Random B> Random (A, B) {
    random = mut rng => (A, B) :: {
        let first: A = Random.random rng
        let second: B = Random.random rng
        (first, second)
    }
}

impl<A, B, C where Random A, Random B, Random C> Random (A, B, C) {
    random = mut rng => (A, B, C) :: {
        let first: A = Random.random rng
        let second: B = Random.random rng
        let third: C = Random.random rng
        (first, second, third)
    }
}

impl<A, B, C, D where Random A, Random B, Random C, Random D> Random (A, B, C, D) {
    random = mut rng => (A, B, C, D) :: {
        let first: A = Random.random rng
        let second: B = Random.random rng
        let third: C = Random.random rng
        let fourth: D = Random.random rng
        (first, second, third, fourth)
    }
}

// ---------------------------------------------------------------------------
// OS entropy
// ---------------------------------------------------------------------------

/// Fills `buffer` with operating-system randomness, suitable for keys. The
/// length is unchanged.
pub def fill_entropy = mut buffer: List<U8> =>{IO} Result<(), EntropyError> :: {
    let length = List.length buffer
    if (length == 0) {
        return Ok ()
    }
    let data = List.unsafe_data buffer
    let mut offset: USize = 0
    while (offset < length) {
        let remaining = length - offset
        let chunk: USize = if (remaining < 256) { remaining } else { 256 }
        let pointer = RawMutPtr.add data offset
        if (getentropy (pointer as RawOpaqueMutPtr, chunk) != 0) {
            return EntropyError (code: __staple_fs_errno ())
        }
        offset = offset + chunk
    }
    Ok ()
}

def read_u64_le = (bytes: List<U8>; offset: USize) => U64 :: {
    let mut result: U64 = 0
    let mut index: USize = 0
    while (index < 8) {
        let byte = List.get_unchecked bytes (offset + index)
        let shift: U32 = usize_to_u32 (index * 8)
        result = result + U64.wrapping_shift_left (byte as U64) shift
        index = index + 1
    }
    result
}

// ---------------------------------------------------------------------------
// Distributions
// ---------------------------------------------------------------------------

/// A precomputed uniform range. Construct with `Uniform.new`.
pub type Uniform<T> wrap (start: T, end: T, inclusive: Bool)

companion<T> Uniform<T> {
    /// Precomputes the sampling rule for a range.
    pub def new = <R where SampleRange R> range: R => Uniform<SampleRange.Item R> :: {
        let (start, end, inclusive) = SampleRange.bounds range
        Uniform.<SampleRange.Item R> (start: start, end: end, inclusive: inclusive)
    }
}

trait UniformSample T {
    sample_uniform: (T, T, Bool, mut Rng) -> T
}

impl UniformSample U8 {
    sample_uniform = (start, end, inclusive, mut rng) => U8 ::
        sample_u8 rng start end inclusive
}

impl UniformSample U16 {
    sample_uniform = (start, end, inclusive, mut rng) => U16 ::
        sample_u16 rng start end inclusive
}

impl UniformSample U32 {
    sample_uniform = (start, end, inclusive, mut rng) => U32 ::
        sample_u32 rng start end inclusive
}

impl UniformSample U64 {
    sample_uniform = (start, end, inclusive, mut rng) => U64 ::
        sample_u64 rng start end inclusive
}

impl UniformSample USize {
    sample_uniform = (start, end, inclusive, mut rng) => USize ::
        sample_usize rng start end inclusive
}

impl UniformSample I8 {
    sample_uniform = (start, end, inclusive, mut rng) => I8 ::
        sample_i8 rng start end inclusive
}

impl UniformSample I16 {
    sample_uniform = (start, end, inclusive, mut rng) => I16 ::
        sample_i16 rng start end inclusive
}

impl UniformSample I32 {
    sample_uniform = (start, end, inclusive, mut rng) => I32 ::
        sample_i32 rng start end inclusive
}

impl UniformSample I64 {
    sample_uniform = (start, end, inclusive, mut rng) => I64 ::
        sample_i64 rng start end inclusive
}

impl UniformSample ISize {
    sample_uniform = (start, end, inclusive, mut rng) => ISize ::
        sample_isize rng start end inclusive
}

impl UniformSample F32 {
    sample_uniform = (start, end, _, mut rng) => F32 ::
        sample_f32_range rng start end
}

impl UniformSample F64 {
    sample_uniform = (start, end, _, mut rng) => F64 ::
        sample_f64_range rng start end
}

impl<T where UniformSample T, Copy T> Distribution Uniform<T> {
    type Output = T
    sample = (uniform, mut rng) => T ::
        UniformSample.sample_uniform (uniform.*.start, uniform.*.end, uniform.*.inclusive, rng)
}

/// A coin flip whose probability is stored as an exact 64-bit threshold.
pub type Bernoulli wrap (threshold: U64)

companion Bernoulli {
    /// Creates a distribution that returns true with probability `p`.
    pub def new = probability: F64 => Bernoulli ::
        Bernoulli (threshold: probability_threshold probability)

    /// Always returns true.
    pub def always = () => Bernoulli :: Bernoulli (threshold: U64.Max)

    /// Always returns false.
    pub def never = () => Bernoulli :: Bernoulli (threshold: 0)
}

impl Distribution Bernoulli {
    type Output = Bool
    sample = (bernoulli, mut rng) => Bool :: {
        let threshold = bernoulli.*
        if (threshold == U64.Max) {
            True
        } else {
            Rng.next_u64 rng < threshold
        }
    }
}

/// A cumulative weight table. Construct with `WeightedIndex.new`.
pub type WeightedIndex wrap (cumulative: List<F64>)

companion WeightedIndex {
    /// Builds a cumulative table. At least one weight must be positive and all
    /// weights must be finite and non-negative.
    pub def new = weights: List<F64> => Result<WeightedIndex, DistributionError> :: {
        let length = List.length weights
        let mut cumulative: List<F64> = List.with_capacity length
        let mut total = 0.0
        let mut index: USize = 0
        while (index < length) {
            let weight = List.get_unchecked weights index
            if (!(weight >= 0.0) || F64.is_infinite weight) {
                return DistributionError.InvalidParameter
            }
            total = total + weight
            List.push cumulative total
            index = index + 1
        }
        if (!(total > 0.0)) {
            return DistributionError.NoPositiveWeight
        }
        Ok (WeightedIndex (cumulative: cumulative))
    }
}

impl Distribution WeightedIndex {
    type Output = USize
    sample = (weighted, mut rng) => USize :: {
        let length = List.length weighted.*
        let total = List.get_unchecked weighted.* (length - 1)
        let target = unit_f64 rng * total
        let mut index: USize = 0
        while (index < length) {
            if (target < List.get_unchecked weighted.* index) {
                return index
            }
            index = index + 1
        }
        length - 1
    }
}

/// A normal (Gaussian) distribution.
pub type Normal wrap pub (mean: F64, std_dev: F64)

companion Normal {
    /// Creates a normal distribution with a non-negative finite standard
    /// deviation.
    pub def new = (mean: F64; std_dev: F64) => Result<Normal, DistributionError> :: {
        if (!(std_dev >= 0.0) || F64.is_infinite std_dev) {
            return DistributionError.InvalidParameter
        }
        Ok (Normal (mean: mean, std_dev: std_dev))
    }
}

impl Distribution Normal {
    type Output = F64
    sample = (normal, mut rng) => F64 :: {
        let mean = normal.*.mean
        let std_dev = normal.*.std_dev
        if (std_dev == 0.0) {
            return mean
        }
        // Marsaglia's polar form of the Box-Muller transform.
        let mut u = 0.0
        let mut v = 0.0
        let mut radius = 2.0
        while (radius >= 1.0 || radius == 0.0) {
            u = unit_f64 rng * 2.0 - 1.0
            v = unit_f64 rng * 2.0 - 1.0
            radius = u * u + v * v
        }
        mean + std_dev * u * F64.sqrt ((-2.0 * F64.ln radius) / radius)
    }
}

/// An exponential distribution parameterized by its rate.
pub type Exponential wrap pub (rate: F64)

companion Exponential {
    /// Creates an exponential distribution with a positive finite rate.
    pub def new = rate: F64 => Result<Exponential, DistributionError> :: {
        if (!(rate > 0.0) || F64.is_infinite rate) {
            return DistributionError.InvalidParameter
        }
        Ok (Exponential (rate: rate))
    }
}

impl Distribution Exponential {
    type Output = F64
    sample = (exponential, mut rng) => F64 :: {
        let rate = exponential.*
        if (!(rate > 0.0)) {
            return 0.0
        }
        let unit = unit_f64 rng
        (0.0 - F64.ln (1.0 - unit)) / rate
    }
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

// The number of 64-bit outcomes below `p`, or `U64.Max` to mean "always".
def probability_threshold = p: F64 => U64 :: {
    if (!(p > 0.0)) {
        return 0
    }
    if (p >= 1.0) {
        return U64.Max
    }
    let bits = F64.to_bits p
    let exponent_bits = (U64.wrapping_shift_right bits 52) % 2048
    if (exponent_bits == 0) {
        // Subnormal values are far below 2^-64.
        return 0
    }
    let exponent = U64.cast_signed exponent_bits - 1023
    let mantissa = bits % 4503599627370496 + 4503599627370496
    let shift = exponent + 12
    if (shift >= 0) {
        U64.wrapping_shift_left mantissa (i64_to_u32 shift)
    } else {
        let right = 0 - shift
        if (right >= 64) {
            0
        } else {
            U64.wrapping_shift_right mantissa (i64_to_u32 right)
        }
    }
}

def i64_to_u32 = value: I64 => U32 :: match (TryConvert.try_convert.<I64, U32> value) {
    Ok result => result,
    _ => 0,
}

def jump_bits = (mut rng: Rng; word: U64; s0: U64; s1: U64; s2: U64; s3: U64) =>
    (U64, U64, U64, U64) :: {
    let mut a0 = s0
    let mut a1 = s1
    let mut a2 = s2
    let mut a3 = s3
    let mut bit: U32 = 0
    while (bit < 64) {
        let mask = U64.wrapping_shift_left 1 bit
        if (BitAnd.bit_and (word; mask) != 0) {
            a0 = BitXor.bit_xor (a0; rng.*.s0)
            a1 = BitXor.bit_xor (a1; rng.*.s1)
            a2 = BitXor.bit_xor (a2; rng.*.s2)
            a3 = BitXor.bit_xor (a3; rng.*.s3)
        }
        let _ = Rng.next_u64 rng
        bit = bit + 1
    }
    (a0, a1, a2, a3)
}

// ---------------------------------------------------------------------------
// Ambient wrappers
// ---------------------------------------------------------------------------

pub def next_u32 = () =>{mut rng: Rng} U32 :: Rng.next_u32 rng
pub def next_u64 = () =>{mut rng: Rng} U64 :: Rng.next_u64 rng
pub def fill_bytes = mut buffer: List<U8> =>{mut rng: Rng} () :: Rng.fill_bytes rng buffer
pub def random = <T where Random T> () =>{mut rng: Rng} T :: Random.random rng

@track_caller
pub def between = <R where SampleRange R> range: R =>{mut rng: Rng} SampleRange.Item R ::
    Rng.between rng range

pub def chance = probability: F64 =>{mut rng: Rng} Bool :: Rng.chance rng probability
pub def shuffle = <T> mut list: List<T> =>{mut rng: Rng} () :: Rng.shuffle rng list
pub def choose = <T where Copy T> list: List<T> =>{mut rng: Rng} Option<T> :: Rng.choose rng list

pub def choose_multiple = <T where Clone T> (list: List<T>; count: USize) =>{mut rng: Rng}
    List<T> :: Rng.choose_multiple rng list count

pub def sample = <D where Distribution D> distribution: D =>{mut rng: Rng} Distribution.Output D ::
    Distribution.sample (distribution, rng)

pub def sample_n = <D where Distribution D> (distribution: D; count: USize) =>{mut rng: Rng}
    List<Distribution.Output D> :: Rng.sample_n rng distribution count
