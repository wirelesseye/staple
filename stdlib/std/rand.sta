}

@track_caller
def sample_u64 = (mut rng: Rng; start: U64; end: U64; inclusive: Bool) => U64 :: {
    let count = if (inclusive) {
        if (end < start) { panic "between: empty range" }
        (end - start) + 1
    } else {
        if (end <= start) { panic "between: empty range" }
        end - start
    }
    start + sample_bounded rng count
}

@track_caller
def sample_usize = (mut rng: Rng; start: USize; end: USize; inclusive: Bool) => USize :: {
    let start_bits = start as U64
