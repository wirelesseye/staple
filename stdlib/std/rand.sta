    type Item = USize
    can_sample = range => !range.*.finished && range.*.current <= range.*.end
    sample_range = (range, mut rng) => USize :: {
        if (range.*.finished) { panic "between: empty range" }
        narrow_usize (sample_bits rng (range.*.current as U64) (range.*.end as U64) True)
