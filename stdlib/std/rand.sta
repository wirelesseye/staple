}

@track_caller
def sample_i8 = (mut rng: Rng; start: I8; end: I8; inclusive: Bool) => I8 :: {
    let start_bits = I64.cast_unsigned (start as I64)
    let end_bits = I64.cast_unsigned (end as I64)
    let count = if (inclusive) {
        if (end < start) { panic "between: empty range" }
