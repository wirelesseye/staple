/// Random numbers, distributions and shuffling. Not for cryptography.
pub mod

use package.list.List
use package.clone.Clone
use package.convert.TryConvert
use package.io.IO
use package.option.(Option, Some, None)
use package.ops.(BitAnd, BitXor)
use package.process.(panic, trap)
use package.ptr.(RawMutPtr, RawOpaqueMutPtr)
use package.range.(Range, RangeInclusive)
use package.result.(Result, Ok)
use package.source.track_caller
use package.typegroup.typegroup

extern "c" {
    getentropy: (RawOpaqueMutPtr, USize) -> I32
    __staple_fs_errno: () -> I32
}

/// A seedable pseudo-random generator (xoshiro256**).
/// Not cryptographically secure.
pub type Rng wrap (s0: U64, s1: U64, s2: U64, s3: U64)

impl !Copy Rng {}

impl Clone Rng {
    clone = rng => Rng (s0: rng.*.s0, s1: rng.*.s1, s2: rng.*.s2, s3: rng.*.s3)
}

/// The operating system could not supply randomness.
pub type EntropyError wrap pub (code: I32)

/// A type with a canonical uniform distribution.
pub trait Random T {
    random: mut Rng -> T
}

/// A range that can be sampled without bias.
pub trait SampleRange R {
    type Item
    @track_caller
    sample_range: (R, mut Rng) -> Item
    bounds: R -> (start: Item, end: Item, inclusive: Bool) =
        _ => panic "Uniform.new: range does not expose bounds"
}

/// Something that produces values of `Output` from a generator.
pub trait Distribution D {
    type Output
    sample: (D, mut Rng) -> Output
}

/// The reason a distribution could not be constructed.
pub typegroup DistributionError {
    InvalidParameter,
    NoPositiveWeight,
}

// ---------------------------------------------------------------------------
// xoshiro256** and SplitMix64
// ---------------------------------------------------------------------------

def splitmix_next = state: U64 => (U64, U64) :: {
    let next = state + 11400714819323198485
    let mut z = next
    z = BitXor.bit_xor (z; U64.wrapping_shift_right z 30)
    z = z * 13787848793156543929
    z = BitXor.bit_xor (z; U64.wrapping_shift_right z 27)
    z = z * 10723151780598845931
    (next, BitXor.bit_xor (z; U64.wrapping_shift_right z 31))
}

companion Rng {
    use package.source.track_caller

    /// Seeds from a single integer through SplitMix64. Same seed, same stream.
    pub def seeded = seed: U64 => Rng :: {
        let (state, s0) = splitmix_next seed
        let (state, s1) = splitmix_next state
        let (state, s2) = splitmix_next state
        let (state, s3) = splitmix_next state
        Rng (s0: s0, s1: s1, s2: s2, s3: s3)
    }

    /// Seeds from 32 bytes. An all-zero state is replaced, never kept.
    pub def from_seed = seed: (U64, U64, U64, U64) => Rng :: {
        let (s0, s1, s2, s3) = seed
        if (s0 == 0 && s1 == 0 && s2 == 0 && s3 == 0) {
            seeded 1
        } else {
            Rng (s0: s0, s1: s1, s2: s2, s3: s3)
        }
    }

    /// Seeds from the operating system.
    pub def from_entropy = () =>{IO} Result<Rng, EntropyError> :: {
        let mut bytes: List<U8> = List.of (0u8 ^ 32)
        fill_entropy bytes ?
        Ok (from_seed (
            read_u64_le bytes 0,
            read_u64_le bytes 8,
            read_u64_le bytes 16,
            read_u64_le bytes 24,
        ))
    }

    /// Returns the next 64 bits.
    pub def next_u64 = mut rng: Rng => U64 :: {
        let mut s0 = rng.*.s0
        let mut s1 = rng.*.s1
        let mut s2 = rng.*.s2
        let mut s3 = rng.*.s3
        let result = U64.wrapping_multiply (U64.rotate_left (U64.wrapping_multiply s1 5) 7) 9
        let t = U64.wrapping_shift_left s1 17
        s2 = BitXor.bit_xor (s2; s0)
        s3 = BitXor.bit_xor (s3; s1)
        s1 = BitXor.bit_xor (s1; s2)
        s0 = BitXor.bit_xor (s0; s3)
        s2 = BitXor.bit_xor (s2; t)
        s3 = U64.rotate_left s3 45
        rng.*.s0 = s0
        rng.*.s1 = s1
        rng.*.s2 = s2
        rng.*.s3 = s3
        result
    }

    /// Returns the next 32 bits, taken from the high half of one draw.
    pub def next_u32 = mut rng: Rng => U32 :: narrow_u32 (U64.wrapping_shift_right (next_u64 rng) 32)

    /// Fills every byte of `buffer` with generator output. The length is
    /// unchanged.
    pub def fill_bytes = (mut rng: Rng; mut buffer: List<U8>) => () :: {
        let length = List.length buffer
        let data = List.unsafe_data buffer
        let mut index: USize = 0
        while (index < length) {
            let word = next_u64 rng
            let remaining = length - index
            let chunk: USize = if (remaining < 8) { remaining } else { 8 }
            let mut byte_index: USize = 0
            while (byte_index < chunk) {
                let shift: U32 = usize_to_u32 (byte_index * 8)
                let byte = narrow_u8 (U64.wrapping_shift_right word shift)
                RawMutPtr.store (RawMutPtr.add data (index + byte_index)) byte
                byte_index = byte_index + 1
            }
            index = index + chunk
        }
    }

    /// Advances by 2^128 steps (the published xoshiro256** jump).
    pub def jump = mut rng: Rng => () :: {
        let (s0, s1, s2, s3) = jump_bits rng 1733541517147835066 0 0 0 0
        let (s0, s1, s2, s3) = jump_bits rng 15395012609548302636 s0 s1 s2 s3
        let (s0, s1, s2, s3) = jump_bits rng 12202545078643706282 s0 s1 s2 s3
        let (s0, s1, s2, s3) = jump_bits rng 4155657270789760540 s0 s1 s2 s3
        rng.*.s0 = s0
        rng.*.s1 = s1
        rng.*.s2 = s2
        rng.*.s3 = s3
    }

    /// Returns a clone and then jumps the original, giving each caller an
    /// independent stream.
    pub def fork = mut rng: Rng => Rng :: {
        let child = Rng (s0: rng.*.s0, s1: rng.*.s1, s2: rng.*.s2, s3: rng.*.s3)
        jump rng
        child
    }

    /// Samples a uniformly distributed value of a type.
    pub def random = <T where Random T> mut rng: Rng => T :: Random.random rng

    /// Samples a value from a range without modulo bias. Panics at the caller
    /// when the range is empty.
    @track_caller
    pub def between = <R where SampleRange R> (mut rng: Rng; range: R) =>
        SampleRange.Item R :: SampleRange.sample_range (range, rng)

    /// Returns true with the given probability. Values outside `[0, 1]` are
    /// clamped; NaN is treated as zero.
    pub def chance = (mut rng: Rng; probability: F64) => Bool :: {
        let threshold = probability_threshold probability
        if (threshold == U64.Max) {
            True
        } else {
            next_u64 rng < threshold
        }
    }

    /// Shuffles a list in place with Fisher-Yates.
    pub def shuffle = <T> (mut rng: Rng; mut list: List<T>) => () :: {
        let mut index = List.length list
        while (index > 1) {
            index = index - 1
            let other = Rng.between rng ((0usize)..=index)
            List.swap list index other
        }
    }

    /// Copies one uniformly chosen element, or `None` for an empty list.
    pub def choose = <T where Copy T> (mut rng: Rng; list: List<T>) => Option<T> :: {
        let length = List.length list
        if (length == 0) {
            None
        } else {
            let index = Rng.between rng ((0usize)..length)
            Some (List.get_unchecked list index)
        }
    }

    /// Copies up to `count` distinct elements in selection order.
    pub def choose_multiple = <T where Clone T> (mut rng: Rng; list: List<T>; count: USize) =>
        List<T> :: {
        let length = List.length list
        let wanted: USize = if (count < length) { count } else { length }
        let mut pool = Clone.clone list
        let mut result: List<T> = List.with_capacity wanted
        let mut remaining = length
        while (List.length result < wanted) {
            let index = Rng.between rng ((0usize)..remaining)
            List.swap pool index (remaining - 1)
            let item = match (List.pop pool) {
                Some value => value,
                None => trap (),
            }
            List.push result item
            remaining = remaining - 1
        }
        result
    }

    /// Samples `count` independent values from a distribution.
    pub def sample_n = <D where Distribution D>
        (mut rng: Rng; distribution: D; count: USize) =>
        List<Distribution.Output D> :: {
        let mut result: List<Distribution.Output D> = List.with_capacity count
        let mut index: USize = 0
        while (index < count) {
            List.push result (Distribution.sample (distribution, rng))
            index = index + 1
        }
        result
    }
}

// ---------------------------------------------------------------------------
// Unsigned sampling helpers
// ---------------------------------------------------------------------------

def narrow_u8 = value: U64 => U8 :: match (TryConvert.try_convert.<U64, U8> (value % 256)) {
    Ok result => result,
    _ => 0,
}

def narrow_u16 = value: U64 => U16 :: match (TryConvert.try_convert.<U64, U16> (value % 65536)) {
    Ok result => result,
    _ => 0,
}

def narrow_u32 = value: U64 => U32 :: match (TryConvert.try_convert.<U64, U32> (value % 4294967296)) {
    Ok result => result,
    _ => 0,
}

def narrow_usize = value: U64 => USize :: match (TryConvert.try_convert.<U64, USize> value) {
    Ok result => result,
    _ => 0,
}

def usize_to_u32 = value: USize => U32 :: match (TryConvert.try_convert.<USize, U32> value) {
    Ok result => result,
    _ => 0,
}

def narrow_i8 = value: U64 => I8 :: U8.cast_signed (narrow_u8 value)
def narrow_i16 = value: U64 => I16 :: U16.cast_signed (narrow_u16 value)
def narrow_i32 = value: U64 => I32 :: U32.cast_signed (narrow_u32 value)
def narrow_i64 = value: U64 => I64 :: U64.cast_signed value
def narrow_isize = value: U64 => ISize :: USize.cast_signed (narrow_usize value)

def u64_to_f64 = value: U64 => F64 :: match (TryConvert.try_convert.<U64, F64> value) {
    Ok result => result,
    _ => 0.0,
}

def u32_to_f32 = value: U32 => F32 :: match (TryConvert.try_convert.<U32, F32> value) {
    Ok result => result,
    _ => 0.0,
}

def unit_f64 = mut rng: Rng => F64 :: {
    let value = U64.wrapping_shift_right (Rng.next_u64 rng) 11
    u64_to_f64 value * 1.1102230246251565e-16
}

def unit_f32 = mut rng: Rng => F32 :: {
    let value = narrow_u32 (U64.wrapping_shift_right (Rng.next_u64 rng) 40)
    u32_to_f32 value * 5.960464477539063e-8
}

// Lemire's nearly-divisionless bounded sampler. `span == 0` means the full
// 2^64 range.
@track_caller
def sample_bounded = (mut rng: Rng; span: U64) => U64 :: {
    if (span == 0) {
        return Rng.next_u64 rng
    }
    let mut x = Rng.next_u64 rng
    let (mut low, mut high) = U64.widening_multiply x span
    if (low < span) {
        let threshold = (0 - span) % span
        while (low < threshold) {
            x = Rng.next_u64 rng
            let (next_low, next_high) = U64.widening_multiply x span
            low = next_low
            high = next_high
        }
    }
    high
}

@track_caller
def sample_u8 = (mut rng: Rng; start: U8; end: U8; inclusive: Bool) => U8 :: {
    let start_bits = start as U64
    let end_bits = end as U64
    let count = if (inclusive) {
        if (end < start) { panic "between: empty range" }
        (end_bits - start_bits) + 1
    } else {
        if (end <= start) { panic "between: empty range" }
        end_bits - start_bits
    }
    narrow_u8 (start_bits + sample_bounded rng count)
}

@track_caller
def sample_u16 = (mut rng: Rng; start: U16; end: U16; inclusive: Bool) => U16 :: {
    let start_bits = start as U64
    let end_bits = end as U64
    let count = if (inclusive) {
        if (end < start) { panic "between: empty range" }
        (end_bits - start_bits) + 1
    } else {
        if (end <= start) { panic "between: empty range" }
        end_bits - start_bits
    }
    narrow_u16 (start_bits + sample_bounded rng count)
}

@track_caller
def sample_u32 = (mut rng: Rng; start: U32; end: U32; inclusive: Bool) => U32 :: {
    let start_bits = start as U64
    let end_bits = end as U64
    let count = if (inclusive) {
        if (end < start) { panic "between: empty range" }
        (end_bits - start_bits) + 1
    } else {
