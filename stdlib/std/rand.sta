impl SampleRange Range<I8> {
    type Item = I8
    can_sample = range => range.*.current < range.*.end
    sample_range = (range, mut rng) => I8 ::
        narrow_i8 (unsigned_bits (sample_bits rng (signed_bits (range.*.current as I64)) (signed_bits (range.*.end as I64)) False))
}

impl SampleRange RangeInclusive<I8> {
    type Item = I8
    can_sample = range => !range.*.finished && range.*.current <= range.*.end
    sample_range = (range, mut rng) => I8 :: {
