@track_caller
def sample_isize = (mut rng: Rng; start: ISize; end: ISize; inclusive: Bool) => ISize :: {
    let start_bits = ISize.cast_unsigned start as U64
    let end_bits = ISize.cast_unsigned end as U64
    let count = if (inclusive) {
        if (end < start) { panic "between: empty range" }
        (end_bits - start_bits) + 1
    } else {
        if (end <= start) { panic "between: empty range" }
        end_bits - start_bits
    }
    narrow_isize (start_bits + sample_bounded rng count)
}

@track_caller
def sample_f32_range = (mut rng: Rng; start: F32; end: F32) => F32 :: {
    if (!(start < end)) {
        panic "between: empty range"
    }
    let mut value = start + (end - start) * unit_f32 rng
    while (value == end) {
        value = start + (end - start) * unit_f32 rng
    }
    value
}

@track_caller
def sample_f64_range = (mut rng: Rng; start: F64; end: F64) => F64 :: {
    if (!(start < end)) {
        panic "between: empty range"
    }
    let mut value = start + (end - start) * unit_f64 rng
    while (value == end) {
        value = start + (end - start) * unit_f64 rng
    }
    value
}

// ---------------------------------------------------------------------------
// Integer ranges
// ---------------------------------------------------------------------------

impl SampleRange Range<U8> {
    type Item = U8
    bounds = range => (start: range.*.current, end: range.*.end, inclusive: False)
    sample_range = (range, mut rng) => U8 ::
        sample_u8 rng range.*.current range.*.end False
}

impl SampleRange RangeInclusive<U8> {
    type Item = U8
    bounds = range => (start: range.*.current, end: range.*.end, inclusive: True)
    sample_range = (range, mut rng) => U8 :: {
        if (range.*.finished) { panic "between: empty range" }
        sample_u8 rng range.*.current range.*.end True
    }
}

impl SampleRange Range<U16> {
    type Item = U16
    bounds = range => (start: range.*.current, end: range.*.end, inclusive: False)
    sample_range = (range, mut rng) => U16 ::
        sample_u16 rng range.*.current range.*.end False
}

impl SampleRange RangeInclusive<U16> {
    type Item = U16
