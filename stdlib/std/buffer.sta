pub mod

use package.alloc.(Finalize, Gc, MemLayout, trap)
use package.clone.Clone
use package.ptr.(RawMutPtr, RawOpaqueMutPtr)
use package.shared_buffer.SharedBuffer

/// The prefix of every buffer allocation. Elements follow the header at the
/// offset `MemLayout.extend` reports, so string literals and `String`'s
/// representation keep their existing layout.
pub(package) type BufferHeader<T> wrap (length: USize, capacity: USize)

companion<T> BufferHeader {
    pub(package) def length = header: RawMutPtr<BufferHeader<T>> => USize ::
        (RawMutPtr.unsafe_read header).length

    pub(package) def capacity = header: RawMutPtr<BufferHeader<T>> => USize ::
        (RawMutPtr.unsafe_read header).capacity

    pub(package) def set_length = (header: RawMutPtr<BufferHeader<T>>; length: USize) => () :: {
        let mut value = RawMutPtr.unsafe_read header
        value.length = length
        RawMutPtr.store header value
    }

    pub(package) def element_offset = () => USize :: {
        let header = MemLayout.of.<BufferHeader<T>> ()
        let empty = match (MemLayout.array.<T> 0) {
            Some (layout) => layout,
            None => MemLayout (size: 0, align: 1),
        }
        match (MemLayout.extend ...(header; empty)) {
            Some (_, offset) => offset,
            None => 0,
        }
    }

    /// The address of one element in the array that follows `header`.
    pub(package) def element = (header: RawMutPtr<BufferHeader<T>>; index: USize) => RawMutPtr<T> :: {
        let offset = element_offset.<T> ()
        let stride = MemLayout.stride.<T> ()
        let address = (header as USize) + offset + index * stride
        address as RawMutPtr<T>
    }

    /// Drops the initialized elements from `front` to the current length.
    pub(package) def unsafe_drop_elements = (header: RawMutPtr<BufferHeader<T>>; front: USize) => () :: {
        let mut index = front
        let length = BufferHeader.length header
        while (index < length) {
            let value = RawMutPtr.unsafe_read (BufferHeader.element header index)
            drop value
            index = index + 1
        }
    }
}

impl<T> Finalize BufferHeader<T> {
    finalize = header => BufferHeader.unsafe_drop_elements header 0
}

/// A mutable, fixed-capacity buffer of values.
pub type Buffer<T> wrap RawMutPtr<BufferHeader<T>>
impl<T> !Copy Buffer<T> {}

/// Moves a buffer's allocation to the caller without running its `Drop`.
/// A module-level function rather than a companion method so the move
/// destructuring stays in the caller's direct call.
pub(package) def unsafe_buffer_into_raw = <T> move buffer: Buffer<T> => RawMutPtr<BufferHeader<T>> :: {
    let Buffer header = buffer
    header
}

impl<T> Drop Buffer<T> {
    cleanup = Buffer header => {
        BufferHeader.unsafe_drop_elements header 0
        Gc.unsafe_release (header as RawOpaqueMutPtr)
    }
}

extern "staple-intrinsic" {
    __buffer_from_array: <T, N where Natural N> move (T ^ N) -> Buffer<T>
}

companion<T> Buffer<T> {
    /// Allocates storage for exactly capacity elements without initialising values.
    pub def with_capacity = capacity: USize => Buffer<T> :: {
        let header = MemLayout.of.<BufferHeader<T>> ()
        let elements = match (MemLayout.array.<T> capacity) {
            Some (layout) => layout,
            None => trap (),
        }
        let layout = match (MemLayout.extend ...(header; elements)) {
            Some (layout, _) => layout,
            None => trap (),
        }
        let pointer: RawMutPtr<BufferHeader<T>> =
            Gc.allocate layout as RawMutPtr<BufferHeader<T>>
        RawMutPtr.store pointer (BufferHeader (length: 0, capacity: capacity))
        Buffer pointer
    }

    /// Returns the number of initialised elements in the buffer's prefix.
    pub def length = buffer: Buffer<T> => USize :: {
        let header = buffer.*
        BufferHeader.length header
    }

    /// Returns the fixed number of elements for which the buffer has storage.
    pub def capacity = buffer: Buffer<T> => USize :: {
        let header = buffer.*
        BufferHeader.capacity header
    }

    /// Appends an element, trapping if the buffer is full.
    pub def push = (mut buffer: Buffer<T>; move value: T) => () :: {
        let length = Buffer.length buffer
        if (length >= Buffer.capacity buffer) {
            trap ()
        }
        let header = buffer.*
        RawMutPtr.store (BufferHeader.element header length) value
        BufferHeader.set_length header (length + 1)
    }

    /// Removes and returns the last element, or `None` if empty.
    pub def pop = mut buffer: Buffer<T> => Option<T> :: {
        let length = Buffer.length buffer
        if (length == 0) {
            None
        } else {
            let header = buffer.*
            let value = RawMutPtr.unsafe_read (BufferHeader.element header (length - 1))
            BufferHeader.set_length header (length - 1)
            Some value
        }
    }

    /// Replaces the element at a position and returns the old value; `None` if out of bounds.
    pub def set = (mut buffer: Buffer<T>; position: USize; move value: T) => Option<T> :: {
        if (position < Buffer.length buffer) {
            Some (Buffer.set_unchecked buffer position value)
        } else {
            None
        }
    }

    /// Replaces the element at a position and returns the old value, trapping if out of bounds.
    pub def set_unchecked = (mut buffer: Buffer<T>; position: USize; move value: T) => T :: {
        if (position >= Buffer.length buffer) {
            trap ()
        }
        let header = buffer.*
        let element = BufferHeader.element header position
        let previous = RawMutPtr.unsafe_read element
        RawMutPtr.store element value
        previous
    }

    /// Moves the elements of a fixed array into a new buffer whose capacity is the array length.
    pub def from_array = <N where Natural N> move value: (T ^ N) => Buffer<T> :: __buffer_from_array value

    /// Consumes the buffer, moving its elements into a garbage-collected shared buffer.
    pub def into_shared_buffer = move buffer: Buffer<T> => SharedBuffer<T> :: {
        let pointer = unsafe_buffer_into_raw buffer
        if (Gc.needs_drop.<T> ()) {
            Gc.finalize_with pointer
        }
        SharedBuffer.unsafe_from_raw pointer
    }

    /// Moves every initialised source element to destination and empties source.
    /// Traps for overlapping or insufficient-capacity buffers.
    pub def transfer = (mut source: Buffer<T>; mut destination: Buffer<T>) => () :: {
        let source_length = Buffer.length source
        if (source_length > Buffer.capacity destination - Buffer.length destination) {
            trap ()
        }
        let source_header = source.*
        let destination_header = destination.*
        if (source_header == destination_header) {
            trap ()
        }
        let destination_length = BufferHeader.length destination_header
        RawMutPtr.unsafe_copy_nonoverlapping
            (BufferHeader.element destination_header destination_length)
            (BufferHeader.element source_header 0)
            source_length
        BufferHeader.set_length destination_header (destination_length + source_length)
        BufferHeader.set_length source_header 0
    }

    /// Moves the buffer's allocation to the caller without running its `Drop`.
    /// The caller must eventually free it with `Gc.unsafe_release` after
    /// cleaning up the elements.
    pub(package) def unsafe_into_raw = move buffer: Buffer<T> => RawMutPtr<BufferHeader<T>> :: {
        let header = buffer.*
        header
    }
}

companion<T where Copy T> Buffer<T> {
    /// Copies the element at a position, or `None` if out of bounds.
    pub def get = (buffer: Buffer<T>; position: USize) => Option<T> :: {
        if (position < Buffer.length buffer) {
            Some (Buffer.get_unchecked buffer position)
        } else {
            None
        }
    }

    /// Copies the element at a position, trapping if out of bounds.
    pub def get_unchecked = (buffer: Buffer<T>; position: USize) => T :: {
        if (position >= Buffer.length buffer) {
            trap ()
        }
        let header = buffer.*
        RawMutPtr.unsafe_read (BufferHeader.element header position)
    }
}

impl<T where Clone T> Clone Buffer<T> {
    clone = buffer => {
        let length = Buffer.length buffer
        let mut copy: Buffer<T> = Buffer.with_capacity (Buffer.capacity buffer)
        let mut index: USize = 0
        while (index < length) {
            let header = buffer.*
            let element = BufferHeader.element header index
            let value = RawMutPtr.unsafe_read element
            let duplicated = Clone.clone value
            RawMutPtr.store element value
            Buffer.push copy duplicated
            index = index + 1
        }
        copy
    }
}
