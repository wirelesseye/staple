pub mod

use package.string_builder.StringBuilder
use package.char.Char
use package.string.(String, ToString)
use package.flow.for
use package.syntax.*
use package.process.(panic)

/// A UTF-8 output sink for formatting traits, backed by a StringBuilder.
pub type Formatter wrap StringBuilder

/// Formats a value for human-facing output.
pub trait Display T {
    fmt: (T, mut Formatter) -> ()
}

/// Formats a value for developer-facing output.
pub trait Debug T {
    fmt: (T, mut Formatter) -> ()
}

def derived_debug_implementation = (
    name_syntax: Ident<String>,
    name: String,
    target: Type,
    parameters: Sequence<Ident<String>>,
    representation: Type,
) => Item :: {
    let name_expression = StringExpr name
    let inner_name = Ident "inner"
    let inner_pattern = BindingPattern inner_name
    let value_pattern = NominalPattern (name: name_syntax, argument: inner_pattern)
    match parameters {
        Sequence () => {
            parse_quote {
                impl Debug $target {
                    fmt = ($value_pattern, mut formatter) => {
                        formatter |> write $name_expression
                        formatter |> write " "
                        Debug.fmt ($inner_name, formatter)
                    }
                }
            }
        },
        _ => {
            parse_quote {
                impl<$parameters... where Debug $representation> Debug $target {
                    fmt = ($value_pattern, mut formatter) => {
                        formatter |> write $name_expression
                        formatter |> write " "
                        Debug.fmt ($inner_name, formatter)
                    }
                }
            }
        },
    }
}

/// Inspects a declaration without consuming its pending modifiers.
def derived_debug_declaration = item: Item => Item :: match item {
    ModifiedItem (_, nested) => derived_debug_declaration nested,
    _ => item,
}

/// Derives `Debug` for a bodyless singleton type, formatting it as its name.
/// Singleton types cannot carry compile-time parameters, so the implementation
/// is always unparameterized.
def derived_singleton_debug_implementation = (name: String, target: Type) => Item :: {
    let name_expression = StringExpr name
    parse_quote {
        impl Debug $target {
            fmt = (_, mut formatter) => formatter |> write $name_expression
        }
    }
}

/// Derives `Debug` for a nominal type.
///
/// A represented type prefixes its name and delegates formatting to its
/// representation; a bodyless singleton type formats as its name alone.
/// Pending modifiers are preserved, so derive modifiers can be stacked.
///
/// # Example
///
/// ```staple
/// @derive_debug
/// pub type UserId wrap pub I32
///
/// @derive_debug
/// type Enabled
/// ```
pub macro @derive_debug: Item -> Sequence<Item> = item => match (derived_debug_declaration item) {
    TypeDeclarationItem (
        name_syntax@(Ident name), target, parameters, Some (WrapperBody (_, representation)), _,
    ) => Sequence (
        first: item,
        rest: Sequence (
            first: derived_debug_implementation (name_syntax, name, target, parameters, representation),
            rest: Sequence (),
        ),
    ),
    TypeDeclarationItem (
        name_syntax@(Ident name), target, parameters, Some (FromBody (_, representation)), _,
    ) => Sequence (
        first: item,
        rest: Sequence (
            first: derived_debug_implementation (name_syntax, name, target, parameters, representation),
            rest: Sequence (),
        ),
    ),
    TypeDeclarationItem (Ident name, target, _, None, _) => Sequence (
        first: item,
        rest: Sequence (
            first: derived_singleton_debug_implementation (name, target),
            rest: Sequence (),
        ),
    ),
    _ => panic "derive_debug item is unsupported",
}

companion Formatter {
    use package.string.String

    /// Creates an empty formatter.
    pub def new = () => Formatter :: Formatter (StringBuilder.with_capacity 16)

    /// Appends a UTF-8 string to the formatter.
    pub def write = (mut formatter: Formatter; value: String) =>
        () :: StringBuilder.append formatter.* value

    /// Appends one Unicode scalar without allocating.
    pub def push = (mut formatter: Formatter; value: Char) => () :: StringBuilder.push formatter.* value

    /// Finishes formatting and returns the accumulated string.
    pub def finish = move formatter: Formatter => String :: {
        let Formatter builder = formatter
        StringBuilder.finish builder
    }

    /// Formats a value using its Display implementation.
    pub def display = <T where Display T> value: T => String :: {
        let mut formatter = Formatter.new ()
        Display.fmt (value, formatter)
        Formatter.finish formatter
    }

    /// Formats a value using its Debug implementation.
    pub def debug = <T where Debug T> value: T => String :: {
        let mut formatter = Formatter.new ()
        Debug.fmt (value, formatter)
        Formatter.finish formatter
    }
}

impl<T where Display T> ToString T {
    to_string = value => Formatter.display value
}
