        if (value == 0) { None } else { Some (ilog10 value) }
    }

    /// Returns the integer square root.
    @track_caller
    pub def isqrt = (value: U32) => U32 :: {
        if (value < 2) {
            value
        } else {
            let mut x = value / 2 + 1
            let mut y = (x + value / x) / 2
            while (y < x) {
                x = y
                y = (x + value / x) / 2
            }
            x
        }
    }

    /// Returns the number of one bits.
    pub def count_ones = (value: U32) => U32 :: __u32_count_ones value

    /// Returns the number of zero bits.
    pub def count_zeros = (value: U32) => U32 :: Bits - count_ones value

    /// Returns the number of leading zero bits.
    pub def leading_zeros = (value: U32) => U32 :: __u32_leading_zeros value

    /// Returns the number of trailing zero bits.
    pub def trailing_zeros = (value: U32) => U32 :: __u32_trailing_zeros value

    /// Returns the number of leading one bits.
    pub def leading_ones = (value: U32) => U32 :: leading_zeros (BitNot.bit_not value)

    /// Returns the number of trailing one bits.
    pub def trailing_ones = (value: U32) => U32 :: trailing_zeros (BitNot.bit_not value)

    /// Rotates the bits left by `count`, reducing the count modulo the width.
    pub def rotate_left = (value: U32; count: U32) => U32 :: __u32_rotate_left (value, count)

    /// Rotates the bits right by `count`, reducing the count modulo the width.
    pub def rotate_right = (value: U32; count: U32) => U32 :: __u32_rotate_right (value, count)

    /// Reverses the byte order.
    pub def swap_bytes = (value: U32) => U32 :: __u32_swap_bytes value

    /// Reverses the bit order.
    pub def reverse_bits = (value: U32) => U32 :: __u32_reverse_bits value

    /// Reinterprets the bits as the signed type of the same width.
    pub def cast_signed = (value: U32) => I32 :: __u32_cast_sign value

    /// Returns whether `value` is a power of two.
    pub def is_power_of_two = (value: U32) => Bool :: value != 0 && (BitAnd.bit_and (value; value - 1)) == 0

    /// Returns the smallest power of two greater than or equal to `value`,
    /// wrapping to zero past the top.
    pub def next_power_of_two = (value: U32) => U32 :: {
        if (value <= 1) {
            1
        } else {
            let mut result: U32 = 1
            while (result < value && result != 0) {
                result = ShiftLeft.shift_left (result; 1)
            }
            result
        }
    }

    /// Returns the smallest power of two greater than or equal to `value`, or
    /// `None` when it does not fit.
    pub def checked_next_power_of_two = (value: U32) => Option<U32> :: {
        let result = next_power_of_two value
        if (result == 0) { None } else { Some result }
    }

    /// Adds a signed value, or returns `None` when the result is out of range.
    pub def checked_add_signed = (left: U32; right: I32) => Option<U32> :: {
        if (right >= 0) {
            let amount: U32 = match (Result<U32, ConversionError> :: TryConvert.try_convert right) {
                Ok value => value,
                _ => 0,
            }
            checked_add left amount
        } else {
            let negated = 0 - right
            let amount: U32 = if (negated < 0) {
                Max - (Max / 2)
            } else {
                match (Result<U32, ConversionError> :: TryConvert.try_convert negated) {
                    Ok value => value,
                    _ => 0,
                }
            }
            checked_subtract left amount
        }
    }
}

// ---------------------------------------------------------------------------
// U64 math
// ---------------------------------------------------------------------------

companion U64 {
    use package.convert.(ConversionError, TryConvert)
    use package.ops.(BitAnd, BitNot, ShiftLeft, ShiftRight)
    use package.option.(Option, Some, None)
    use package.result.(Ok, Result)
    use package.process.(panic)
    use package.source.(track_caller)

    extern "staple-intrinsic" {
        __u64_overflowing_add: (U64, U64) -> (U8, U64)
        __u64_overflowing_subtract: (U64, U64) -> (U8, U64)
        __u64_overflowing_multiply: (U64, U64) -> (U8, U64)
        __u64_count_ones: U64 -> U32
        __u64_leading_zeros: U64 -> U32
        __u64_trailing_zeros: U64 -> U32
        __u64_swap_bytes: U64 -> U64
        __u64_reverse_bits: U64 -> U64
        __u64_rotate_left: (U64, U32) -> U64
        __u64_rotate_right: (U64, U32) -> U64
        __u64_cast_sign: U64 -> I64
    }

    /// The smallest value.
    pub const Min: U64 = 0
    /// The largest value.
    pub const Max: U64 = 18446744073709551615
    /// The width in bits.
    pub const Bits: U32 = 64

    /// Returns the smaller of two values.
    pub def min = (left: U64; right: U64) => U64 :: if (left < right) { left } else { right }

    /// Returns the larger of two values.
    pub def max = (left: U64; right: U64) => U64 :: if (left > right) { left } else { right }

    /// Constrains `value` to the inclusive range `lo ..= hi`. Panics at the
    /// caller when `lo > hi`.
    @track_caller
    pub def clamp = (value: U64; lo: U64; hi: U64) => U64 :: {
        if (lo > hi) {
            panic "clamp: invalid bounds"
        }
        if (value < lo) {
            lo
        } else if (value > hi) {
            hi
        } else {
            value
        }
    }

    /// Returns the absolute difference between two values.
    pub def abs_diff = (left: U64; right: U64) => U64 :: if (left < right) { right - left } else { left - right }

    /// Returns `left + right`, or `None` on overflow.
    pub def checked_add = (left: U64; right: U64) => Option<U64> :: {
        let (status, value) = __u64_overflowing_add (left, right)
        if (status == 0) { Some value } else { None }
    }

    /// Returns `left - right`, or `None` on underflow.
    pub def checked_subtract = (left: U64; right: U64) => Option<U64> :: {
        let (status, value) = __u64_overflowing_subtract (left, right)
        if (status == 0) { Some value } else { None }
    }

    /// Returns `left * right`, or `None` on overflow.
    pub def checked_multiply = (left: U64; right: U64) => Option<U64> :: {
        let (status, value) = __u64_overflowing_multiply (left, right)
        if (status == 0) { Some value } else { None }
    }

    /// Returns `left / right`, or `None` for a zero divisor.
    pub def checked_divide = (left: U64; right: U64) => Option<U64> :: {
        if (right == 0) { None } else { Some (left / right) }
    }

    /// Returns `left % right`, or `None` for a zero divisor.
    pub def checked_remainder = (left: U64; right: U64) => Option<U64> :: {
        if (right == 0) { None } else { Some (left % right) }
    }

    /// Returns `value` shifted left by `count`, or `None` when the count is not
    /// smaller than the width.
    pub def checked_shift_left = (value: U64; count: U32) => Option<U64> :: {
        if (count >= Bits) { None } else { Some (wrapping_shift_left value count) }
    }

    /// Returns `value` shifted right by `count`, or `None` when the count is
    /// not smaller than the width.
    pub def checked_shift_right = (value: U64; count: U32) => Option<U64> :: {
        if (count >= Bits) { None } else { Some (wrapping_shift_right value count) }
    }

    /// Returns `left + right`, wrapping on overflow.
    pub def wrapping_add = (left: U64; right: U64) => U64 :: left + right

    /// Returns `left - right`, wrapping on underflow.
    pub def wrapping_subtract = (left: U64; right: U64) => U64 :: left - right

    /// Returns `left * right`, wrapping on overflow.
    pub def wrapping_multiply = (left: U64; right: U64) => U64 :: left * right

    /// Returns the low and high halves of the exact product.
    pub def widening_multiply = (left: U64; right: U64) => (low: U64, high: U64) :: {
        let left_low = left % 4294967296
        let left_high = left / 4294967296
        let right_low = right % 4294967296
        let right_high = right / 4294967296
        let low_product = left_low * right_low
        let middle = left_high * right_low + low_product / 4294967296
        let middle_low = middle % 4294967296
        let middle_high = middle / 4294967296
        let upper = left_low * right_high + middle_low
        let low = (upper % 4294967296) * 4294967296 + (low_product % 4294967296)
        let high = left_high * right_high + middle_high + upper / 4294967296
        (low: low, high: high)
    }

    /// Returns `value` shifted left by `count`, reducing the count modulo the
    /// width.
    pub def wrapping_shift_left = (value: U64; count: U32) => U64 :: {
        let shift = count % Bits
        let amount: U64 = shift as U64
        ShiftLeft.shift_left (value; amount)
    }

    /// Returns `value` shifted right by `count`, reducing the count modulo the
    /// width.
    pub def wrapping_shift_right = (value: U64; count: U32) => U64 :: {
        let shift = count % Bits
        let amount: U64 = shift as U64
        ShiftRight.shift_right (value; amount)
    }

    /// Returns `left + right`, saturating at the type's bounds.
    pub def saturating_add = (left: U64; right: U64) => U64 :: {
        let (status, value) = __u64_overflowing_add (left, right)
        if (status == 0) { value } else { Max }
    }

    /// Returns `left - right`, saturating at the type's bounds.
    pub def saturating_subtract = (left: U64; right: U64) => U64 :: {
        let (status, value) = __u64_overflowing_subtract (left, right)
        if (status == 0) { value } else { Min }
    }

    /// Returns `left * right`, saturating at the type's bounds.
    pub def saturating_multiply = (left: U64; right: U64) => U64 :: {
        let (status, value) = __u64_overflowing_multiply (left, right)
        if (status == 0) { value } else { Max }
    }

    /// Returns the wrapped result and whether the addition overflowed.
    pub def overflowing_add = (left: U64; right: U64) => (U64, Bool) :: {
        let (status, value) = __u64_overflowing_add (left, right)
        (value, status != 0)
    }

    /// Returns the wrapped result and whether the subtraction overflowed.
    pub def overflowing_subtract = (left: U64; right: U64) => (U64, Bool) :: {
        let (status, value) = __u64_overflowing_subtract (left, right)
        (value, status != 0)
    }

    /// Returns the wrapped result and whether the multiplication overflowed.
    pub def overflowing_multiply = (left: U64; right: U64) => (U64, Bool) :: {
        let (status, value) = __u64_overflowing_multiply (left, right)
        (value, status != 0)
    }

    /// Returns the Euclidean quotient of `left / right`. Panics at the caller
    /// for a zero divisor.
    @track_caller
    pub def divide_euclid = (left: U64; right: U64) => U64 :: left / right

    /// Returns the Euclidean remainder of `left / right`. Panics at the caller
    /// for a zero divisor.
    @track_caller
    pub def remainder_euclid = (left: U64; right: U64) => U64 :: left % right

    /// Returns the quotient rounded up. Panics at the caller for a zero
    /// divisor.
    @track_caller
    pub def divide_ceil = (left: U64; right: U64) => U64 :: {
        let quotient = left / right
        if (left % right == 0) { quotient } else { quotient + 1 }
    }

    /// Returns `base` raised to `exponent`, wrapping like `*`.
    pub def pow = (base: U64; exponent: U32) => U64 :: {
        let mut result: U64 = 1
        let mut factor = base
        let mut remaining = exponent
        while (remaining > 0) {
            if (BitAnd.bit_and (remaining; 1) == 1) {
                result = result * factor
            }
            remaining = ShiftRight.shift_right (remaining; 1)
            if (remaining > 0) {
                factor = factor * factor
            }
        }
        result
    }

    /// Returns `base` raised to `exponent`, or `None` on overflow.
    pub def checked_pow = (base: U64; exponent: U32) => Option<U64> :: {
        let mut result: Option<U64> = Some 1
        let mut factor: Option<U64> = Some base
        let mut remaining = exponent
        while (remaining > 0) {
            if (BitAnd.bit_and (remaining; 1) == 1) {
                result = match (result, factor) {
                    (Some value, Some power) => checked_multiply value power,
                    _ => None,
                }
            }
            remaining = ShiftRight.shift_right (remaining; 1)
            if (remaining > 0) {
                factor = match factor {
                    Some value => checked_multiply value value,
                    None => None,
                }
            }
        }
        result
    }

    /// Returns `base` raised to `exponent`, saturating at the type's bounds.
    pub def saturating_pow = (base: U64; exponent: U32) => U64 :: {
        let mut result: U64 = 1
        let mut factor = base
        let mut remaining = exponent
        while (remaining > 0) {
            if (BitAnd.bit_and (remaining; 1) == 1) {
                result = saturating_multiply result factor
            }
            remaining = ShiftRight.shift_right (remaining; 1)
            if (remaining > 0) {
                factor = saturating_multiply factor factor
            }
        }
        result
    }

    /// Returns the base-2 logarithm. Panics at the caller for zero.
    @track_caller
    pub def ilog2 = (value: U64) => U32 :: {
        if (value == 0) {
            panic "ilog2: zero value"
        } else {
            Bits - 1 - leading_zeros value
        }
    }

    /// Returns the base-10 logarithm. Panics at the caller for zero.
    @track_caller
    pub def ilog10 = (value: U64) => U32 :: {
        if (value == 0) {
            panic "ilog10: zero value"
        }
        let mut remaining = value
        let mut result: U32 = 0
        while (remaining >= 10) {
            remaining = remaining / 10
            result = result + 1
        }
        result
    }

    /// Returns the base-2 logarithm, or `None` for zero.
    pub def checked_ilog2 = (value: U64) => Option<U32> :: {
        if (value == 0) { None } else { Some (ilog2 value) }
    }

    /// Returns the base-10 logarithm, or `None` for zero.
    pub def checked_ilog10 = (value: U64) => Option<U32> :: {
        if (value == 0) { None } else { Some (ilog10 value) }
    }

    /// Returns the integer square root.
    @track_caller
    pub def isqrt = (value: U64) => U64 :: {
        if (value < 2) {
            value
        } else {
            let mut x = value / 2 + 1
            let mut y = (x + value / x) / 2
            while (y < x) {
                x = y
                y = (x + value / x) / 2
            }
            x
        }
    }

    /// Returns the number of one bits.
    pub def count_ones = (value: U64) => U32 :: __u64_count_ones value

    /// Returns the number of zero bits.
    pub def count_zeros = (value: U64) => U32 :: Bits - count_ones value

    /// Returns the number of leading zero bits.
    pub def leading_zeros = (value: U64) => U32 :: __u64_leading_zeros value

    /// Returns the number of trailing zero bits.
    pub def trailing_zeros = (value: U64) => U32 :: __u64_trailing_zeros value

    /// Returns the number of leading one bits.
    pub def leading_ones = (value: U64) => U32 :: leading_zeros (BitNot.bit_not value)

    /// Returns the number of trailing one bits.
    pub def trailing_ones = (value: U64) => U32 :: trailing_zeros (BitNot.bit_not value)

    /// Rotates the bits left by `count`, reducing the count modulo the width.
    pub def rotate_left = (value: U64; count: U32) => U64 :: __u64_rotate_left (value, count)

    /// Rotates the bits right by `count`, reducing the count modulo the width.
    pub def rotate_right = (value: U64; count: U32) => U64 :: __u64_rotate_right (value, count)

    /// Reverses the byte order.
    pub def swap_bytes = (value: U64) => U64 :: __u64_swap_bytes value

    /// Reverses the bit order.
    pub def reverse_bits = (value: U64) => U64 :: __u64_reverse_bits value

    /// Reinterprets the bits as the signed type of the same width.
    pub def cast_signed = (value: U64) => I64 :: __u64_cast_sign value

    /// Returns whether `value` is a power of two.
    pub def is_power_of_two = (value: U64) => Bool :: value != 0 && (BitAnd.bit_and (value; value - 1)) == 0

    /// Returns the smallest power of two greater than or equal to `value`,
    /// wrapping to zero past the top.
    pub def next_power_of_two = (value: U64) => U64 :: {
        if (value <= 1) {
            1
        } else {
            let mut result: U64 = 1
            while (result < value && result != 0) {
                result = ShiftLeft.shift_left (result; 1)
            }
            result
        }
    }

    /// Returns the smallest power of two greater than or equal to `value`, or
    /// `None` when it does not fit.
    pub def checked_next_power_of_two = (value: U64) => Option<U64> :: {
        let result = next_power_of_two value
        if (result == 0) { None } else { Some result }
    }

    /// Adds a signed value, or returns `None` when the result is out of range.
    pub def checked_add_signed = (left: U64; right: I64) => Option<U64> :: {
        if (right >= 0) {
            let amount: U64 = match (Result<U64, ConversionError> :: TryConvert.try_convert right) {
                Ok value => value,
                _ => 0,
            }
            checked_add left amount
        } else {
            let negated = 0 - right
            let amount: U64 = if (negated < 0) {
                Max - (Max / 2)
            } else {
                match (Result<U64, ConversionError> :: TryConvert.try_convert negated) {
                    Ok value => value,
                    _ => 0,
                }
            }
            checked_subtract left amount
        }
    }
}

// ---------------------------------------------------------------------------
// ISize math
// ---------------------------------------------------------------------------

companion ISize {
    use package.alloc.MemLayout
    use package.convert.(ConversionError, TryConvert)
    use package.ops.(BitAnd, BitNot, ShiftLeft, ShiftRight)
    use package.option.(Option, Some, None)
    use package.result.(Ok, Result)
    use package.process.(panic)
    use package.source.(track_caller)

    extern "staple-intrinsic" {
        __isize_overflowing_add: (ISize, ISize) -> (U8, ISize)
        __isize_overflowing_subtract: (ISize, ISize) -> (U8, ISize)
        __isize_overflowing_multiply: (ISize, ISize) -> (U8, ISize)
        __isize_count_ones: ISize -> U32
        __isize_leading_zeros: ISize -> U32
        __isize_trailing_zeros: ISize -> U32
        __isize_swap_bytes: ISize -> ISize
        __isize_reverse_bits: ISize -> ISize
        __isize_rotate_left: (ISize, U32) -> ISize
        __isize_rotate_right: (ISize, U32) -> ISize
        __isize_cast_sign: ISize -> USize
    }

    def bits = () => U32 :: match (TryConvert.try_convert.<USize, U32> (MemLayout.stride.<USize> () * 8)) {
        Ok value => value,
        _ => 0,
    }

    def max_value = () => ISize :: match (TryConvert.try_convert.<USize, ISize> ((BitNot.bit_not (USize :: 0)) / 2)) {
        Ok value => value,
        _ => 0,
    }

    def min_value = () => ISize :: 0 - max_value () - 1

    /// Returns the smaller of two values.
    pub def min = (left: ISize; right: ISize) => ISize :: if (left < right) { left } else { right }

    /// Returns the larger of two values.
    pub def max = (left: ISize; right: ISize) => ISize :: if (left > right) { left } else { right }

    /// Constrains `value` to the inclusive range `lo ..= hi`. Panics at the
    /// caller when `lo > hi`.
    @track_caller
    pub def clamp = (value: ISize; lo: ISize; hi: ISize) => ISize :: {
        if (lo > hi) {
            panic "clamp: invalid bounds"
        }
        if (value < lo) {
            lo
        } else if (value > hi) {
            hi
        } else {
            value
        }
    }

    /// Returns the absolute value, wrapping at the minimum like prefix `-`.
    pub def abs = (value: ISize) => ISize :: if (value < 0) { 0 - value } else { value }

    /// Returns `-value`, or `None` at the minimum value.
    pub def checked_negate = (value: ISize) => Option<ISize> :: {
        let (status, negated) = __isize_overflowing_subtract (0, value)
        if (status == 0) { Some negated } else { None }
    }

    /// Returns `-value`, wrapping at the minimum value.
    pub def wrapping_negate = (value: ISize) => ISize :: 0 - value

    /// Returns the absolute value, or `None` at the minimum value.
    pub def checked_abs = (value: ISize) => Option<ISize> :: {
        if (value < 0) { checked_negate value } else { Some value }
    }

    /// Returns the exact magnitude of `value` as an unsigned value.
    pub def unsigned_abs = (value: ISize) => USize :: {
        if (value >= 0) {
            match (Result<USize, ConversionError> :: TryConvert.try_convert value) {
                Ok result => result,
                _ => 0,
            }
        } else {
            let negated = 0 - value
            if (negated >= 0) {
                match (Result<USize, ConversionError> :: TryConvert.try_convert negated) {
                    Ok result => result,
                    _ => 0,
                }
            } else {
                ((BitNot.bit_not (USize :: 0)) / 2) + 1
            }
        }
    }

    /// Returns the absolute difference between two values as an unsigned value.
    pub def abs_diff = (left: ISize; right: ISize) => USize :: {
        let high = if (left < right) { right } else { left }
        let low = if (left < right) { left } else { right }
        if (low < 0 && high >= 0) {
            unsigned_abs high + unsigned_abs low
        } else {
            unsigned_abs (high - low)
        }
    }

    /// Returns the wrapped result and whether the addition overflowed.
    pub def overflowing_add = (left: ISize; right: ISize) => (ISize, Bool) :: {
        let (status, value) = __isize_overflowing_add (left, right)
        (value, status != 0)
    }

    /// Returns the wrapped result and whether the subtraction overflowed.
    pub def overflowing_subtract = (left: ISize; right: ISize) => (ISize, Bool) :: {
        let (status, value) = __isize_overflowing_subtract (left, right)
        (value, status != 0)
    }

    /// Returns the wrapped result and whether the multiplication overflowed.
    pub def overflowing_multiply = (left: ISize; right: ISize) => (ISize, Bool) :: {
        let (status, value) = __isize_overflowing_multiply (left, right)
        (value, status != 0)
    }

    /// Returns `left + right`, or `None` on overflow.
    pub def checked_add = (left: ISize; right: ISize) => Option<ISize> :: {
        let (status, value) = __isize_overflowing_add (left, right)
        if (status == 0) { Some value } else { None }
    }

    /// Returns `left - right`, or `None` on overflow.
    pub def checked_subtract = (left: ISize; right: ISize) => Option<ISize> :: {
        let (status, value) = __isize_overflowing_subtract (left, right)
        if (status == 0) { Some value } else { None }
    }

    /// Returns `left * right`, or `None` on overflow.
    pub def checked_multiply = (left: ISize; right: ISize) => Option<ISize> :: {
        let (status, value) = __isize_overflowing_multiply (left, right)
        if (status == 0) { Some value } else { None }
    }

    /// Returns `left + right`, wrapping on overflow.
    pub def wrapping_add = (left: ISize; right: ISize) => ISize :: left + right

    /// Returns `left - right`, wrapping on overflow.
    pub def wrapping_subtract = (left: ISize; right: ISize) => ISize :: left - right

    /// Returns `left * right`, wrapping on overflow.
    pub def wrapping_multiply = (left: ISize; right: ISize) => ISize :: left * right

    /// Returns `value` shifted left by `count`, or `None` when the count is not
    /// smaller than the width.
    pub def checked_shift_left = (value: ISize; count: U32) => Option<ISize> :: {
        if (count >= bits ()) { None } else { Some (wrapping_shift_left value count) }
    }

    /// Returns `value` shifted right by `count`, or `None` when the count is
    /// not smaller than the width.
    pub def checked_shift_right = (value: ISize; count: U32) => Option<ISize> :: {
        if (count >= bits ()) { None } else { Some (wrapping_shift_right value count) }
    }

    /// Returns `value` shifted left by `count`, reducing the count modulo the
    /// width.
    pub def wrapping_shift_left = (value: ISize; count: U32) => ISize :: {
        let shift = count % bits ()
        let amount: ISize = match (TryConvert.try_convert.<U32, ISize> shift) {
            Ok amount => amount,
            _ => 0,
        }
        ShiftLeft.shift_left (value; amount)
    }

    /// Returns `value` shifted right by `count`, reducing the count modulo the
    /// width.
    pub def wrapping_shift_right = (value: ISize; count: U32) => ISize :: {
        let shift = count % bits ()
        let amount: ISize = match (TryConvert.try_convert.<U32, ISize> shift) {
            Ok amount => amount,
            _ => 0,
        }
        ShiftRight.shift_right (value; amount)
    }

    /// Returns `left + right`, saturating at the type's bounds.
    pub def saturating_add = (left: ISize; right: ISize) => ISize :: {
        let (status, value) = __isize_overflowing_add (left, right)
        if (status == 0) {
            value
        } else if (right > 0) {
            max_value ()
        } else {
            min_value ()
        }
    }

    /// Returns `left - right`, saturating at the type's bounds.
    pub def saturating_subtract = (left: ISize; right: ISize) => ISize :: {
        let (status, value) = __isize_overflowing_subtract (left, right)
        if (status == 0) {
            value
        } else if (right > 0) {
            min_value ()
        } else {
            max_value ()
        }
    }

    /// Returns `left * right`, saturating at the type's bounds.
    pub def saturating_multiply = (left: ISize; right: ISize) => ISize :: {
        let (status, value) = __isize_overflowing_multiply (left, right)
        if (status == 0) {
            value
        } else if ((left < 0) != (right < 0)) {
            min_value ()
        } else {
            max_value ()
        }
    }

    /// Returns `left / right`, or `None` for a zero divisor or the overflowing
    /// minimum divided by -1.
    pub def checked_divide = (left: ISize; right: ISize) => Option<ISize> :: {
        if (right == 0 || (right == ((ISize :: 0) - 1) && unsigned_abs left == ((BitNot.bit_not (USize :: 0)) / 2) + 1)) {
            None
        } else {
            Some (left / right)
        }
    }

    /// Returns `left % right`, or `None` for a zero divisor.
    pub def checked_remainder = (left: ISize; right: ISize) => Option<ISize> :: {
        if (right == 0) { None } else { Some (left % right) }
    }

    /// Returns the Euclidean quotient of `left / right`. Panics at the caller
    /// for a zero divisor or the overflowing minimum divided by -1.
    @track_caller
    pub def divide_euclid = (left: ISize; right: ISize) => ISize :: {
        let quotient = left / right
        let remainder = left % right
        if (remainder < 0) {
            if (right > 0) { quotient - 1 } else { quotient + 1 }
        } else {
            quotient
        }
    }

    /// Returns the non-negative Euclidean remainder of `left / right`. Panics
    /// at the caller for a zero divisor.
    @track_caller
    pub def remainder_euclid = (left: ISize; right: ISize) => ISize :: {
        let remainder = left % right
        if (remainder < 0) {
            if (right > 0) { remainder + right } else { remainder - right }
        } else {
            remainder
        }
    }

    /// Returns `base` raised to `exponent`, wrapping like `*`.
    pub def pow = (base: ISize; exponent: U32) => ISize :: {
        let mut result: ISize = 1
        let mut factor = base
        let mut remaining = exponent
        while (remaining > 0) {
            if (BitAnd.bit_and (remaining; 1) == 1) {
                result = result * factor
            }
            remaining = ShiftRight.shift_right (remaining; 1)
            if (remaining > 0) {
                factor = factor * factor
            }
        }
        result
    }

    /// Returns `base` raised to `exponent`, or `None` on overflow.
    pub def checked_pow = (base: ISize; exponent: U32) => Option<ISize> :: {
        let mut result: Option<ISize> = Some 1
        let mut factor: Option<ISize> = Some base
        let mut remaining = exponent
        while (remaining > 0) {
            if (BitAnd.bit_and (remaining; 1) == 1) {
                result = match (result, factor) {
                    (Some value, Some power) => checked_multiply value power,
                    _ => None,
                }
            }
            remaining = ShiftRight.shift_right (remaining; 1)
            if (remaining > 0) {
                factor = match factor {
                    Some value => checked_multiply value value,
                    None => None,
                }
            }
        }
        result
    }

    /// Returns `base` raised to `exponent`, saturating at the type's bounds.
    pub def saturating_pow = (base: ISize; exponent: U32) => ISize :: {
        let mut result: ISize = 1
        let mut factor = base
        let mut remaining = exponent
        while (remaining > 0) {
            if (BitAnd.bit_and (remaining; 1) == 1) {
                result = saturating_multiply result factor
            }
            remaining = ShiftRight.shift_right (remaining; 1)
            if (remaining > 0) {
                factor = saturating_multiply factor factor
            }
        }
        result
    }

    /// Returns the integer square root. Panics at the caller for a negative
    /// value.
    @track_caller
    pub def isqrt = (value: ISize) => ISize :: {
        if (value < 0) {
            panic "isqrt: negative value"
        }
        if (value < 2) {
            value
        } else {
            let mut x = value / 2 + 1
            let mut y = (x + value / x) / 2
            while (y < x) {
                x = y
                y = (x + value / x) / 2
            }
            x
        }
    }

    /// Returns the base-2 logarithm. Panics at the caller for `value <= 0`.
    @track_caller
    pub def ilog2 = (value: ISize) => U32 :: {
        if (value <= 0) {
            panic "ilog2: non-positive value"
        } else {
            bits () - 1 - leading_zeros value
        }
    }

    /// Returns the base-10 logarithm. Panics at the caller for `value <= 0`.
    @track_caller
    pub def ilog10 = (value: ISize) => U32 :: {
        if (value <= 0) {
            panic "ilog10: non-positive value"
        }
        let mut remaining = value
        let mut result: U32 = 0
        while (remaining >= 10) {
            remaining = remaining / 10
            result = result + 1
        }
        result
    }

    /// Returns the base-2 logarithm, or `None` for `value <= 0`.
    pub def checked_ilog2 = (value: ISize) => Option<U32> :: {
        if (value <= 0) { None } else { Some (ilog2 value) }
    }

    /// Returns the base-10 logarithm, or `None` for `value <= 0`.
    pub def checked_ilog10 = (value: ISize) => Option<U32> :: {
        if (value <= 0) { None } else { Some (ilog10 value) }
    }

    /// Returns the number of one bits.
    pub def count_ones = (value: ISize) => U32 :: __isize_count_ones value

    /// Returns the number of zero bits.
    pub def count_zeros = (value: ISize) => U32 :: bits () - count_ones value

    /// Returns the number of leading zero bits.
    pub def leading_zeros = (value: ISize) => U32 :: __isize_leading_zeros value

    /// Returns the number of trailing zero bits.
    pub def trailing_zeros = (value: ISize) => U32 :: __isize_trailing_zeros value

    /// Returns the number of leading one bits.
    pub def leading_ones = (value: ISize) => U32 :: leading_zeros (BitNot.bit_not value)

    /// Returns the number of trailing one bits.
    pub def trailing_ones = (value: ISize) => U32 :: trailing_zeros (BitNot.bit_not value)

    /// Rotates the bits left by `count`, reducing the count modulo the width.
    pub def rotate_left = (value: ISize; count: U32) => ISize :: __isize_rotate_left (value, count)

    /// Rotates the bits right by `count`, reducing the count modulo the width.
    pub def rotate_right = (value: ISize; count: U32) => ISize :: __isize_rotate_right (value, count)

    /// Reverses the byte order.
    pub def swap_bytes = (value: ISize) => ISize :: __isize_swap_bytes value

    /// Reverses the bit order.
    pub def reverse_bits = (value: ISize) => ISize :: __isize_reverse_bits value

    /// Reinterprets the bits as the unsigned type of the same width.
    pub def cast_unsigned = (value: ISize) => USize :: __isize_cast_sign value

    /// Returns -1, 0, or 1 according to the sign of `value`.
    pub def signum = (value: ISize) => ISize :: when {
        value < 0 => ((ISize :: 0) - 1),
        value > 0 => 1,
        else => 0,
    }

    /// Returns whether `value` is negative.
    pub def is_negative = (value: ISize) => Bool :: value < 0

    /// Returns whether `value` is positive.
    pub def is_positive = (value: ISize) => Bool :: value > 0
}

// ---------------------------------------------------------------------------
// USize math
// ---------------------------------------------------------------------------

companion USize {
    use package.alloc.MemLayout
    use package.convert.(ConversionError, TryConvert)
    use package.ops.(BitAnd, BitNot, ShiftLeft, ShiftRight)
    use package.option.(Option, Some, None)
    use package.result.(Ok, Result)
    use package.process.(panic)
    use package.source.(track_caller)

    extern "staple-intrinsic" {
        __usize_overflowing_add: (USize, USize) -> (U8, USize)
        __usize_overflowing_subtract: (USize, USize) -> (U8, USize)
        __usize_overflowing_multiply: (USize, USize) -> (U8, USize)
        __usize_count_ones: USize -> U32
        __usize_leading_zeros: USize -> U32
        __usize_trailing_zeros: USize -> U32
        __usize_swap_bytes: USize -> USize
        __usize_reverse_bits: USize -> USize
        __usize_rotate_left: (USize, U32) -> USize
        __usize_rotate_right: (USize, U32) -> USize
        __usize_cast_sign: USize -> ISize
    }

    def bits = () => U32 :: match (TryConvert.try_convert.<USize, U32> (MemLayout.stride.<USize> () * 8)) {
        Ok value => value,
        _ => 0,
    }

    def max_value = () => USize :: BitNot.bit_not (USize :: 0)

    /// Returns the smaller of two values.
    pub def min = (left: USize; right: USize) => USize :: if (left < right) { left } else { right }

    /// Returns the larger of two values.
    pub def max = (left: USize; right: USize) => USize :: if (left > right) { left } else { right }

    /// Constrains `value` to the inclusive range `lo ..= hi`. Panics at the
    /// caller when `lo > hi`.
    @track_caller
    pub def clamp = (value: USize; lo: USize; hi: USize) => USize :: {
        if (lo > hi) {
            panic "clamp: invalid bounds"
        }
        if (value < lo) {
            lo
        } else if (value > hi) {
            hi
        } else {
            value
        }
    }

    /// Returns the absolute difference between two values.
    pub def abs_diff = (left: USize; right: USize) => USize :: if (left < right) { right - left } else { left - right }

    /// Returns the wrapped result and whether the addition overflowed.
    pub def overflowing_add = (left: USize; right: USize) => (USize, Bool) :: {
        let (status, value) = __usize_overflowing_add (left, right)
        (value, status != 0)
    }

    /// Returns the wrapped result and whether the subtraction overflowed.
    pub def overflowing_subtract = (left: USize; right: USize) => (USize, Bool) :: {
        let (status, value) = __usize_overflowing_subtract (left, right)
        (value, status != 0)
    }

    /// Returns the wrapped result and whether the multiplication overflowed.
    pub def overflowing_multiply = (left: USize; right: USize) => (USize, Bool) :: {
        let (status, value) = __usize_overflowing_multiply (left, right)
        (value, status != 0)
    }

    /// Returns `left + right`, or `None` on overflow.
    pub def checked_add = (left: USize; right: USize) => Option<USize> :: {
        let (status, value) = __usize_overflowing_add (left, right)
        if (status == 0) { Some value } else { None }
    }

    /// Returns `left - right`, or `None` on underflow.
    pub def checked_subtract = (left: USize; right: USize) => Option<USize> :: {
        let (status, value) = __usize_overflowing_subtract (left, right)
        if (status == 0) { Some value } else { None }
    }

    /// Returns `left * right`, or `None` on overflow.
    pub def checked_multiply = (left: USize; right: USize) => Option<USize> :: {
        let (status, value) = __usize_overflowing_multiply (left, right)
        if (status == 0) { Some value } else { None }
    }

    /// Returns `left + right`, wrapping on overflow.
    pub def wrapping_add = (left: USize; right: USize) => USize :: left + right

    /// Returns `left - right`, wrapping on underflow.
    pub def wrapping_subtract = (left: USize; right: USize) => USize :: left - right

    /// Returns `left * right`, wrapping on overflow.
    pub def wrapping_multiply = (left: USize; right: USize) => USize :: left * right

    /// Returns the low and high halves of the exact product.
    pub def widening_multiply = (left: USize; right: USize) => (low: USize, high: USize) :: {
        let (low, high) = if (bits () == 64) {
            U64.widening_multiply (left as U64) (right as U64)
        } else {
            // A narrower product is exact in U64; split it at the USize width.
            let product = (left as U64) * (right as U64)
            let width = U64.wrapping_shift_left 1 (bits ())
            (low: product % width, high: product / width)
        }
        let low: USize = match (TryConvert.try_convert.<U64, USize> low) {
            Ok value => value,
            _ => 0,
        }
        let high: USize = match (TryConvert.try_convert.<U64, USize> high) {
            Ok value => value,
            _ => 0,
        }
        (low: low, high: high)
    }

    /// Returns `value` shifted left by `count`, or `None` when the count is not
    /// smaller than the width.
    pub def checked_shift_left = (value: USize; count: U32) => Option<USize> :: {
        if (count >= bits ()) { None } else { Some (wrapping_shift_left value count) }
    }

    /// Returns `value` shifted right by `count`, or `None` when the count is
    /// not smaller than the width.
    pub def checked_shift_right = (value: USize; count: U32) => Option<USize> :: {
        if (count >= bits ()) { None } else { Some (wrapping_shift_right value count) }
    }

    /// Returns `value` shifted left by `count`, reducing the count modulo the
    /// width.
    pub def wrapping_shift_left = (value: USize; count: U32) => USize :: {
        let shift = count % bits ()
        let amount: USize = shift as USize
        ShiftLeft.shift_left (value; amount)
    }

    /// Returns `value` shifted right by `count`, reducing the count modulo the
    /// width.
    pub def wrapping_shift_right = (value: USize; count: U32) => USize :: {
        let shift = count % bits ()
        let amount: USize = shift as USize
        ShiftRight.shift_right (value; amount)
    }

    /// Returns `left + right`, saturating at the type's bounds.
    pub def saturating_add = (left: USize; right: USize) => USize :: {
        let (status, value) = __usize_overflowing_add (left, right)
        if (status == 0) { value } else { max_value () }
    }

    /// Returns `left - right`, saturating at the type's bounds.
    pub def saturating_subtract = (left: USize; right: USize) => USize :: {
        let (status, value) = __usize_overflowing_subtract (left, right)
        if (status == 0) { value } else { 0 }
    }

    /// Returns `left * right`, saturating at the type's bounds.
    pub def saturating_multiply = (left: USize; right: USize) => USize :: {
        let (status, value) = __usize_overflowing_multiply (left, right)
        if (status == 0) { value } else { max_value () }
    }

    /// Returns `left / right`, or `None` for a zero divisor.
    pub def checked_divide = (left: USize; right: USize) => Option<USize> :: {
        if (right == 0) { None } else { Some (left / right) }
    }

    /// Returns `left % right`, or `None` for a zero divisor.
    pub def checked_remainder = (left: USize; right: USize) => Option<USize> :: {
        if (right == 0) { None } else { Some (left % right) }
    }

    /// Returns the Euclidean quotient of `left / right`. Panics at the caller
    /// for a zero divisor.
    @track_caller
    pub def divide_euclid = (left: USize; right: USize) => USize :: left / right

    /// Returns the Euclidean remainder of `left / right`. Panics at the caller
    /// for a zero divisor.
    @track_caller
    pub def remainder_euclid = (left: USize; right: USize) => USize :: left % right

    /// Returns the quotient rounded up. Panics at the caller for a zero
    /// divisor.
    @track_caller
    pub def divide_ceil = (left: USize; right: USize) => USize :: {
        let quotient = left / right
        if (left % right == 0) { quotient } else { quotient + 1 }
    }

    /// Returns `base` raised to `exponent`, wrapping like `*`.
    pub def pow = (base: USize; exponent: U32) => USize :: {
        let mut result: USize = 1
        let mut factor = base
        let mut remaining = exponent
        while (remaining > 0) {
            if (BitAnd.bit_and (remaining; 1) == 1) {
                result = result * factor
            }
            remaining = ShiftRight.shift_right (remaining; 1)
            if (remaining > 0) {
                factor = factor * factor
            }
        }
        result
    }

    /// Returns `base` raised to `exponent`, or `None` on overflow.
    pub def checked_pow = (base: USize; exponent: U32) => Option<USize> :: {
        let mut result: Option<USize> = Some 1
        let mut factor: Option<USize> = Some base
        let mut remaining = exponent
        while (remaining > 0) {
            if (BitAnd.bit_and (remaining; 1) == 1) {
                result = match (result, factor) {
                    (Some value, Some power) => checked_multiply value power,
                    _ => None,
                }
            }
            remaining = ShiftRight.shift_right (remaining; 1)
            if (remaining > 0) {
                factor = match factor {
                    Some value => checked_multiply value value,
                    None => None,
                }
            }
        }
        result
    }

    /// Returns `base` raised to `exponent`, saturating at the type's bounds.
    pub def saturating_pow = (base: USize; exponent: U32) => USize :: {
        let mut result: USize = 1
        let mut factor = base
        let mut remaining = exponent
        while (remaining > 0) {
            if (BitAnd.bit_and (remaining; 1) == 1) {
                result = saturating_multiply result factor
            }
            remaining = ShiftRight.shift_right (remaining; 1)
            if (remaining > 0) {
                factor = saturating_multiply factor factor
            }
        }
        result
    }

    /// Returns the integer square root.
    @track_caller
    pub def isqrt = (value: USize) => USize :: {
        if (value < 2) {
            value
        } else {
            let mut x = value / 2 + 1
            let mut y = (x + value / x) / 2
            while (y < x) {
                x = y
                y = (x + value / x) / 2
            }
            x
        }
    }

    /// Returns the base-2 logarithm. Panics at the caller for zero.
    @track_caller
    pub def ilog2 = (value: USize) => U32 :: {
        if (value == 0) {
            panic "ilog2: zero value"
        } else {
            bits () - 1 - leading_zeros value
        }
    }

    /// Returns the base-10 logarithm. Panics at the caller for zero.
    @track_caller
    pub def ilog10 = (value: USize) => U32 :: {
        if (value == 0) {
            panic "ilog10: zero value"
        }
        let mut remaining = value
        let mut result: U32 = 0
        while (remaining >= 10) {
            remaining = remaining / 10
            result = result + 1
        }
        result
    }

    /// Returns the base-2 logarithm, or `None` for zero.
    pub def checked_ilog2 = (value: USize) => Option<U32> :: {
        if (value == 0) { None } else { Some (ilog2 value) }
    }

    /// Returns the base-10 logarithm, or `None` for zero.
    pub def checked_ilog10 = (value: USize) => Option<U32> :: {
        if (value == 0) { None } else { Some (ilog10 value) }
    }

    /// Returns the number of one bits.
    pub def count_ones = (value: USize) => U32 :: __usize_count_ones value

    /// Returns the number of zero bits.
    pub def count_zeros = (value: USize) => U32 :: bits () - count_ones value

    /// Returns the number of leading zero bits.
    pub def leading_zeros = (value: USize) => U32 :: __usize_leading_zeros value

    /// Returns the number of trailing zero bits.
    pub def trailing_zeros = (value: USize) => U32 :: __usize_trailing_zeros value

    /// Returns the number of leading one bits.
    pub def leading_ones = (value: USize) => U32 :: leading_zeros (BitNot.bit_not value)

    /// Returns the number of trailing one bits.
    pub def trailing_ones = (value: USize) => U32 :: trailing_zeros (BitNot.bit_not value)

    /// Rotates the bits left by `count`, reducing the count modulo the width.
    pub def rotate_left = (value: USize; count: U32) => USize :: __usize_rotate_left (value, count)

    /// Rotates the bits right by `count`, reducing the count modulo the width.
    pub def rotate_right = (value: USize; count: U32) => USize :: __usize_rotate_right (value, count)

    /// Reverses the byte order.
    pub def swap_bytes = (value: USize) => USize :: __usize_swap_bytes value

    /// Reverses the bit order.
    pub def reverse_bits = (value: USize) => USize :: __usize_reverse_bits value

    /// Reinterprets the bits as the signed type of the same width.
    pub def cast_signed = (value: USize) => ISize :: __usize_cast_sign value

    /// Returns whether `value` is a power of two.
    pub def is_power_of_two = (value: USize) => Bool :: value != 0 && (BitAnd.bit_and (value; value - 1)) == 0

    /// Returns the smallest power of two greater than or equal to `value`,
    /// wrapping to zero past the top.
    pub def next_power_of_two = (value: USize) => USize :: {
        if (value <= 1) {
            1
        } else {
            let mut result: USize = 1
            while (result < value && result != 0) {
                result = ShiftLeft.shift_left (result; 1)
            }
            result
        }
    }

    /// Returns the smallest power of two greater than or equal to `value`, or
    /// `None` when it does not fit.
    pub def checked_next_power_of_two = (value: USize) => Option<USize> :: {
        let result = next_power_of_two value
        if (result == 0) { None } else { Some result }
    }

    /// Adds a signed value, or returns `None` when the result is out of range.
    pub def checked_add_signed = (left: USize; right: ISize) => Option<USize> :: {
        if (right >= 0) {
            let amount: USize = match (TryConvert.try_convert.<ISize, USize> right) {
                Ok value => value,
                _ => 0,
            }
            checked_add left amount
        } else {
            let negated = 0 - right
            let amount: USize = if (negated < 0) {
                (max_value () / 2) + 1
            } else {
                match (TryConvert.try_convert.<ISize, USize> negated) {
                    Ok value => value,
                    _ => 0,
                }
            }
            checked_subtract left amount
        }
    }
}

// ---------------------------------------------------------------------------
// F32 math
// ---------------------------------------------------------------------------

companion F32 {
    use package.source.(track_caller)
    use package.process.(panic)

    extern "staple-intrinsic" {
        __f32_from_bits: U32 -> F32
        __f32_to_bits: F32 -> U32
        __f32_floor: F32 -> F32
        __f32_ceil: F32 -> F32
        __f32_trunc: F32 -> F32
        __f32_round: F32 -> F32
        __f32_round_even: F32 -> F32
        __f32_abs: F32 -> F32
        __f32_sqrt: F32 -> F32
        __f32_min: (F32, F32) -> F32
        __f32_max: (F32, F32) -> F32
        __f32_copysign: (F32, F32) -> F32
        __f32_mul_add: (F32, F32, F32) -> F32
    }

    /// The difference between 1.0 and the next larger representable value.
    pub const Epsilon: F32 = 1.19209290e-7
    /// The smallest finite value (the most negative finite value).
    pub const Min: F32 = from_bits 4286578687
    /// The largest finite value.
    pub const Max: F32 = 3.40282347e38
    /// The smallest positive normal value.
    pub const MinPositive: F32 = 1.17549435e-38
    /// The ratio of a circle's circumference to its diameter.
    pub const Pi: F32 = 3.14159265
    /// Euler's number.
    pub const E: F32 = 2.71828183
    /// A quiet NaN.
    pub const NaN: F32 = from_bits 2143289344
    /// Positive infinity.
    pub const Infinity: F32 = from_bits 2139095040
    /// Negative infinity.
    pub const NegInfinity: F32 = from_bits 4286578688

    /// Reinterprets an unsigned 32-bit pattern as a float.
    pub def from_bits = bits: U32 => F32 :: __f32_from_bits bits

    /// Reinterprets a float as its unsigned 32-bit pattern.
    pub def to_bits = value: F32 => U32 :: __f32_to_bits value

    /// Returns the largest integer less than or equal to `value`.
    pub def floor = value: F32 => F32 :: __f32_floor value

    /// Returns the smallest integer greater than or equal to `value`.
    pub def ceil = value: F32 => F32 :: __f32_ceil value

    /// Returns the integer part of `value`, rounding toward zero.
    pub def trunc = value: F32 => F32 :: __f32_trunc value

    /// Rounds `value` to the nearest integer, with ties away from zero.
    pub def round = value: F32 => F32 :: __f32_round value

    /// Rounds `value` to the nearest integer, with ties to even.
    pub def round_even = value: F32 => F32 :: __f32_round_even value

    /// Returns the absolute value of `value`.
    pub def abs = value: F32 => F32 :: __f32_abs value

    /// Returns the square root of `value`; negative inputs produce NaN.
    pub def sqrt = value: F32 => F32 :: __f32_sqrt value

    /// Returns the natural logarithm of `value`; non-positive inputs produce
    /// negative infinity or NaN.
    pub def ln = value: F32 => F32 :: c_logf value

    /// Returns Euler's number raised to `value`.
    pub def exp = value: F32 => F32 :: c_expf value

    /// Returns the fractional part of `value` (`value - trunc value`).
    pub def fract = value: F32 => F32 :: value - trunc value

    /// Returns `value` with the sign of `sign`.
    pub def copysign = (value: F32; sign: F32) => F32 :: __f32_copysign (value, sign)

    /// Returns the smaller value, ignoring a NaN operand.
    pub def min = (left: F32; right: F32) => F32 :: __f32_min (left, right)

    /// Returns the larger value, ignoring a NaN operand.
    pub def max = (left: F32; right: F32) => F32 :: __f32_max (left, right)

    /// Constrains `value` to the inclusive range `lo ..= hi`. Panics at the
    /// caller when `lo > hi` or either bound is NaN.
    @track_caller
    pub def clamp = (value: F32; lo: F32; hi: F32) => F32 :: {
        // A NaN bound makes `lo <= hi` false as well.
        if (!(lo <= hi)) {
            panic "clamp: invalid bounds"
        }
        if (value < lo) {
            lo
        } else if (value > hi) {
            hi
        } else {
            value
        }
    }

    /// Returns `value * a + b`, rounded once.
    pub def mul_add = (value: F32; a: F32; b: F32) => F32 :: __f32_mul_add (value, a, b)

    /// Returns the non-negative remainder of `left / right`.
    pub def remainder_euclid = (left: F32; right: F32) => F32 :: {
        let remainder = left % right
        if (remainder >= 0.0) {
            remainder
        } else {
            // A tiny negative remainder can round up to `abs right` itself,
            // which is outside `[0, abs right)`.
            let adjusted = remainder + abs right
            if (adjusted == abs right) { 0.0 } else { adjusted }
        }
    }

    /// Returns the quotient of Euclidean division of `left` by `right`: the
    /// truncated quotient, moved one step away from zero's direction when the
    /// truncated remainder is negative.
    pub def divide_euclid = (left: F32; right: F32) => F32 :: {
        let quotient = trunc (left / right)
        if (left % right >= 0.0) {
            quotient
        } else if (right > 0.0) {
            quotient - 1.0
        } else {
            quotient + 1.0
        }
    }

    /// Returns whether `value` is NaN.
    pub def is_nan = value: F32 => Bool :: value != value

    /// Returns whether `value` is positive or negative infinity.
    pub def is_infinite = value: F32 => Bool :: abs value == Infinity

    /// Returns whether `value` is neither NaN nor infinite.
    pub def is_finite = value: F32 => Bool :: abs value < Infinity

    /// Returns whether `value` has its sign bit set.
    pub def is_sign_negative = value: F32 => Bool :: to_bits value >= 2147483648
}

