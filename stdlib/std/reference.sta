pub mod

use package.recursive_constructor.recursive_constructor

use package.cmp.(Eq)

/// A managed mutable reference to a value.
@recursive_constructor
pub type Ref T where ?Sized T = pub wrap T

extern "staple-intrinsic" {
    __ref_replace: <T> (mut Ref T; move T) -> T
}

companion<T> Ref T {
    /// Replaces the referenced value and returns the old value.
    pub def replace = (mut reference: Ref T; move value: T) => T :: __ref_replace reference value
}

impl<T where Eq T> Eq (Ref T) {
    eq = (Ref left; Ref right) => Eq.eq (left; right)
}
