@interpreted_only
impl<Element, Separator> Splice Separated<Element, Separator> { splice = value => __splice_node.<Separated<Element, Separator>> value }
@interpreted_only
impl Splice TypeParameter { splice = value => __splice_node.<TypeParameter> value }
@interpreted_only
impl Splice TypeParameters { splice = value => __splice_node.<TypeParameters> value }
