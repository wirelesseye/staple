impl FromMatch () { from_match = _ => () }

@compiled_only
impl FromMatch MacroCallMetadata {
    from_match = node => MacroCallMetadata (
        modifiers: FromMatch.from_match.<Sequence<Modifier>> (__match_child (node, 0)),
        visibility: FromMatch.from_match.<Visibility> (__match_child (node, 1)),
    )
}

@compiled_only
impl<T where FromMatch T> FromMatch Option<T> {
    from_match = node => match (__match_kind node == 2) {
        True => {
            let absent: Option<T> = None
            absent
        },
        False => {
            let found: Option<T> = Some (FromMatch.from_match.<T> node)
            found
        },
    }
}

// Built from the last element, so each cell is allocated once.
@compiled_only
impl<T where FromMatch T> FromMatch Sequence<T> {
    from_match = node => {
        let mut cells: Sequence<T> = Sequence ()
        let mut index = __match_count node
        loop {
            match (index == 0) {
                True => { break },
                False => {
                    index = index - 1
                    cells = Sequence (first: FromMatch.from_match.<T> (__match_child (node, index)), rest: cells)
                },
            }
        }
        cells
    }
}

// A list of the elements, the separator, and the trailing separator or an
// absent node.
@compiled_only
impl<Element, Separator where FromMatch Element, FromMatch Separator> FromMatch Separated<Element, Separator> {
    from_match = node => {
        let list: Separated<Element, Separator> = Separated (
            separator: FromMatch.from_match.<Separator> (__match_child (node, 1)),
            elements: FromMatch.from_match.<Sequence<Element>> (__match_child (node, 0)),
            trailing: __match_kind (__match_child (node, 2)) != 2,
        )
        list
    }
}

@compiled_only
impl<C where FromMatch C> FromMatch Parenthesized<C> {
    from_match = node => __with_origin (Parenthesized (FromMatch.from_match.<C> (__match_child (node, 0))), __match_syntax node)
}

@compiled_only
impl<C where FromMatch C> FromMatch Bracketed<C> {
    from_match = node => __with_origin (Bracketed (FromMatch.from_match.<C> (__match_child (node, 0))), __match_syntax node)
