        node: TypeDeclarationItem => Splice.splice node,
        node: UnstructuredItem => Splice.splice node,
        node: Private => __visibility_syntax 0,
        node: Package => __visibility_syntax 1,
        node: Public => __visibility_syntax 2,
        node: Comma => Splice.splice node,
        node: Equals => Splice.splice node,
        node: FatArrow => Splice.splice node,
        node: TypeParameter => Splice.splice node,
