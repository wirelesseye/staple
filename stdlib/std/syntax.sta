// Leaf syntax nodes: each consumes the longest node the grammar accepts from
// the cursor and stops where the grammar stops. The interpreter reads them
// through `__parse_primitive`; compiled code uses the host leaf parser.
@interpreted_only
impl Parse Expr { parse = mut input => __parse_primitive.<Expr> input }
@interpreted_only
impl Parse CallExpr { parse = mut input => __parse_primitive.<CallExpr> input }
@interpreted_only
impl Parse CharExpr { parse = mut input => __parse_primitive.<CharExpr> input }
@interpreted_only
impl Parse StringExpr { parse = mut input => __parse_primitive.<StringExpr> input }
@interpreted_only
impl Parse UnstructuredExpr { parse = mut input => __parse_primitive.<UnstructuredExpr> input }
@interpreted_only
impl Parse Type { parse = mut input => __parse_primitive.<Type> input }
@interpreted_only
impl Parse ProductType { parse = mut input => __parse_primitive.<ProductType> input }
@interpreted_only
impl Parse UnstructuredType { parse = mut input => __parse_primitive.<UnstructuredType> input }
@interpreted_only
impl Parse Pattern { parse = mut input => __parse_primitive.<Pattern> input }
@interpreted_only
impl Parse BindingPattern { parse = mut input => __parse_primitive.<BindingPattern> input }
@interpreted_only
impl Parse NominalPattern { parse = mut input => __parse_primitive.<NominalPattern> input }
@interpreted_only
impl Parse Item { parse = mut input => __parse_primitive.<Item> input }
@interpreted_only
impl Parse ModifiedItem { parse = mut input => __parse_primitive.<ModifiedItem> input }
@interpreted_only
impl Parse TypeDeclarationItem { parse = mut input => __parse_primitive.<TypeDeclarationItem> input }
@interpreted_only
impl Parse UnstructuredItem { parse = mut input => __parse_primitive.<UnstructuredItem> input }
@interpreted_only
impl Parse Modifier { parse = mut input => __parse_primitive.<Modifier> input }
@interpreted_only
impl Parse ModifierCall { parse = mut input => __parse_primitive.<ModifierCall> input }
@interpreted_only
impl Parse UnstructuredModifier { parse = mut input => __parse_primitive.<UnstructuredModifier> input }
@interpreted_only
impl Parse TypeBody { parse = mut input => __parse_primitive.<TypeBody> input }
@interpreted_only
impl Parse TypeParameter { parse = mut input => __parse_primitive.<TypeParameter> input }
@interpreted_only
impl Parse TypeParameters { parse = mut input => __parse_primitive.<TypeParameters> input }
// One token, checked against the spelling the type names.
@interpreted_only
impl<S where S <: String> Parse Ident<S> { parse = mut input => __parse_primitive.<Ident<S>> input }
@interpreted_only
impl Parse Comma { parse = mut input => __parse_primitive.<Comma> input }
@interpreted_only
impl Parse Equals { parse = mut input => __parse_primitive.<Equals> input }
@interpreted_only
impl Parse FatArrow { parse = mut input => __parse_primitive.<FatArrow> input }
// `pub` or `pub(package)`; with neither present, nothing is consumed and the
// result is `Private`.
@interpreted_only
impl Parse Visibility { parse = mut input => __parse_primitive.<Visibility> input }
// Exactly one shortest structural atom; a balanced group counts as one atom.
@interpreted_only
impl Parse SyntaxNode { parse = mut input => __parse_primitive.<SyntaxNode> input }

// The host's leaf codes, in the order the implementations below use them:
// 1 `Expr`, 2 `CallExpr`, 3 `CharExpr`, 4 `StringExpr`, 5 `UnstructuredExpr`,
// 6 `Type`, 7 `ProductType`, 8 `UnstructuredType`, 9 `Pattern`, 10
// `BindingPattern`, 11 `NominalPattern`, 12 `Item`, 13 `ModifiedItem`, 14
// `TypeDeclarationItem`, 15 `UnstructuredItem`, 16 `Modifier`, 17
// `ModifierCall`, 18 `UnstructuredModifier`, 19 `TypeBody`, 20
// `TypeParameter`, 21 `TypeParameters`, 22 `Ident`, 23 `Comma`, 24 `Equals`,
// 25 `FatArrow`, 26 `Visibility`, 27 `SyntaxNode`.
@compiled_only
def call_expr_from_syntax = syntax: Syntax => CallExpr :: match (expr_from_syntax syntax) {
    node: CallExpr => node,
    _ => panic "a call parse produced syntax that is not a call",
}

@compiled_only
def char_expr_from_syntax = syntax: Syntax => CharExpr ::
    __with_origin (CharExpr (Char.from_u32_unchecked (__char_expr_char syntax)), syntax)

@compiled_only
def string_expr_from_syntax = syntax: Syntax => StringExpr ::
    __with_origin (StringExpr (text_string (__string_expr_text syntax)), syntax)

@compiled_only
def syntax_node_from_syntax = (tag: U64; syntax: Syntax) => SyntaxNode :: {
    match (tag == 1) {
        True => {
            let value: Expr = expr_from_syntax syntax
            let node: SyntaxNode = match value {
                node: Ident<String> => node,
                node: CallExpr => node,
                node: StringExpr => node,
                node: CharExpr => node,
                node: UnstructuredExpr => node,
            }
            node
        },
        False => match (tag == 2) {
            True => Comma,
            False => match (tag == 3) {
                True => Equals,
                False => match (tag == 4) {
                    True => FatArrow,
                    False => match (tag == 5) {
                        True => __with_origin (Parenthesized (__delimiter_contents syntax), syntax),
                        False => match (tag == 6) {
                            True => __with_origin (Bracketed (__delimiter_contents syntax), syntax),
                            False => match (tag == 7) {
                                True => __with_origin (Braced (__delimiter_contents syntax), syntax),
                                False => match (tag == 8) {
                                    True => item_from_syntax syntax,
                                    False => match (tag == 9) {
                                        True => type_from_syntax syntax,
                                        False => pattern_from_syntax syntax,
                                    },
                                },
                            },
                        },
                    },
                },
            },
        },
    }
}

