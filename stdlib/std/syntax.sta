}





@compiled_only
pub def type_declaration_from_syntax = syntax: Syntax => TypeDeclarationItem :: {
    let name = __type_declaration_name syntax
    let declared_type = __type_declaration_declared_type syntax
    let type_parameter_count = __type_declaration_type_parameter_count syntax
    let body = __type_declaration_body syntax
    let resource_count = __type_declaration_resource_count syntax
    let mut type_parameters: Sequence<Ident<String>> = Sequence ()
    let mut index = type_parameter_count
    loop {
        match (index == 0) {
            True => { break },
            False => {
                index = index - 1
                let parameter = __type_declaration_type_parameter (syntax, index)
                type_parameters = Sequence (first: ident_from_syntax parameter, rest: type_parameters)
            },
        }
    }
    let body_value: Option<TypeBody> = match (__syntax_is_empty body == 1) {
        True => None,
        False => Some (type_body_from_syntax body),
    }
    let mut resources: Sequence<ResourceDependency> = Sequence ()
    let mut index = resource_count
    loop {
        match (index == 0) {
            True => { break },
            False => {
                index = index - 1
                let (resource_type; mutable) = __type_declaration_resource (syntax, index)
                let dependency = ResourceDependency (resource_type: type_from_syntax resource_type, mutable: mutable == 1)
                resources = Sequence (first: dependency, rest: resources)
            },
        }
    }
    __with_origin (TypeDeclarationItem (name: ident_from_syntax name, declared_type: type_from_syntax declared_type, type_parameters: type_parameters, body: body_value, resource_dependencies: resources), syntax)
}

@compiled_only
pub def modified_item_from_syntax = syntax: Syntax => ModifiedItem :: {
    let (count; item) = __modified_item_parts syntax
    let mut modifiers: Sequence<Modifier> = Sequence ()
    let mut index = count
    loop {
        match (index == 0) {
            True => { break },
            False => {
                index = index - 1
                let modifier = __modified_item_modifier (syntax, index)
                modifiers = Sequence (first: modifier_from_syntax modifier, rest: modifiers)
