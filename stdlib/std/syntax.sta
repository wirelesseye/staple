@compiled_only
pub def modifier_call_from_syntax = syntax: Syntax => ModifierCall :: {
    let namespace_count = __modifier_call_namespace_count syntax
    let name = __modifier_call_name syntax
    let argument = __modifier_call_argument syntax
    let mut namespace: Sequence<Ident<String>> = Sequence ()
    let mut index = namespace_count
    loop {
        match (index == 0) {
            True => { break },
            False => {
                index = index - 1
                let part = __modifier_call_namespace (syntax, index)
                namespace = Sequence (first: ident_from_syntax part, rest: namespace)
            },
        }
    }
    let argument_value: Option<Syntax> = match (__syntax_is_empty argument == 1) {
        True => None,
        False => Some argument,
    }
    __with_origin (ModifierCall (namespace: namespace, name: ident_from_syntax name, argument: argument_value), syntax)
}

@compiled_only
