    /// Rebuilds an identifier, or returns its origin when unchanged.
    __ident_syntax: (Syntax, U64) -> Syntax
    /// Rebuilds a string-literal expression, or returns its origin when unchanged.
    __string_expr_syntax: (Syntax, U64) -> Syntax
    /// Rebuilds a character-literal expression, or returns its origin when unchanged.
