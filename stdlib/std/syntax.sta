impl<S where S <: String> FromMatch Ident<S> { from_match = node => match_leaf.<Ident<S>> node }

@compiled_only
impl FromMatch Syntax { from_match = node => __match_syntax node }

@compiled_only
impl FromMatch Comma { from_match = _ => Comma }

@compiled_only
impl FromMatch Equals { from_match = _ => Equals }

@compiled_only
impl FromMatch FatArrow { from_match = _ => FatArrow }

