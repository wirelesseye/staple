// Compiled, a clone shares no box with the original apart from `Copy` nodes and
// handles, so assigning to one leaves the other alone. Origins are kept, since
// an unchanged clone must still rebuild to its original tokens.

@compiled_only
def clone_option: <T where Clone T> Option<T> -> Option<T> = <T where Clone T> value => match value {
    None => None,
    Some item => Some (Clone.clone item),
}

// Loops rather than recursing, so a long sequence doesn't use deep stack. A
// borrow can't be rebound, so the walk owns one copy of the top box and moves
// down from there. It only reads what it moves, which the original still owns.
@compiled_only
impl<T where Clone T> Clone Sequence<T> {
    clone = value => {
        let mut cloned: Sequence<T> = Sequence ()
        let mut cursor: Sequence<T> = __with_origin (value, __origin value)
        let mut end_origin = __origin value
        loop {
            let origin = __origin cursor
            match cursor {
                Sequence () => {
                    end_origin = origin
                    break
                },
                Sequence (first, rest) => {
                    cloned = __with_origin (Sequence (first: Clone.clone first, rest: cloned), origin)
                    cursor = rest
                },
            }
        }
        let mut result: Sequence<T> = __with_origin (Sequence<T> :: Sequence (), end_origin)
        loop {
            let origin = __origin cloned
            match cloned {
                Sequence () => { break },
                Sequence (first, rest) => {
                    result = __with_origin (Sequence (first: first, rest: result), origin)
                    cloned = rest
                },
            }
        }
        result
    }
}

@compiled_only
impl<Element, Separator where Clone Element, Clone Separator> Clone Separated<Element, Separator> {
    clone = value => __with_origin (
        Separated (separator: Clone.clone (value.separator), elements: Clone.clone (value.elements), trailing: value.trailing),
        __origin value
    )
}

@compiled_only
impl Clone CallExpr {
    clone = value => __with_origin (
        CallExpr (callee: Clone.clone (value.callee), argument: Clone.clone (value.argument)),
        __origin value
    )
}

@compiled_only
impl Clone StringExpr {
    clone = value => __with_origin (
        StringExpr (value.*),
        __origin value
    )
}

@compiled_only
impl Clone CharExpr {
    clone = value => __with_origin (
        CharExpr (value.*),
        __origin value
    )
}

@compiled_only
impl<C where Clone C> Clone Parenthesized<C> {
    clone = value => __with_origin (
        Parenthesized (Clone.clone (value.*)),
        __origin value
    )
}

@compiled_only
impl<C where Clone C> Clone Bracketed<C> {
    clone = value => __with_origin (
        Bracketed (Clone.clone (value.*)),
        __origin value
    )
}

@compiled_only
impl<C where Clone C> Clone Braced<C> {
    clone = value => __with_origin (
        Braced (Clone.clone (value.*)),
        __origin value
    )
}

@compiled_only
impl<C where Clone C> Clone Angled<C> {
    clone = value => __with_origin (
        Angled (Clone.clone (value.*)),
        __origin value
    )
}

@compiled_only
impl Clone TypeParameter {
    clone = value => __with_origin (
        TypeParameter (name: value.name, default: clone_option (value.default), declaration: Clone.clone (value.declaration), argument: Clone.clone (value.argument)),
        __origin value
    )
}

@compiled_only
impl Clone TypeParameters {
    clone = value => __with_origin (
        TypeParameters (parameters: Clone.clone (value.parameters), declaration: Clone.clone (value.declaration), arguments: Clone.clone (value.arguments), bounds: Clone.clone (value.bounds)),
        __origin value
    )
}

@compiled_only
impl Clone ProductTypeField {
    clone = value => ProductTypeField (name: value.name, field_type: Clone.clone (value.field_type), default: clone_option (value.default))
}

@compiled_only
impl Clone ProductType {
    clone = value => ProductType (Clone.clone (value.*))
}

@compiled_only
impl Clone BindingPattern {
    clone = value => __with_origin (
        BindingPattern (value.*),
        __origin value
    )
}

@compiled_only
impl Clone NominalPattern {
    clone = value => __with_origin (
        NominalPattern (name: value.name, argument: Clone.clone (value.argument)),
