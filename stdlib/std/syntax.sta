    )
}

@compiled_only
impl Clone TypeDeclarationItem {
    clone = value => __with_origin (
        TypeDeclarationItem (name: value.name, declared_type: Clone.clone (value.declared_type), type_parameters: Clone.clone.<Sequence<Ident<String>>> (value.type_parameters), body: clone_option (value.body), resource_dependencies: Clone.clone (value.resource_dependencies)),
        __origin value
    )
}

@compiled_only
impl Clone ResourceDependency {
    clone = value => ResourceDependency (resource_type: Clone.clone (value.resource_type), mutable: value.mutable)
}

@compiled_only
impl<Element where Clone Element> Clone AliasBody<Element> {
    clone = value => __with_origin (
        AliasBody (Clone.clone (value.*)),
        __origin value
    )
}

@compiled_only
impl<Representation, Element where Clone Representation, Clone Element> Clone WrapperBody<Representation, Element> {
    clone = value => __with_origin (
        WrapperBody (Clone.clone (value.0), Clone.clone (value.1)),
        __origin value
    )
}

