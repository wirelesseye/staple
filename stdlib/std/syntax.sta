    parse = mut input => {
        let a = Parse.parse.<A> input?
        match (is_empty input) {
            True => { },
            False => {
                let _ = Parse.parse.<Comma> input?
            },
        }
        let b = Parse.parse.<B> input?
        match (is_empty input) {
            True => Ok (a, b),
            False => {
                let _ = Parse.parse.<Comma> input?
                Ok (a, b)
