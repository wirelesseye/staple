        let c = Parse.parse.<C> input?
        match (is_empty input) {
            True => { },
            False => {
                let _ = Parse.parse.<Comma> input?
            },
        }
        let d = Parse.parse.<D> input?
        match (is_empty input) {
            True => { },
            False => {
                let _ = Parse.parse.<Comma> input?
            },
        }
        let e = Parse.parse.<E> input?
        match (is_empty input) {
            True => Ok (a, b, c, d, e),
            False => {
                let _ = Parse.parse.<Comma> input?
                Ok (a, b, c, d, e)
            },
        }
    }
}

