    False => match (__classify_type_body syntax == 1) {
        True => {
            let (representation; underlying) = __type_body_parts syntax
            __with_origin (WrapperBody (visibility_from_syntax representation, type_from_syntax underlying), syntax)
        },
        False => match (__classify_type_body syntax == 2) {
            True => {
                let (representation; underlying) = __type_body_parts syntax
                __with_origin (FromBody (visibility_from_syntax representation, type_from_syntax underlying), syntax)
            },
            False => OpaqueBody,
        },
    },
}

@compiled_only
pub def type_parameter_from_syntax = syntax: Syntax => TypeParameter :: {
