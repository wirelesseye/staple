// One token, checked against the spelling the type names.
@compiled_only
impl<S where S <: String> Parse Ident<S> {
    parse = mut input => {
        let expected = __ident_type_spelling.<S> ()
        let bytes = string_shared_bytes expected
        let spelling = __text_new (SharedBuffer.unsafe_data bytes, SharedBuffer.length bytes)
        let result = __parse_leaf (input, 22, spelling)
        match (__parse_result_status result == 1) {
            True => {
                let syntax = __parse_result_syntax result
                let parsed = __ident_spelling_value.<S> (text_string (__ident_text syntax))
                input = __parse_result_stream result
                Ok (__with_origin (Ident parsed, syntax))
            },
            False => ParseError (text_string (__parse_result_error result)),
        }
    }
}

// Exactly one shortest structural atom; a balanced group counts as one atom.
@compiled_only
impl Parse SyntaxNode {
    parse = mut input => {
        let result = __parse_leaf (input, 27, 0)
        match (__parse_result_status result == 1) {
            True => {
                let tag = __parse_result_tag result
                let syntax = __parse_result_syntax result
                input = __parse_result_stream result
                Ok (syntax_node_from_syntax ...(tag; syntax))
            },
            False => ParseError (text_string (__parse_result_error result)),
        }
    }
}

@interpreted_only
impl<C where Parse C> Parse Parenthesized<C> {
    parse = mut input => {
        let (source, inner) = __parenthesized_group input?
        let mut contents = inner
        let value = Parse.parse.<C> contents?
        match (is_empty contents) {
            True => Ok (__parenthesized.<C> (source, value)),
            False => error_at ...(contents; "unexpected syntax"),
        }
    }
}

@compiled_only
impl<C where Parse C> Parse Parenthesized<C> {
    parse = mut input => {
        let result = __parse_group (input, 0)
        match (__parse_result_status result == 1) {
            True => {
                let source = __parse_result_syntax result
                let mut inner = __parse_result_stream result
                match (Parse.parse.<C> inner) {
                    Ok value => match (is_empty inner) {
                        True => {
                            input = __parse_result_next result
                            Ok (__with_origin (Parenthesized value, source))
                        },
                        False => error_at ...(inner; "unexpected syntax"),
                    },
                    ParseError parse_error => ParseError parse_error,
                }
            },
            False => ParseError (text_string (__parse_result_error result)),
        }
    }
}

