impl<T> Iterator Sequence<T> {
    type Item = T
    next = move sequence => match sequence {
        Sequence () => Done (Sequence<T> :: Sequence ()),
        Sequence (first, rest) => Yield (first, rest),
    }
}

impl<T> IntoIterator Sequence<T> {
    type Iter = Sequence<T>
    into_iterator = move sequence => sequence
}

impl<T> Default (Sequence<T>) {
    default = () => Sequence ()
}

@interpreted_only
def sequence_reverse = <T> (move sequence: Sequence<T>) => Sequence<T> :: __sequence_reverse sequence

@compiled_only
def sequence_reverse = <T> (move sequence: Sequence<T>) => Sequence<T> :: {
    let mut result: Sequence<T> = Sequence ()
    let mut cursor = sequence
    loop {
        match cursor {
            Sequence () => { break },
            Sequence (first, rest) => {
                result = Sequence (first: first, rest: result)
                cursor = rest
            },
        }
    }
    result
}

@interpreted_only
def sequence_push = <T> (move sequence: Sequence<T>; move item: T) => Sequence<T> :: __sequence_push (sequence, item)

@compiled_only
def sequence_push = <T> (move sequence: Sequence<T>; move item: T) => Sequence<T> :: {
    let mut reversed: Sequence<T> = sequence_reverse sequence
    reversed = Sequence (first: item, rest: reversed)
    sequence_reverse reversed
}

impl<T> FromIterator Sequence<T> T {
    insert = (move sequence: Sequence<T>; move item: T) => Sequence<T> ::
        sequence_push ...(sequence; item)
}

// Elements until the stream ends or `T` stops parsing.
@interpreted_only
impl<T where Parse T> Parse Sequence<T> {
    parse = mut input => {
        let mut elements: Sequence<T> = Sequence<T> :: Sequence ()
        loop {
            match (is_empty input) {
                True => { break },
                False => (),
            }
            let mut fork = input
            let start = __offset fork
            match (Parse.parse.<T> fork) {
                Ok first => {
                    match (__offset fork == start) {
                        True => { break },
                        False => (),
                    }
                    input = fork
                    elements = Sequence (first: first, rest: elements)
                },
                ParseError _ => { break },
            }
        }
        Ok (sequence_reverse elements)
    }
}

// Comma-separated elements with an optional trailing comma.
@interpreted_only
impl<T where Parse T> Parse Separated<T, Comma> {
    parse = mut input => {
        let mut elements: Sequence<T> = Sequence<T> :: Sequence ()
        let mut trailing: Bool = False
        loop {
            match (is_empty input) {
                True => { break },
                False => (),
            }
            let mut fork = input
            let start = __offset fork
            let first = Parse.parse.<T> fork?
            match (__offset fork == start) {
                True => { break },
                False => (),
            }
            input = fork
            elements = Sequence (first: first, rest: elements)
            trailing = False
            match (is_empty input) {
                True => { break },
                False => (),
            }
            let _ = Parse.parse.<Comma> input?
            trailing = True
        }
        Ok (Separated (separator: Comma, elements: sequence_reverse elements, trailing: trailing))
    }
}

// Compiled, each cell keeps the span from its element to the end of the list
// as its origin, so an unchanged list splices back as the text it was read
// from, comments included.
@compiled_only
impl<T where Parse T> Parse Sequence<T> {
    parse = mut input => {
        let mut elements: Sequence<T> = Sequence<T> :: Sequence ()
        let mut starts: Sequence<ParseStream> = Sequence<ParseStream> :: Sequence ()
        let mut done = is_empty input
        loop {
            match done {
                True => { break },
                False => {
                    let mut fork = input
                    let start = __offset fork
                    match (Parse.parse.<T> fork) {
                        Ok first => match (__offset fork == start) {
                            True => { done = True },
                            False => {
                                starts = Sequence (first: input, rest: starts)
                                input = fork
                                elements = Sequence (first: first, rest: elements)
                                done = is_empty input
                            },
                        },
                        ParseError _ => { done = True },
                    }
                },
            }
        }
        let mut cells: Sequence<T> = Sequence<T> :: Sequence ()
        loop {
            match elements {
                Sequence () => { break },
                Sequence (first, rest) => {
                    match starts {
                        Sequence () => { break },
                        Sequence (start, earlier) => {
                            cells = __with_origin (Sequence (first: first, rest: cells), __stream_span (start, input))
                            starts = earlier
                        },
                    }
                    elements = rest
                },
            }
        }
        Ok cells
    }
}

// Compiled, the list keeps the span it was read from as its origin.
@compiled_only
impl<T where Parse T> Parse Separated<T, Comma> {
    parse = mut input => {
        let begin = input
        let mut elements: Sequence<T> = Sequence<T> :: Sequence ()
        let mut trailing: Bool = False
        let mut done = is_empty input
        loop {
            match done {
                True => { break },
                False => {
                    let mut fork = input
                    let start = __offset fork
                    let first = Parse.parse.<T> fork?
                    match (__offset fork == start) {
                        True => { done = True },
                        False => {
                            input = fork
                            elements = Sequence (first: first, rest: elements)
                            trailing = False
                            match (is_empty input) {
                                True => { done = True },
                                False => {
                                    let _ = Parse.parse.<Comma> input?
                                    trailing = True
                                    done = is_empty input
                                },
                            }
                        },
                    }
                },
            }
        }
        let list: Separated<T, Comma> = Separated (separator: Comma, elements: sequence_reverse elements, trailing: trailing)
        Ok (__with_origin (list, __stream_span (begin, input)))
    }
}

// The handle types copy only the handle: their fragments are immutable.
impl Clone Syntax { clone = value => __clone_syntax value }
impl Clone UnstructuredExpr { clone = value => __clone_syntax value }
impl Clone UnstructuredType { clone = value => __clone_syntax value }
impl Clone UnstructuredPattern { clone = value => __clone_syntax value }
impl Clone UnstructuredItem { clone = value => __clone_syntax value }
impl Clone UnstructuredModifier { clone = value => __clone_syntax value }

// The interpreter's values are immutable and carry their source, so a clone is
// the same value. Rebuilding one through its constructor would lose the source.
@interpreted_only
impl Clone CallExpr { clone = value => __clone_syntax value }
@interpreted_only
impl Clone StringExpr { clone = value => __clone_syntax value }
@interpreted_only
impl Clone CharExpr { clone = value => __clone_syntax value }
@interpreted_only
impl<T> Clone (Sequence<T>) { clone = value => __clone_syntax value }
@interpreted_only
impl<Element, Separator> Clone (Separated<Element, Separator>) { clone = value => __clone_syntax value }
@interpreted_only
impl<C> Clone (Parenthesized<C>) { clone = value => __clone_syntax value }
@interpreted_only
impl<C> Clone (Bracketed<C>) { clone = value => __clone_syntax value }
@interpreted_only
impl<C> Clone (Braced<C>) { clone = value => __clone_syntax value }
@interpreted_only
impl<C> Clone (Angled<C>) { clone = value => __clone_syntax value }
@interpreted_only
impl Clone TypeParameter { clone = value => __clone_syntax value }
@interpreted_only
impl Clone TypeParameters { clone = value => __clone_syntax value }
@interpreted_only
impl Clone ProductTypeField { clone = value => __clone_syntax value }
@interpreted_only
impl Clone ProductType { clone = value => __clone_syntax value }
@interpreted_only
impl Clone BindingPattern { clone = value => __clone_syntax value }
@interpreted_only
impl Clone NominalPattern { clone = value => __clone_syntax value }
@interpreted_only
impl Clone TypeDeclarationItem { clone = value => __clone_syntax value }
@interpreted_only
impl Clone ResourceDependency { clone = value => __clone_syntax value }
@interpreted_only
impl<Element> Clone (AliasBody<Element>) { clone = value => __clone_syntax value }
@interpreted_only
impl<Representation, Element> Clone (WrapperBody<Representation, Element>) { clone = value => __clone_syntax value }
@interpreted_only
impl<Representation, Element> Clone (FromBody<Representation, Element>) { clone = value => __clone_syntax value }
@interpreted_only
impl Clone ModifierCall { clone = value => __clone_syntax value }
@interpreted_only
impl Clone ModifiedItem { clone = value => __clone_syntax value }
@interpreted_only
impl Clone MacroCallMetadata { clone = value => __clone_syntax value }
@interpreted_only
impl Clone Expr { clone = value => __clone_syntax value }
@interpreted_only
