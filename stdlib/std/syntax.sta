// A sequence splices its elements side by side with `$name`.
// The bound is what makes splicing a sequence of anything else a type error.
@interpreted_only
impl<T where Splice T> Splice Sequence<T> {
    splice = items => __splice_join.<T> items
}

@compiled_only
impl<T where Splice T> Splice Sequence<T> {
    splice = value => {
        let origin = __origin value
        let mut reversed: Sequence<T> = Sequence ()
        let mut cursor: Sequence<T> = __with_origin (value, origin)
        loop {
            let cell_origin = __origin cursor
            match cursor {
                Sequence () => { break },
                Sequence (first, rest) => {
                    reversed = __with_origin (Sequence (first: first, rest: reversed), cell_origin)
                    cursor = rest
                },
            }
        }
        let mut joined = __empty_syntax ()
        let mut cells = reversed
        loop {
            let cell_origin = __origin cells
            match cells {
                Sequence () => { break },
                Sequence (first, rest) => {
                    joined = __sequence_syntax (cell_origin, Splice.splice first, joined)
                    cells = rest
                },
            }
        }
        __syntax_or_origin (__origin value, joined)
    }
}

@compiled_only
pub def separated_elements_syntax = <Element, Separator where Splice Element, Splice Separator> (move elements: Sequence<Element>; separator: Separator; trailing: Bool) => Syntax :: {
    let separator_syntax = Splice.splice separator
    let mut joined = __empty_syntax ()
    let mut first: U8 = 1
    let mut cursor: Sequence<Element> = elements
    loop {
        match cursor {
            Sequence () => { break },
            Sequence (element, rest) => {
                joined = __join_separated_syntax (joined, Splice.splice element, separator_syntax, first)
                first = 0
                cursor = rest
            },
        }
    }
    match trailing {
        True => __append_separator_syntax (joined, separator_syntax),
        False => joined,
    }
}

/// The spliced elements of a borrowed sequence, with `separator` between them.
/// Like the `Sequence` splice, it walks a copy of the top cell and moves down
/// the original's cells, reading what it moves.
@compiled_only
def join_spliced = <T where Splice T> (elements: Sequence<T>; separator: Syntax) => Syntax :: {
    let mut joined = __empty_syntax ()
    let mut first: U8 = 1
    let mut cursor: Sequence<T> = __with_origin (elements, __origin elements)
    loop {
        match cursor {
            Sequence () => { break },
            Sequence (element, rest) => {
                joined = __join_separated_syntax (joined, Splice.splice element, separator, first)
                first = 0
                cursor = rest
            },
        }
    }
    joined
}

@compiled_only
impl<Element, Separator where Splice Element, Splice Separator> Splice Separated<Element, Separator> {
    splice = value => {
        let separator = Splice.splice value.separator
        let joined = join_spliced ...(value.elements; separator)
        let written = match value.trailing {
            True => __append_separator_syntax (joined, separator),
            False => joined,
        }
        __syntax_or_origin (__origin value, written)
    }
}

@compiled_only
pub def expr_from_syntax = syntax: Syntax => Expr :: match (__classify_expr syntax == 0) {
    True => {
        let spelling: String = text_string (__ident_text syntax)
        let node: Ident<String> = __with_origin (Ident<String> :: Ident spelling, syntax)
        node
    },
    False => match (__classify_expr syntax == 1) {
        True => {
            let (callee; argument) = __call_parts syntax
            let node: CallExpr = __with_origin (CallExpr (callee: expr_from_syntax callee, argument: expr_from_syntax argument), syntax)
            node
        },
        False => match (__classify_expr syntax == 2) {
            True => {
                let node: StringExpr = __with_origin (StringExpr (text_string (__string_expr_text syntax)), syntax)
                node
            },
            False => match (__classify_expr syntax == 3) {
                True => {
                    let node: CharExpr = __with_origin (CharExpr (Char.from_u32_unchecked (__char_expr_char syntax)), syntax)
                    node
                },
                False => __unstructured_expr syntax,
            },
        },
    },
}

@compiled_only
impl Splice Expr {
    splice = value => match value {
        node: Ident<String> => Splice.splice node,
        node: CallExpr => Splice.splice node,
        node: StringExpr => Splice.splice node,
        node: CharExpr => Splice.splice node,
        node: UnstructuredExpr => Splice.splice node,
    }
}

@compiled_only
impl Splice CallExpr {
    splice = value => __call_syntax (__origin value, Splice.splice value.callee, Splice.splice value.argument)
}

@compiled_only
impl<S where S <: String> Splice Ident<S> {
    splice = value => {
        let bytes = string_shared_bytes (__ident_spelling value.*)
        let result = __ident_syntax (__origin value, __text_new (SharedBuffer.unsafe_data bytes, SharedBuffer.length bytes))
        match (__syntax_is_null result == 1) {
            True => exit 1,
            False => result,
        }
    }
}

@compiled_only
impl Splice StringExpr {
    splice = value => {
        let bytes = string_shared_bytes value.*
        __string_expr_syntax (__origin value, __text_new (SharedBuffer.unsafe_data bytes, SharedBuffer.length bytes))
    }
}

@compiled_only
impl Splice CharExpr {
    splice = value => __char_expr_syntax (__origin value, Char.to_u32 value.*)
}

@compiled_only
pub def ident_from_syntax = syntax: Syntax => Ident<String> :: {
    let spelling: String = text_string (__ident_text syntax)
    __with_origin (Ident<String> :: Ident spelling, syntax)
}

@compiled_only
pub def product_type_field_from_syntax = syntax: Syntax => ProductTypeField :: {
    let name = __product_type_field_name syntax
    let field_type = __product_type_field_type syntax
    let default = __product_type_field_default syntax
    let name_value: Option<Ident<String>> = match (__syntax_is_empty name == 1) {
        True => None,
        False => Some (ident_from_syntax name),
    }
    let default_value: Option<Expr> = match (__syntax_is_empty default == 1) {
        True => None,
        False => Some (expr_from_syntax default),
    }
    ProductTypeField (name: name_value, field_type: type_from_syntax field_type, default: default_value)
}

@compiled_only
pub def product_type_from_syntax = syntax: Syntax => ProductType :: {
    let count = __product_type_field_count syntax
    let mut fields: Sequence<ProductTypeField> = Sequence ()
    let mut index = count
    loop {
        match (index == 0) {
            True => { break },
            False => {
                index = index - 1
                let field = __product_type_field (syntax, index)
                fields = Sequence (first: product_type_field_from_syntax field, rest: fields)
            },
        }
    }
    ProductType (__with_origin (fields, syntax))
}

@compiled_only
pub def type_from_syntax = syntax: Syntax => Type :: match (__classify_type syntax == 0) {
    True => product_type_from_syntax syntax,
    False => __unstructured_type syntax,
}

@compiled_only
impl Splice ProductTypeField {
    splice = value => {
        let name = match value.name {
            None => __empty_syntax (),
            Some ident => Splice.splice ident,
        }
        let field_type = Splice.splice value.field_type
        let default = match value.default {
            None => __empty_syntax (),
            Some expression => Splice.splice expression,
        }
        __product_type_field_syntax (name, field_type, default)
    }
}

@compiled_only
def product_type_fields_syntax = move fields: Sequence<ProductTypeField> => Syntax :: {
    let mut joined = __empty_syntax ()
    let mut first: U8 = 1
    let mut cells = fields
    loop {
        match cells {
            Sequence () => { break },
            Sequence (field, rest) => {
                joined = __join_field_syntax (joined, Splice.splice field, first)
                first = 0
                cells = rest
            },
        }
    }
    joined
}

@compiled_only
def sequence_origin_of = <T> (value: Sequence<T>) => Syntax :: __origin value

@compiled_only
def product_type_syntax_of = (value: ProductType) => Syntax :: {
    let origin = sequence_origin_of value.*
    __product_type_syntax (origin, product_type_fields_syntax (Clone.clone value.*))
}

@compiled_only
impl Splice ProductType {
    splice = value => product_type_syntax_of value
}

/// Whether two handles name the same syntax fragment. A round trip that
/// returns its input keeps its original handle, not just its text.
@compiled_only
pub def same_syntax = (left: Syntax; right: Syntax) => Bool :: __same_syntax (left, right) == 1

/// `value` with `origin` attached as its hidden origin. For macros that build
/// syntax values by hand and want the rebuild to reuse the original fragment.
@compiled_only
pub def sequence_with_origin = <T> (value: Sequence<T>; origin: Syntax) => Sequence<T> :: __with_origin (value, origin)

/// `value` with `origin` attached as its hidden origin.
@compiled_only
pub def separated_with_origin = <Element, Separator> (value: Separated<Element, Separator>; origin: Syntax) => Separated<Element, Separator> :: __with_origin (value, origin)

/// `value` with `origin` attached as its hidden origin.
@compiled_only
pub def parenthesized_with_origin = (value: Parenthesized<Syntax>; origin: Syntax) => Parenthesized<Syntax> :: __with_origin (value, origin)

