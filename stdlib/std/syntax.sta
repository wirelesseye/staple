@compiled_only
impl Clone ModifierCall {
    clone = value => __with_origin (
        ModifierCall (namespace: Clone.clone.<Sequence<Ident<String>>> (value.namespace), name: value.name, argument: clone_option (value.argument)),
        __origin value
    )
}

@compiled_only
impl Clone ModifiedItem {
    clone = value => __with_origin (
        ModifiedItem (modifiers: Clone.clone (value.modifiers), item: Clone.clone (value.item)),
        __origin value
    )
}

@compiled_only
impl Clone MacroCallMetadata {
    clone = value => MacroCallMetadata (modifiers: Clone.clone (value.modifiers), visibility: value.visibility)
}

@compiled_only
impl Clone Expr {
    clone = value => match value {
        node: Ident<String> => Clone.clone.<Ident<String>> node,
        node: CallExpr => Clone.clone.<CallExpr> node,
        node: StringExpr => Clone.clone.<StringExpr> node,
        node: CharExpr => Clone.clone.<CharExpr> node,
        node: UnstructuredExpr => Clone.clone.<UnstructuredExpr> node,
    }
}

@compiled_only
impl Clone Type {
    clone = value => match value {
        node: ProductType => Clone.clone.<ProductType> node,
        node: UnstructuredType => Clone.clone.<UnstructuredType> node,
    }
}

@compiled_only
impl Clone Pattern {
    clone = value => match value {
        node: BindingPattern => Clone.clone.<BindingPattern> node,
        node: NominalPattern => Clone.clone.<NominalPattern> node,
        node: UnstructuredPattern => Clone.clone.<UnstructuredPattern> node,
    }
}

@compiled_only
impl Clone Item {
    clone = value => match value {
        node: ModifiedItem => Clone.clone.<ModifiedItem> node,
        node: TypeDeclarationItem => Clone.clone.<TypeDeclarationItem> node,
        node: UnstructuredItem => Clone.clone.<UnstructuredItem> node,
    }
}

@compiled_only
impl Clone Modifier {
    clone = value => match value {
        node: ModifierCall => Clone.clone.<ModifierCall> node,
        node: UnstructuredModifier => Clone.clone.<UnstructuredModifier> node,
    }
}

@compiled_only
impl Clone TypeBody {
    clone = value => match value {
        node: AliasBody<Type> => Clone.clone.<AliasBody<Type>> node,
        node: WrapperBody<Visibility, Type> => Clone.clone.<WrapperBody<Visibility, Type>> node,
        node: FromBody<Visibility, Type> => Clone.clone.<FromBody<Visibility, Type>> node,
        node: OpaqueBody => node,
    }
}

@compiled_only
impl Clone SyntaxNode {
    clone = value => match value {
        node: Ident<String> => Clone.clone.<Ident<String>> node,
        node: CallExpr => Clone.clone.<CallExpr> node,
        node: StringExpr => Clone.clone.<StringExpr> node,
        node: CharExpr => Clone.clone.<CharExpr> node,
        node: UnstructuredExpr => Clone.clone.<UnstructuredExpr> node,
        node: ProductType => Clone.clone.<ProductType> node,
        node: UnstructuredType => Clone.clone.<UnstructuredType> node,
        node: BindingPattern => Clone.clone.<BindingPattern> node,
        node: NominalPattern => Clone.clone.<NominalPattern> node,
        node: UnstructuredPattern => Clone.clone.<UnstructuredPattern> node,
        node: ModifiedItem => Clone.clone.<ModifiedItem> node,
        node: TypeDeclarationItem => Clone.clone.<TypeDeclarationItem> node,
        node: UnstructuredItem => Clone.clone.<UnstructuredItem> node,
        node: Private => Clone.clone.<Private> node,
        node: Package => Clone.clone.<Package> node,
        node: Public => Clone.clone.<Public> node,
        node: Comma => Clone.clone.<Comma> node,
        node: Equals => Clone.clone.<Equals> node,
        node: FatArrow => Clone.clone.<FatArrow> node,
        node: TypeParameter => Clone.clone.<TypeParameter> node,
        node: TypeParameters => Clone.clone.<TypeParameters> node,
        node: Angled<Syntax> => Clone.clone.<Angled<Syntax>> node,
        node: Parenthesized<Syntax> => Clone.clone.<Parenthesized<Syntax>> node,
        node: Bracketed<Syntax> => Clone.clone.<Bracketed<Syntax>> node,
        node: Braced<Syntax> => Clone.clone.<Braced<Syntax>> node,
    }
}
