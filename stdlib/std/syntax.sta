// Macro arguments. The compiler matches a call against the macro's signature
// and hands compiled code the match as a tree of nodes: a fragment, a list, an
// absent option, or a delimited group with its source and contents. Each
// parameter is decoded from its node by `FromMatch`, in the same shapes as
// `Parse`.

/// A node of a matched macro call, as a handle.
@compiled_only
type MatchNode = U64

@compiled_only
extern "staple-intrinsic" {
    /// 0 for a fragment, 1 for a list, 2 for an absent option, 3 for a group.
    __match_kind: MatchNode -> U8
    /// A fragment's syntax, or a group's source.
    __match_syntax: MatchNode -> Syntax
    /// How many children a list has. A group has one, its contents.
    __match_count: MatchNode -> USize
    __match_child: (MatchNode, USize) -> MatchNode
}

/// Syntax that can be decoded from a matched macro argument.
@compiled_only
trait FromMatch T {
    from_match: MatchNode -> T
}

/// A leaf is parsed from the fragment the compiler matched. The compiler has
/// already checked that it is one, so a failure is the compiler's error.
@compiled_only
def match_leaf = <T where Parse T> node: MatchNode => T ::
    match (Parse.parse_all.<T> (__match_syntax node)) {
        Ok value => value,
        ParseError (message) => compile_error message,
    }

@compiled_only
impl FromMatch Expr { from_match = node => match_leaf.<Expr> node }

@compiled_only
impl FromMatch CallExpr { from_match = node => match_leaf.<CallExpr> node }

@compiled_only
impl FromMatch StringExpr { from_match = node => match_leaf.<StringExpr> node }

@compiled_only
impl FromMatch CharExpr { from_match = node => match_leaf.<CharExpr> node }

