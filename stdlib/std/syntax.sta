pub mod

use package.result.(Result, Ok)
use package.string.(String)
use package.iterator.(Iterator, IntoIterator, FromIterator, IterStep)
use package.iterator.IterStep.(Done, Yield)
use package.default.(Default)

/// Compiler-owned, compile-time-only syntax values. Identifiers and calls expose
/// their data in the first structured-syntax slice; remaining expressions round-trip
/// through `UnstructuredExpr` without exposing fields.
/// An identifier syntax node, optionally constrained to one spelling.
@recursive_constructor
pub type Ident<Spelling = String where Spelling <: String> wrap pub Spelling
/// A structured call expression syntax node.
@recursive_constructor
pub type CallExpr wrap pub (
    callee: Expr,
    argument: Expr,
)
/// A string-literal expression constructed from a compile-time string.
@recursive_constructor
pub type StringExpr wrap pub String
/// A sequence of syntax values.
@recursive_constructor
pub type Sequence<Element> wrap pub
    () |
    (first: Element, rest: Sequence<Element>)
/// A separated syntax sequence with its separator and trailing state.
@recursive_constructor
pub type Separated<Element, Separator> wrap pub (
    separator: Separator,
    elements: Sequence<Element>,
    trailing: Bool,
)
/// A comma punctuation syntax node.
pub type Comma
/// An equals-sign punctuation syntax node.
pub type Equals
/// A fat-arrow punctuation syntax node.
pub type FatArrow
/// A parenthesized syntax fragment.
@recursive_constructor
pub type Parenthesized<Contents> wrap pub Contents
/// A bracketed syntax fragment.
@recursive_constructor
pub type Bracketed<Contents> wrap pub Contents
/// A braced syntax fragment.
@recursive_constructor
pub type Braced<Contents> wrap pub Contents
/// An explicitly requested angle-bracketed syntax fragment. Comparisons are
/// not implicitly treated as delimited syntax.
@recursive_constructor
pub type Angled<Contents> wrap pub Contents
/// One declaration parameter, retaining its original syntax and optional default.
@recursive_constructor
pub type TypeParameter wrap pub (
    name: Ident<String>,
    default: Option<Type>,
    declaration: Syntax,
    argument: Type,
)
/// A declaration's complete `<...>` header, including defaults and bounds.
/// `arguments` contains only `<T, U, ...>`, suitable for applying the type.
@recursive_constructor
pub type TypeParameters wrap pub (
    parameters: Sequence<TypeParameter>,
    declaration: Syntax,
    arguments: Syntax,
    bounds: Syntax,
)
/// An expression syntax node without structured fields.
@sized_opaque
pub type UnstructuredExpr opaque
impl !Copy UnstructuredExpr {}
/// The syntax category for expressions.
pub type Expr = Ident<String> | CallExpr | StringExpr | UnstructuredExpr

/// The syntax category for types.
@sized_opaque
pub type Type opaque
impl !Copy Type {}
/// A binding pattern constructed from an identifier.
@recursive_constructor
pub type BindingPattern wrap pub Ident<String>
/// A nominal destructuring pattern.
@recursive_constructor
pub type NominalPattern wrap pub (name: Ident<String>, argument: Pattern)
/// A pattern whose structure is not exposed yet.
@sized_opaque
pub type UnstructuredPattern opaque
impl !Copy UnstructuredPattern {}
/// The syntax category for patterns.
pub type Pattern = BindingPattern | NominalPattern | UnstructuredPattern
/// The kind of a type declaration.
pub type AliasDeclaration
pub type WrapperDeclaration
pub type FromDeclaration
pub type SingletonDeclaration
pub type OpaqueDeclaration
pub type TypeDeclarationKind =
    AliasDeclaration |
    WrapperDeclaration |
    FromDeclaration |
    SingletonDeclaration |
    OpaqueDeclaration
/// An inspectable type declaration item. Type parameters are exposed by name;
/// their original declaration syntax remains part of the lossless item value.
@recursive_constructor
pub type TypeDeclarationItem wrap pub (
    kind: TypeDeclarationKind,
    name: Ident<String>,
    name_spelling: String,
    declared_type: Type,
    type_parameters: Sequence<Ident<String>>,
    underlying: Option<Type>,
)
/// A transparent alias type declaration body, written `= Type`.
@recursive_constructor
pub type AliasBody<Element> wrap Element
/// A `wrap` type declaration body with its representation visibility.
@recursive_constructor
pub type WrapperBody<Representation, Element> wrap (Representation, Element)
/// A `from` type declaration body with its representation visibility.
@recursive_constructor
pub type FromBody<Representation, Element> wrap (Representation, Element)
/// An `opaque` type declaration body.
pub type OpaqueBody
/// The body of a type declaration: `= Type`, `wrap Type`, `from Type`, or `opaque`.
pub type TypeBody =
    AliasBody<Type> |
    WrapperBody<Visibility, Type> |
    FromBody<Visibility, Type> |
    OpaqueBody
/// An item whose structure is not exposed yet.
@sized_opaque
pub type UnstructuredItem opaque
impl !Copy UnstructuredItem {}
/// A lossless modifier invocation whose structure is intentionally opaque.
@sized_opaque
pub type Modifier opaque
impl !Copy Modifier {}
/// An item carrying modifiers that have not yet been applied. Modifiers are
/// ordered outermost first.
@recursive_constructor
pub type ModifiedItem wrap pub (
    modifiers: Sequence<Modifier>,
    item: Item,
)
/// The syntax category for items.
pub type Item = ModifiedItem | TypeDeclarationItem | UnstructuredItem

/// Compiler-owned metadata supplied to a function-style macro invocation.
/// Modifiers are ordered outermost first.
pub type MacroCallMetadata wrap (
    modifiers: Sequence<Modifier>,
    visibility: Visibility,
)
/// Private visibility syntax.
pub type Private
/// Package-scoped visibility syntax.
pub type Package
/// Public visibility syntax.
pub type Public
/// The syntax category for visibility markers.
pub type Visibility = Private | Package | Public
/// An arbitrary lossless syntax fragment. `SyntaxNode` is exactly one structural
/// node; delimiter nodes retain their complete opaque contents.
/// An opaque lossless syntax fragment.
@sized_opaque
pub type Syntax opaque
impl !Copy Syntax {}
/// Exactly one structural syntax node.
pub type SyntaxNode = Expr | Type | Pattern | Item | Visibility | Comma | Equals | FatArrow | TypeParameter | TypeParameters | Angled<Syntax> | Parenthesized<Syntax> | Bracketed<Syntax> | Braced<Syntax>

/// Produces opaque syntax from a braced quotation without reparsing it.
///
/// # Example
///
/// ```staple
/// macro identity = value: Expr => quote { $value }
/// ```
pub macro quote: Braced<Syntax> -> Syntax
/// Produces parsed syntax of the expected category from a braced quotation.
///
/// # Example
///
/// ```staple
/// macro identity: Expr -> Expr = value: Expr => parse_quote { $value }
/// ```
pub macro parse_quote: Braced<Syntax> -> Syntax

/// A compile-time parse failure.
pub type ParseError wrap pub (message: String)
/// A cursor over a syntax fragment. Copying a stream forks it: `let mut fork =
/// input` is a backtracking point and `input = fork` commits it.
@sized_opaque
pub type ParseStream opaque

pub extern "staple-intrinsic" {
    /// Starts a stream at the beginning of `syntax`.
    stream: Syntax -> ParseStream
    /// `True` when only trivia remains.
    is_empty: ParseStream -> Bool
    /// The unconsumed rest of the stream, losslessly.
    remaining: ParseStream -> Syntax
    /// A `ParseError` whose message names the stream's current position.
    error_at: (ParseStream; String) -> ParseError
}

/// Syntax that can be parsed from the front of a `ParseStream` at compile time.
///
/// `parse` reads one `T` and advances the stream in place; it fails without
/// consuming anything the caller keeps unless the caller commits a fork.
pub trait Parse T {
    parse: mut ParseStream -> Result<T, ParseError>
    /// Parses all of `syntax` as one `T`, rejecting leftover syntax.
    parse_all: Syntax -> Result<T, ParseError> = syntax => {
        let mut input = stream syntax
        let value = Parse.parse.<T> input?
        if (is_empty input) { Ok value } else { error_at (input; "unexpected syntax") }
    }
}

// Compiler building blocks for the implementations below. Like those
// implementations, they exist only while macros expand.
extern "staple-intrinsic" {
    __parse_primitive: <T> mut ParseStream -> Result<T, ParseError>
    __parenthesized_group: mut ParseStream -> Result<(Syntax; ParseStream), ParseError>
    __bracketed_group: mut ParseStream -> Result<(Syntax; ParseStream), ParseError>
    __angled_group: mut ParseStream -> Result<(Syntax; ParseStream), ParseError>
    __braced_group: mut ParseStream -> Result<(Syntax; ParseStream), ParseError>
    __parenthesized: <C> (Syntax; C) -> Parenthesized<C>
    __bracketed: <C> (Syntax; C) -> Bracketed<C>
    __angled: <C> (Syntax; C) -> Angled<C>
    __braced: <C> (Syntax; C) -> Braced<C>
    __take_rest: mut ParseStream -> Syntax
    __offset: ParseStream -> USize
    __sequence_push: <T> (Sequence<T>; T) -> Sequence<T>
}

// Leaf syntax nodes: each consumes the longest node the grammar accepts from
// the cursor and stops where the grammar stops.
impl Parse Expr { parse = mut input => __parse_primitive.<Expr> input }
impl Parse CallExpr { parse = mut input => __parse_primitive.<CallExpr> input }
impl Parse StringExpr { parse = mut input => __parse_primitive.<StringExpr> input }
impl Parse UnstructuredExpr { parse = mut input => __parse_primitive.<UnstructuredExpr> input }
impl Parse Type { parse = mut input => __parse_primitive.<Type> input }
impl Parse Pattern { parse = mut input => __parse_primitive.<Pattern> input }
impl Parse BindingPattern { parse = mut input => __parse_primitive.<BindingPattern> input }
impl Parse NominalPattern { parse = mut input => __parse_primitive.<NominalPattern> input }
impl Parse Item { parse = mut input => __parse_primitive.<Item> input }
impl Parse ModifiedItem { parse = mut input => __parse_primitive.<ModifiedItem> input }
impl Parse TypeDeclarationItem { parse = mut input => __parse_primitive.<TypeDeclarationItem> input }
impl Parse UnstructuredItem { parse = mut input => __parse_primitive.<UnstructuredItem> input }
impl Parse Modifier { parse = mut input => __parse_primitive.<Modifier> input }
impl Parse TypeBody { parse = mut input => __parse_primitive.<TypeBody> input }
impl Parse TypeParameter { parse = mut input => __parse_primitive.<TypeParameter> input }
impl Parse TypeParameters { parse = mut input => __parse_primitive.<TypeParameters> input }
// One token, checked against the spelling the type names.
impl<S where S <: String> Parse Ident<S> { parse = mut input => __parse_primitive.<Ident<S>> input }
impl Parse Comma { parse = mut input => __parse_primitive.<Comma> input }
impl Parse Equals { parse = mut input => __parse_primitive.<Equals> input }
impl Parse FatArrow { parse = mut input => __parse_primitive.<FatArrow> input }
// `pub` or `pub(package)`; with neither present, nothing is consumed and the
// result is `Private`.
impl Parse Visibility { parse = mut input => __parse_primitive.<Visibility> input }
// Exactly one shortest structural atom; a balanced group counts as one atom.
impl Parse SyntaxNode { parse = mut input => __parse_primitive.<SyntaxNode> input }

// Everything that is left.
impl Parse Syntax { parse = mut input => Ok (__take_rest input) }
// Nothing at all.
impl Parse () { parse = mut input => Ok () }

// `None` and no consumption when `T` does not parse here.
impl<T where Parse T> Parse Option<T> {
    parse = mut input => {
        let mut fork = input
        match (Parse.parse.<T> fork) {
            Ok value => {
                input = fork
                Ok (Some value)
            },
            ParseError _ => Ok None,
        }
    }
}

// Delimited groups parse their contents on an inner stream that must be
// consumed completely. The result keeps the group's original syntax.
impl<C where Parse C> Parse Parenthesized<C> {
    parse = mut input => {
        let (source, inner) = __parenthesized_group input?
        let mut contents = inner
        let value = Parse.parse.<C> contents?
        if (is_empty contents) {
            Ok (__parenthesized.<C> (source; value))
        } else {
            error_at (contents; "unexpected syntax")
        }
    }
}
impl<C where Parse C> Parse Bracketed<C> {
    parse = mut input => {
        let (source, inner) = __bracketed_group input?
        let mut contents = inner
        let value = Parse.parse.<C> contents?
        if (is_empty contents) {
            Ok (__bracketed.<C> (source; value))
        } else {
            error_at (contents; "unexpected syntax")
        }
    }
}
impl<C where Parse C> Parse Angled<C> {
    parse = mut input => {
        let (source, inner) = __angled_group input?
        let mut contents = inner
        let value = Parse.parse.<C> contents?
        if (is_empty contents) {
            Ok (__angled.<C> (source; value))
        } else {
            error_at (contents; "unexpected syntax")
        }
    }
}
impl<C where Parse C> Parse Braced<C> {
    parse = mut input => {
        let (source, inner) = __braced_group input?
        let mut contents = inner
        let value = Parse.parse.<C> contents?
        if (is_empty contents) {
            Ok (__braced.<C> (source; value))
        } else {
            error_at (contents; "unexpected syntax")
        }
    }
}

// Slotted products parse bare, juxtaposed contents one element at a time.
impl<H, T where Parse H, Parse T> Parse (H; ...T) {
    parse = mut input => {
        let head = Parse.parse.<H> input?
        // The tail is spread where it is read: binding a one-element product
        // would unwrap it.
        Ok (head; ...Parse.parse.<T> input?)
    }
}

// Comma products parse bare contents separated by commas, with one optional
// trailing comma.
impl<H, T where Parse H, Parse T> Parse (H, ...T) {
    parse = mut input => {
        let head = Parse.parse.<H> input?
        if (is_empty input) {
            Ok (head, ...Parse.parse.<T> input?)
        } else {
            let _ = Parse.parse.<Comma> input?
            Ok (head, ...Parse.parse.<T> input?)
        }
    }
}

impl<T> Iterator Sequence<T> {
    type Item = T
    next = move sequence => match sequence {
        Sequence () => Done (Sequence ()),
        Sequence (first, rest) => Yield (first, rest),
    }
}
impl<T> IntoIterator Sequence<T> {
    type Iter = Sequence<T>
    into_iterator = move sequence => sequence
}
impl<T> Default (Sequence<T>) {
    default = () => Sequence ()
}
impl<T> FromIterator Sequence<T> T {
    insert = (move sequence: Sequence<T>; move item: T) => Sequence<T> ::
        __sequence_push (sequence; item)
}

// Elements until the stream ends or `T` stops parsing.
impl<T where Parse T> Parse Sequence<T> {
    parse = mut input => {
        let mut elements = Sequence ()
        loop {
            if (is_empty input) { break }
            let mut fork = input
            let start = __offset fork
            match (Parse.parse.<T> fork) {
                Ok first => {
                    if (__offset fork == start) { break }
                    input = fork
                    elements = __sequence_push (elements; first)
                },
                ParseError _ => { break },
            }
        }
        Ok elements
    }
}

// Comma-separated elements with an optional trailing comma.
impl<T where Parse T> Parse Separated<T, Comma> {
    parse = mut input => {
        let mut elements = Sequence ()
        let mut trailing = False
        loop {
            if (is_empty input) { break }
            let mut fork = input
            let start = __offset fork
            let first = Parse.parse.<T> fork?
            if (__offset fork == start) { break }
            input = fork
            elements = __sequence_push (elements; first)
            trailing = False
            if (is_empty input) { break }
            let _ = Parse.parse.<Comma> input?
            trailing = True
        }
        Ok (Separated (separator: Comma, elements: elements, trailing: trailing))
    }
}
