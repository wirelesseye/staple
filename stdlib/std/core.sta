pub def infixl 6 +: T => Add T => T -> T -> T = left => right => Add.add left right
pub def infixl 6 -: T => Subtract T => T -> T -> T = left => right => Subtract.subtract left right
pub def infixl 7 *: T => Multiply T => T -> T -> T = left => right => Multiply.multiply left right
pub def infixl 7 /: T => Divide T => T -> T -> T = left => right => Divide.divide left right
