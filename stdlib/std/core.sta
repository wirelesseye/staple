pub def infixl 6 + : T => Copy T => Add T => T -> T -> T = left => right => Add.add left right
pub def infixl 6 - : T => Copy T => Subtract T => T -> T -> T = left => right => Subtract.subtract left right
pub def infixl 7 * : T => Copy T => Multiply T => T -> T -> T = left => right => Multiply.multiply left right
pub def infixl 7 / : T => Copy T => Divide T => T -> T -> T = left => right => Divide.divide left right
pub def infix 4 == : T => Copy T => Eq T => T -> T -> Bool = left => right => Eq.equal left right
pub def infix 4 != : T => Copy T => Eq T => T -> T -> Bool = left => right => Eq.not_equal left right
pub def infix 4 < : T => Copy T => Compare T => T -> T -> Bool = left => right => Compare.less_than left right
pub def infix 4 <= : T => Copy T => Compare T => T -> T -> Bool = left => right => Compare.less_than_or_equal left right
pub def infix 4 > : T => Copy T => Compare T => T -> T -> Bool = left => right => Compare.greater_than left right
pub def infix 4 >= : T => Copy T => Compare T => T -> T -> Bool = left => right => Compare.greater_than_or_equal left right
