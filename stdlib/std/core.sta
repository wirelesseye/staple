impl Eq Bool {
    def equal = left => right => match (left, right) {
        (True(), True()) => True,
        (False(), False()) => True,
        _ => False,
    }
    def not_equal = left => right => match (left, right) {
        (True(), False()) => True,
        (False(), True()) => True,
        _ => False,
    }
}

impl Eq I8 {
    def equal = left => right => __i8_equal (left, right)
    def not_equal = left => right => __i8_not_equal (left, right)
}

impl Compare I8 {
    def less_than = left => right => __i8_less_than (left, right)
    def less_than_or_equal = left => right => __i8_less_than_or_equal (left, right)
    def greater_than = left => right => __i8_greater_than (left, right)
    def greater_than_or_equal = left => right => __i8_greater_than_or_equal (left, right)
}

