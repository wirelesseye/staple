pub type I8
pub type I16
pub type I32
pub type I64
pub type U8
pub type U16
pub type U32
pub type U64
pub type ISize
pub type USize
pub type Bool
pub type String

pub(repr) type Ok = T => T

pub trait Add = T => {
    add: T -> T -> T
}

pub trait Subtract = T => {
    subtract: T -> T -> T
}

pub trait Multiply = T => {
    multiply: T -> T -> T
}

pub trait Divide = T => {
    divide: T -> T -> T
}

extern "staple-intrinsic" {
    let __i8_add: (I8, I8) -> I8
    let __i8_subtract: (I8, I8) -> I8
    let __i8_multiply: (I8, I8) -> I8
    let __i8_divide: (I8, I8) -> I8
    let __i16_add: (I16, I16) -> I16
    let __i16_subtract: (I16, I16) -> I16
    let __i16_multiply: (I16, I16) -> I16
    let __i16_divide: (I16, I16) -> I16
    let __i32_add: (I32, I32) -> I32
    let __i32_subtract: (I32, I32) -> I32
    let __i32_multiply: (I32, I32) -> I32
    let __i32_divide: (I32, I32) -> I32
    let __i64_add: (I64, I64) -> I64
    let __i64_subtract: (I64, I64) -> I64
    let __i64_multiply: (I64, I64) -> I64
    let __i64_divide: (I64, I64) -> I64
    let __u8_add: (U8, U8) -> U8
    let __u8_subtract: (U8, U8) -> U8
    let __u8_multiply: (U8, U8) -> U8
    let __u8_divide: (U8, U8) -> U8
    let __u16_add: (U16, U16) -> U16
    let __u16_subtract: (U16, U16) -> U16
    let __u16_multiply: (U16, U16) -> U16
    let __u16_divide: (U16, U16) -> U16
    let __u32_add: (U32, U32) -> U32
    let __u32_subtract: (U32, U32) -> U32
    let __u32_multiply: (U32, U32) -> U32
    let __u32_divide: (U32, U32) -> U32
    let __u64_add: (U64, U64) -> U64
    let __u64_subtract: (U64, U64) -> U64
    let __u64_multiply: (U64, U64) -> U64
    let __u64_divide: (U64, U64) -> U64
    let __isize_add: (ISize, ISize) -> ISize
    let __isize_subtract: (ISize, ISize) -> ISize
    let __isize_multiply: (ISize, ISize) -> ISize
    let __isize_divide: (ISize, ISize) -> ISize
    let __usize_add: (USize, USize) -> USize
    let __usize_subtract: (USize, USize) -> USize
    let __usize_multiply: (USize, USize) -> USize
    let __usize_divide: (USize, USize) -> USize
}

impl Add I8 {
    def add = left => right => __i8_add (left, right)
}

impl Subtract I8 {
    def subtract = left => right => __i8_subtract (left, right)
}

impl Multiply I8 {
    def multiply = left => right => __i8_multiply (left, right)
}

impl Divide I8 {
    def divide = left => right => __i8_divide (left, right)
}

