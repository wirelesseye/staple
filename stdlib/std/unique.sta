pub mod

use package.ptr.(RawMutPtr)

/// A unique, affine heap owner. Dropping it cleans up its payload and frees
/// its allocation immediately. The allocation lives on the managed heap and is
/// traced through its owner, so an owner reachable only from an unreachable
/// cycle of managed references is finalized and freed by collection.
/// Unsized payload types may be used in handles and generic signatures;
/// construction requires a concrete payload layout.
@recursive_constructor
pub type Unique<T where ?Sized T> wrap pub T

extern "staple-intrinsic" {
    __unique_into_raw: <T where ?Sized T> (move Unique<T>) -> RawMutPtr<T>
    __unique_from_raw: <T where ?Sized T> RawMutPtr<T> -> Unique<T>
}

companion<T where ?Sized T> Unique<T> {
    /// Transfers ownership to the caller without cleanup or deallocation.
    /// While raw, the allocation and its payload stay alive as collector roots.
    /// The caller must eventually reconstruct the owner or clean up and free
    /// the allocation using the same allocator and payload layout.
    pub def unsafe_into_raw = move value: Unique<T> => RawMutPtr<T> :: __unique_into_raw value

    /// Adopts exclusive ownership of a live, aligned, initialized allocation
    /// with the correct payload type, allocated using Unique's allocator.
    /// Ownership must be transferred exactly once. Null, dangling, aliased,
    /// or incompatible pointers are invalid.
    pub def unsafe_from_raw = pointer: RawMutPtr<T> => Unique<T> :: __unique_from_raw pointer
}
