// Retain pointer-holding products while allocating enough strings to collect,
// then check every retained string, so a collector that frees live data fails
// the benchmark instead of timing it.
use std.io.println
let mut values: List<(I8, String)> = List.new ()
let mut i: USize = 0
while (i < 100000) {
    List.push values (1, "value=$i")
    i = i + 1
}
let mut intact: USize = 0
let mut j: USize = 0
while (j < 100000) {
    let (tag, text) = List.get_unchecked values j
    if (text == "value=$j") { intact = intact + 1 }
    j = j + 1
}
println "${List.length values} ${intact}"
