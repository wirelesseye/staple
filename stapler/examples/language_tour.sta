// Bindings, literals, products, functions, closures, blocks, and operators.
use std.io.println

let greeting: String = "Staple language tour"
let details: (name: String, year: I32) = (name: greeting, year: 2026)

def add_curried: I32 -> I32 -> I32 = left => right => left + right
def add_ten = add_curried 10

def nested_sum = (first: I32, (second: I32, third: I32)) => {
    let subtotal = first + second
    subtotal + third
} satisfies I32

// Arithmetic, comparison, and range operators are fixed language syntax
// that dispatch to trait methods (`Add`, `Eq`, `PartialOrd`, ...).
let product_year = details.1
let closure_result = add_ten 32
let nested_result = nested_sum (10, (20, 12))
let operator_results = (1 + 2 * 3, 1 < 2, 0 .. 3)

println details.0
println "Products, closures, nested patterns, and operators evaluated successfully."
