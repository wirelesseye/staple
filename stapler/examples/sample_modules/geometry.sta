// Public representation exports its constructor and nominal pattern.
pub(repr) type Point = (x: I32, y: I32)

pub def origin = () => Point (x: 0, y: 0)
pub def translate = (Point (x, y), dx: I32, dy: I32) => Point (x: x + dx, y: y + dy)
pub def x: Point -> I32 = Point point => point.0
pub def y: Point -> I32 = Point point => point.1
