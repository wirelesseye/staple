impl Eq I8 {
    def equal = left => right => __i8_equal (left, right)
    def not_equal = left => right => __i8_not_equal (left, right)
}

impl PartialOrd I8 {
    def partial_cmp = left => right => match (__i8_lt (left, right)) {
        True() => Some (Less satisfies Ordering),
        False() => match (__i8_gt (left, right)) {
        True() => Some (Greater satisfies Ordering),
            False() => Some (Equal satisfies Ordering),
        },
    }
}

impl Ord I8 {
    def cmp = left => right => match (__i8_lt (left, right)) {
        True() => Less,
        False() => match (__i8_gt (left, right)) {
            True() => Greater,
            False() => Equal,
        },
    }
}

