pub type I8 = opaque
pub type I16 = opaque
pub type I32 = opaque
pub type I64 = opaque
pub type U8 = opaque
pub type U16 = opaque
pub type U32 = opaque
pub type U64 = opaque
pub type ISize = opaque
pub type USize = opaque
pub type F32 = opaque
pub type F64 = opaque

pub(repr) typegroup Option = T => {
    None,
    Some T,
}
pub use Option *

pub type Less
pub type Equal
pub type Greater
pub type alias Ordering = Less | Equal | Greater

pub trait Add = T => {
    add: T -> T -> T
}

pub trait Subtract = T => {
    subtract: T -> T -> T
}

pub trait Multiply = T => {
    multiply: T -> T -> T
}

pub trait Divide = T => {
    divide: T -> T -> T
}

pub trait PartialOrd = T => Copy T => {
    partial_cmp: T -> T -> Option Ordering
    lt: T -> T -> Bool = left => right => match (partial_cmp left right) {
        Some Less() => True,
        _ => False,
    }
    le: T -> T -> Bool = left => right => match (partial_cmp left right) {
        Some Less() => True,
        Some Equal() => True,
        _ => False,
    }
    gt: T -> T -> Bool = left => right => match (partial_cmp left right) {
        Some Greater() => True,
        _ => False,
    }
    ge: T -> T -> Bool = left => right => match (partial_cmp left right) {
        Some Greater() => True,
        Some Equal() => True,
        _ => False,
    }
}

pub trait Ord = T => Eq T => PartialOrd T => {
    cmp: T -> T -> Ordering
}
