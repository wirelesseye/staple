pub trait Index = Target => Position => Output =>
    {Target, Position} ~> Output => {
    index: (Target, Position) -> Output
}

pub trait UpdateIndex = Target => Position => Value =>
    {Target, Position} ~> Value => {
    update_index: (Target, Position, Value) -> Target
}

pub trait MutateIndex = Target => Position => Value =>
    {Target, Position} ~> Value => {
    mutate_index: (Target, Position, Value) -> ()
}
