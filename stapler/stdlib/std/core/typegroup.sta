pub mod

use std.syntax.*

def typegroup_public_visibility: Visibility -> Visibility = visibility => match visibility {
    Private => Private,
    Package => Package,
    Public => Public,
    PublicReprPackage => Public,
    PublicRepr => Public,
}

def typegroup_variant_visibility: Visibility -> Visibility = visibility => match visibility {
    Private => PublicRepr,
    Package => PublicReprPackage,
    Public => Public,
    PublicReprPackage => PublicReprPackage,
    PublicRepr => PublicRepr,
}

def typegroup_visibility_syntax: Visibility -> Syntax = visibility => match visibility {
    Private => quote {},
    Package => quote { pub(package) },
    Public => quote { pub },
    PublicReprPackage => quote { pub(repr(package)) },
    PublicRepr => quote { pub(repr) },
}

def typegroup_items:
    Visibility ->
    Sequence (Ident String, Optional Type) ->
    Sequence Item =
visibility => entries => match entries {
    Sequence () => Sequence (),
    Sequence (
        first: (Ident String, Optional Type),
        rest: Sequence (Ident String, Optional Type),
    ) => match first {
        (variant: Ident String, None) => Sequence (
            first: parse_quote { $visibility type $variant },
            rest: typegroup_items visibility rest,
        ),
        (variant: Ident String, Some underlying) => Sequence (
            first: parse_quote { $visibility type $variant = $underlying },
            rest: typegroup_items visibility rest,
        ),
    },
}

def typegroup_generic_items:
    Syntax ->
    Syntax ->
    Sequence (Ident String, Optional Type) ->
    Syntax =
visibility => parameters => entries => match entries {
    Sequence () => quote {},
    Sequence (
        first: (Ident String, Optional Type),
        rest: Sequence (Ident String, Optional Type),
    ) => {
        let tail = typegroup_generic_items visibility parameters rest
        match first {
            (variant: Ident String, None) =>
                quote { $visibility type $variant $tail },
            (variant: Ident String, Some underlying) =>
                quote { $visibility type $variant $parameters = $underlying $tail },
        }
    },
}

def typegroup_sum:
    Ident String ->
    Sequence (Ident String, Optional Type) ->
    Type =
group => entries => match entries {
    Sequence (
        first: (Ident String, Optional Type),
        rest: Sequence (Ident String, Optional Type),
    ) => match first {
        (variant: Ident String, _) => {
            let head: Type = parse_quote { $group.$variant }
            match rest {
                Sequence () => head,
                _ => {
                    let tail = typegroup_sum group rest
                    parse_quote { $head | $tail } satisfies Type
                },
            }
        },
    },
}

def typegroup_parameter_syntax: Sequence Type -> Syntax = parameters => match parameters {
    Sequence () => quote {},
    Sequence (
        first: Type,
        rest: Sequence Type,
    ) => {
        let tail = typegroup_parameter_syntax rest
        quote { $first $tail }
    },
}

def typegroup_generic_sum_syntax:
    Ident String ->
    Syntax ->
    Sequence (Ident String, Optional Type) ->
    Syntax =
group => parameters => entries => match entries {
    Sequence (
        first: (Ident String, Optional Type),
        rest: Sequence (Ident String, Optional Type),
    ) => match first {
        (variant: Ident String, underlying) => {
            let head: Syntax = match underlying {
                None => quote { $group.$variant },
                Some _ => quote { $group.$variant $parameters },
            }
            match rest {
                Sequence () => head,
                _ => {
                    let tail = typegroup_generic_sum_syntax group parameters rest
                    quote { $head | $tail }
                },
            }
        },
    },
}

pub macro typegroup =
metadata: MacroCallMetadata =>
group: Ident String =>
parameters: Sequence Type =>
body: Braced (Separated (Ident String, Optional Type) Comma) => {
    let visibility = metadata.visibility
    match body {
    Braced (Separated (
        separator,
        elements,
        trailing,
    )) => {
        let item_visibility = typegroup_variant_visibility visibility
        let public_visibility = typegroup_public_visibility visibility
        match parameters {
            Sequence () => {
                let items = typegroup_items item_visibility elements
                let sum: Type = typegroup_sum group elements
                parse_quote {
                    companion $group {
                        $items...
                    }
                    $public_visibility type alias $group = $sum
                }
            },
            _ => {
                let parameter_syntax = typegroup_parameter_syntax parameters
                let generic_item_visibility = typegroup_visibility_syntax item_visibility
                let generic_public_visibility = typegroup_visibility_syntax public_visibility
                let items = typegroup_generic_items generic_item_visibility parameter_syntax elements
                let sum = typegroup_generic_sum_syntax group parameter_syntax elements
                parse_quote {
                    companion $group {
                        $items
                    }
                    $generic_public_visibility type alias $group $parameter_syntax = $sum
                }
            },
        }
    },
    }
}
