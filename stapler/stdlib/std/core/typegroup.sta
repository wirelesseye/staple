use std.syntax *

def typegroup_public_visibility: Visibility -> Visibility = visibility => match visibility {
    Private => Private,
    Public => Public,
    PublicRepr => Public,
}

def typegroup_variant_visibility: Visibility -> Visibility = visibility => match visibility {
    Private => PublicRepr,
    Public => Public,
    PublicRepr => PublicRepr,
}

def typegroup_items:
    Visibility ->
    Sequence (Ident String, Optional Type) ->
    Sequence Item =
visibility => entries => match entries {
    Sequence () => Sequence (),
    Sequence (
        first: (Ident String, Optional Type),
        rest: Sequence (Ident String, Optional Type),
    ) => match first {
        (variant: Ident String, None) => Sequence (
            first: quote { $visibility type $variant },
            rest: typegroup_items visibility rest,
        ),
        (variant: Ident String, Some underlying) => Sequence (
            first: quote { $visibility type $variant = $underlying },
            rest: typegroup_items visibility rest,
        ),
    },
}

def typegroup_generic_items:
    Visibility ->
    Sequence (Ident String) ->
    Sequence (Ident String, Optional Type) ->
    Sequence Item =
visibility => parameters => entries => match entries {
    Sequence () => Sequence (),
    Sequence (
        first: (Ident String, Optional Type),
        rest: Sequence (Ident String, Optional Type),
    ) => match first {
        (variant: Ident String, None) => Sequence (
            first: quote { $visibility type $variant },
            rest: typegroup_generic_items visibility parameters rest,
        ),
        (variant: Ident String, Some underlying) => Sequence (
            first: quote { $visibility type $variant = $parameters... => $underlying },
            rest: typegroup_generic_items visibility parameters rest,
        ),
    },
}

def typegroup_sum:
    Ident String ->
    Sequence (Ident String, Optional Type) ->
    Type =
group => entries => match entries {
    Sequence (
        first: (Ident String, Optional Type),
        rest: Sequence (Ident String, Optional Type),
    ) => match first {
        (variant: Ident String, _) => {
            let head: Type = quote { $group.$variant }
            match rest {
                Sequence () => head,
                _ => {
                    let tail = typegroup_sum group rest
                    quote { $head | $tail } satisfies Type
                },
            }
        },
    },
}

def typegroup_apply_parameters:
    Type ->
    Sequence (Ident String) ->
    Type =
callee => parameters => match parameters {
    Sequence (
        first: Ident String,
        rest: Sequence Ident String,
    ) => match rest {
        Sequence () => {
            let argument: Type = quote { $first }
            quote { $callee $argument } satisfies Type
        },
        _ => {
            let arguments = Parenthesized parameters
            quote { $callee $arguments } satisfies Type
        },
    }
}

def typegroup_generic_sum:
    Ident String ->
    Sequence (Ident String) ->
    Sequence (Ident String, Optional Type) ->
    Type =
group => parameters => entries => match entries {
    Sequence (
        first: (Ident String, Optional Type),
        rest: Sequence (Ident String, Optional Type),
    ) => match first {
        (variant: Ident String, underlying) => {
            let constructor: Type = quote { $group.$variant }
            let head: Type = match underlying {
                None => constructor,
                Some _ => typegroup_apply_parameters constructor parameters,
            }
            match rest {
                Sequence () => head,
                _ => {
                    let tail = typegroup_generic_sum group parameters rest
                    quote { $head | $tail } satisfies Type
                },
            }
        },
    },
}

pub macro typegroup =
visibility: MacroCallVisibility =>
group: Ident String =>
equals: Equals =>
body: Braced (Separated (Ident String, Optional Type) Comma) => match body {
    Braced (Separated (
        separator,
        elements,
        trailing,
    )) => {
        let item_visibility = typegroup_variant_visibility visibility
        let public_visibility = typegroup_public_visibility visibility
        let items = typegroup_items item_visibility elements
        let sum: Type = typegroup_sum group elements
        quote {
            $public_visibility mod $group {
                $items...
            }
            $public_visibility type alias $group = $sum
        }
    },
}

pub macro typegroup =
visibility: MacroCallVisibility =>
group: Ident String =>
equals: Equals =>
parameter: Ident String =>
arrow: FatArrow =>
body: Braced (Separated (Ident String, Optional Type) Comma) => match (
    body,
) {
    (
        Braced (Separated (
            separator,
            elements,
            trailing,
        )),
    ) => {
        let parameters = Sequence (parameter)
        let item_visibility = typegroup_variant_visibility visibility
        let public_visibility = typegroup_public_visibility visibility
        let items = typegroup_generic_items item_visibility parameters elements
        let sum: Type = typegroup_generic_sum group parameters elements
        quote {
            $public_visibility mod $group {
                $items...
            }
            $public_visibility type alias $group = $parameters... => $sum
        }
    },
}

pub macro typegroup =
visibility: MacroCallVisibility =>
group: Ident String =>
equals: Equals =>
parameter_group: Parenthesized (Separated (Ident String) Comma) =>
arrow: FatArrow =>
body: Braced (Separated (Ident String, Optional Type) Comma) => match (
    parameter_group,
    body,
) {
    (
        Parenthesized (Separated (
            parameter_separator,
            parameters,
            parameter_trailing,
        )),
        Braced (Separated (
            separator,
            elements,
            trailing,
        )),
    ) => {
        let item_visibility = typegroup_variant_visibility visibility
        let public_visibility = typegroup_public_visibility visibility
        let items = typegroup_generic_items item_visibility parameters elements
        let sum: Type = typegroup_generic_sum group parameters elements
        quote {
            $public_visibility mod $group {
                $items...
            }
            $public_visibility type alias $group = $parameters... => $sum
        }
    },
}
