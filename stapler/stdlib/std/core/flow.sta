use std.core.boolean.(True, False)
use std.core.iterator.(IntoIterator, Iterator)
use std.core.iterator.IterStep.(Done, Yield)
use std.syntax.*

def if_clauses:
    Sequence (Expr, FatArrow, Expr) ->
    Expr =
clauses => match clauses {
    Sequence () => parse_quote { () },
    Sequence (
        first: (Expr, FatArrow, Expr),
        rest: Sequence (Expr, FatArrow, Expr),
    ) => match first {
        (condition: Ident "else", _, fallback) => match rest {
            Sequence () => fallback,
        },
        (condition, _, branch) => {
            let otherwise = if_clauses rest
            parse_quote {
                match $condition satisfies Bool {
                    True() => $branch,
                    False() => $otherwise,
                }
            }
        },
    },
}

pub macro if =
    body: Braced (Separated (Expr, FatArrow, Expr) Comma) => match body {
        Braced (Separated (_, clauses, _)) => if_clauses clauses,
    }

pub macro while =
    condition: Expr =>
    body: Expr =>
    parse_quote {
        loop {
            match $condition satisfies Bool {
                True() => $body,
                False() => { break },
            }
        }
    }

pub macro for =
    pattern: Pattern =>
    _: Ident "in" =>
    source: Expr =>
    body: Expr =>
    parse_quote {
        {
            var iterator = IntoIterator.into_iterator $source
            loop {
                match Iterator.next iterator {
                    Done _ => { break },
                    Yield (item, next_iterator) => {
                        iterator = next_iterator
                        let $pattern = item
                        $body
                    },
                }
            }
        }
    }
