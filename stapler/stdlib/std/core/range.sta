use std.core.iterator.(IntoIterator, Iterator)
use std.core.iterator.IterStep.(Done, Yield)

pub(repr) type Range T = (
    current: T,
    end: T,
)

pub(repr) type RangeInclusive T = (
    current: T,
    end: T,
    finished: Bool,
)

pub def range : <T where Copy T> T -> T -> Range T = start => end => Range (
    current: start,
    end: end,
)

pub def range_inclusive : <T where Copy T> T -> T -> RangeInclusive T = start => end => RangeInclusive (
    current: start,
    end: end,
    finished: False satisfies Bool,
)

impl Iterator (Range I8) I8 {
    def next = Range (current, end) => match current < end {
        True() => Yield (
            current,
            Range (
                current: current + 1,
                end: end,
            ),
        ),
        False() => Done (Range (
            current: current,
            end: end,
        )),
    }
}

impl IntoIterator (Range I8) (Range I8) {
    def into_iterator = iterator => iterator
}

impl Iterator (RangeInclusive I8) I8 {
    def next = RangeInclusive (current, end, finished) => match finished {
        True() => Done (RangeInclusive (
            current: current,
            end: end,
            finished: True satisfies Bool,
        )),
        False() => match current < end {
            True() => Yield (
                current,
                RangeInclusive (
                    current: current + 1,
                    end: end,
                    finished: False satisfies Bool,
                ),
            ),
            False() => match current == end {
                True() => Yield (
                    current,
                    RangeInclusive (
                        current: current,
                        end: end,
                        finished: True satisfies Bool,
                    ),
                ),
                False() => Done (RangeInclusive (
                    current: current,
                    end: end,
                    finished: True satisfies Bool,
                )),
            },
        },
    }
}

impl IntoIterator (RangeInclusive I8) (RangeInclusive I8) {
    def into_iterator = iterator => iterator
}

