// Compiler-owned, compile-time-only syntax values. Identifiers and calls expose
// their data in the first structured-syntax slice; the remaining expression
// forms round-trip through UnstructuredExpr without exposing their fields yet.
pub(repr) type Ident = Spelling => StringType Spelling => Spelling
pub(repr) type CallExpr = (
    callee: Expr,
    argument: Expr,
)
pub type UnstructuredExpr = opaque
pub type alias Expr = Ident String | CallExpr | UnstructuredExpr

pub type Type = opaque
pub type Pattern = opaque
pub type Item = opaque

// A sealed compiler-defined marker: String and every string literal type
// satisfy it. It has no runtime methods or user implementations.
pub trait StringType = T => {}

pub type alias Syntax = Expr | Type | Pattern | Item
