pub typegroup Bool = {
    True,
    False,
}
pub use Bool *

impl Eq Bool {
    def equal = left => right => match (left, right) {
        (True(), True()) => True,
        (False(), False()) => True,
        _ => False,
    }
    def not_equal = left => right => match (left, right) {
        (True(), False()) => True,
        (False(), True()) => True,
        _ => False,
    }
}
