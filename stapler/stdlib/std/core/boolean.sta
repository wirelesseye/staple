pub typegroup Bool {
    True,
    False,
}
pub use Bool.*

impl ToString Bool {
    def to_string = value => match value {
        True() => "True",
        False() => "False",
    }
}

impl Eq Bool {
    def equal = left => right => match (left, right) {
        (True(), True()) => True,
        (False(), False()) => True,
        _ => False,
    }
    def not_equal = left => right => match (left, right) {
        (True(), False()) => True,
        (False(), True()) => True,
        _ => False,
    }
}
