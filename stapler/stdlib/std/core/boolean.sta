pub typegroup Bool {
    True,
    False,
}
pub use Bool.*

impl Display Bool {
    def fmt = (value, mut formatter) => Formatter.write (formatter, match value {
        True() => "True",
        False() => "False",
    })
}

impl Debug Bool {
    def fmt = (value, mut formatter) => Display.fmt (value, formatter)
}

impl Eq Bool {
    def equal = left => right => match (left, right) {
        (True(), True()) => True,
        (False(), False()) => True,
        _ => False,
    }
    def not_equal = left => right => match (left, right) {
        (True(), False()) => True,
        (False(), True()) => True,
        _ => False,
    }
}
