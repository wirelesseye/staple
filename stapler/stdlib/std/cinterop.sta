use std.syntax.(Expr)

/// A C-compatible character.
pub type CChar = opaque
/// An opaque pointer to a C value of type `Pointee`.
pub type CPointer Pointee = opaque
/// A null-terminated C string.
pub type CString = opaque

pub macro c_string: Expr -> Expr

extern "staple-intrinsic" {
    let __string_from_c_string: CString -> String
    let __string_to_c_string: String -> CString
}

companion CString {
    /// Converts a C string to a Staple string.
    pub def to_string: CString -> String = value => __string_from_c_string value
    /// Converts a Staple string to a C string.
    pub def from_string: String -> CString = value => __string_to_c_string value
}
