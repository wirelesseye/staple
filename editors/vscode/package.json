{
  "name": "staple-language-support",
  "displayName": "Staple Language Support",
  "description": "Syntax highlighting for the Staple programming language.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "staple",
        "aliases": [
          "Staple",
          "staple"
        ],
        "extensions": [
          ".sta"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "staple",
        "scopeName": "source.staple",
        "path": "./syntaxes/staple.tmLanguage.json"
      }
    ]
  }
}
