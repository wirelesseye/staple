{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Staple",
  "scopeName": "source.staple",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#quotation" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.staple",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.staple",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.staple",
              "match": "\\\\[nrt0\\\\\"]"
            },
            {
              "name": "invalid.illegal.escape.staple",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.definition.staple",
          "match": "\\b(def)\\s+((?:_|\\p{Alphabetic})(?:_|\\p{Alphabetic}|\\p{Number})*)",
          "captures": {
            "1": { "name": "storage.type.function.staple" },
            "2": { "name": "variable.other.readwrite.staple" }
          }
        },
        {
          "name": "meta.macro.definition.staple",
          "match": "\\b(macro)\\s+((?:_|\\p{Alphabetic})(?:_|\\p{Alphabetic}|\\p{Number})*)",
          "captures": {
            "1": { "name": "storage.type.macro.staple" },
            "2": { "name": "entity.name.macro.staple" }
          }
        },
        {
          "name": "meta.type.definition.staple",
          "match": "\\b(type)\\s+(?:(alias)\\s+)?((?:_|\\p{Alphabetic})(?:_|\\p{Alphabetic}|\\p{Number})*)",
          "captures": {
            "1": { "name": "storage.type.staple" },
            "2": { "name": "storage.modifier.alias.staple" },
            "3": { "name": "entity.name.type.staple" }
          }
        },
        {
          "name": "meta.trait.definition.staple",
          "match": "\\b(trait)\\s+((?:_|\\p{Alphabetic})(?:_|\\p{Alphabetic}|\\p{Number})*)",
          "captures": {
            "1": { "name": "storage.type.trait.staple" },
            "2": { "name": "entity.name.type.interface.staple" }
          }
        },
        {
          "name": "meta.implementation.staple",
          "match": "\\b(impl)\\s+((?:_|\\p{Alphabetic})(?:_|\\p{Alphabetic}|\\p{Number})*)",
          "captures": {
            "1": { "name": "storage.type.impl.staple" },
            "2": { "name": "entity.name.type.interface.staple" }
          }
        },
        {
          "name": "meta.binding.staple",
          "match": "\\b(let|var)\\s+(mut\\s+)?((?:_|\\p{Alphabetic})(?:_|\\p{Alphabetic}|\\p{Number})*)",
          "captures": {
            "1": { "name": "storage.type.binding.staple" },
            "2": { "name": "storage.modifier.mutable.staple" },
            "3": { "name": "variable.other.readwrite.staple" }
          }
        }
      ]
    },
    "quotation": {
      "patterns": [
        {
          "name": "keyword.other.quote.staple",
          "match": "\\bquote(?=\\s*\\{)"
        },
        {
          "name": "meta.macro.splice.staple",
          "match": "(\\$)((?:_|\\p{Alphabetic})(?:_|\\p{Alphabetic}|\\p{Number})*)(\\.\\.\\.)?",
          "captures": {
            "1": { "name": "punctuation.definition.variable.staple" },
            "2": { "name": "variable.other.readwrite.staple" },
            "3": { "name": "keyword.operator.spread.staple" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.staple",
          "match": "\\b(?:break|continue|loop|match|return|with)\\b"
        },
        {
          "name": "keyword.control.import.staple",
          "match": "\\b(?:use|as)\\b"
        },
        {
          "name": "keyword.declaration.staple",
          "match": "\\b(?:def|extern|impl|let|macro|mod|trait|type|var)\\b"
        },
        {
          "name": "storage.modifier.staple",
          "match": "\\b(?:alias|mut|opaque|pub)\\b"
        },
        {
          "name": "keyword.operator.expression.staple",
          "match": "\\b(?:resource|satisfies)\\b"
        },
        {
          "name": "variable.language.wildcard.staple",
          "match": "(?<![_\\p{Alphabetic}\\p{Number}])_(?![_\\p{Alphabetic}\\p{Number}])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.staple",
          "match": "(?<![_\\p{Alphabetic}\\p{Number}])(?:[0-9]+\\.(?:[0-9]+(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+|(?![_\\p{Alphabetic}]))|\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+)(?![_\\p{Alphabetic}\\p{Number}])"
        },
        {
          "name": "constant.numeric.integer.staple",
          "match": "(?<![_\\p{Alphabetic}\\p{Number}])[0-9]+(?![_\\p{Alphabetic}\\p{Number}])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.staple",
          "match": "(?<![_\\p{Alphabetic}\\p{Number}])\\p{Uppercase}(?:_|\\p{Alphabetic}|\\p{Number})*(?![_\\p{Alphabetic}\\p{Number}])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.staple",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.spread.staple",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.symbolic.staple",
          "match": "[!#$%&*+/<=>?@\\\\^|~:-]+|\\.{2,}"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.group.staple",
          "match": "[(){}\\[\\]]"
        },
        {
          "name": "punctuation.separator.staple",
          "match": "[,;.]"
        }
      ]
    }
  }
}
